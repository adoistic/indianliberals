    ],
    "toc_indexes": [
      2
    ],
    "note_verbatim": "Leon Emery is a writer and musicologist and former professor at the University of Lyon. He has lost his eyesight but is still publishing a magazine called Caheiers Libres. He has written a number of essays and books on Balzac, Victor Hugo, Beethoven, Goethe, the French revolution, etc.",
    "note_printed_page": 103,
    "nationality_evidence": null,
