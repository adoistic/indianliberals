---
// Primary-works index - chronological list with faceted client-side filters.
//
// Filters (Type / Decade / Theme) are pure client-side JS toggling `<li>`
// visibility via data-* attributes. No server, no API; works on the static
// build. Reset button clears all selections.

import BaseLayout from "~/layouts/BaseLayout.astro";
import { collectionPageNode, breadcrumbNode } from "~/lib/schema";
import { ogSection } from "~/lib/og";
import { getCollection } from "astro:content";
import { LANG_NAMES, pathForEntry, type LangCode } from "~/lib/i18n";
import { getPeriodicalSeries } from "~/lib/periodicals";
import { getSeries, countAll } from "~/lib/series";

// Two kinds live in this collection for schema reasons but don't belong in
// this list of individual documents (Adnan, 2026-07):
//   • interviews (work_type "interview") — recorded voices, home at /interviews/.
//   • lectures (work_type "lecture") — recorded addresses, home at /lectures/.
//   • periodical issues (work_type "periodical_issue") — hundreds of individual
//     issues that swamp the page; they belong to their runs at /periodicals/.
// All are excluded here; their detail pages still build and stay reachable.
// Periodicals are re-surfaced below as a compact band of *runs* instead.
const allWorks = await getCollection(
  "primary-works",
  (w) =>
    !w.data.draft &&
    w.data.work_type !== "interview" &&
    w.data.work_type !== "lecture" &&
    w.data.work_type !== "periodical_issue",
);

// The band above the grid shows every named RUN in the archive, both kinds:
// the periodical runs (dated magazine issues, which are excluded from the grid
// above) and the non-periodical runs (the Forum booklets, the annual budget
// analyses, the memorial lectures — whose items DO appear in the grid). They
// used to be two separate destinations; both now open into the single
// "Series & Periodicals" index at /periodicals/.
const periodicalSeries = (await getPeriodicalSeries()).filter((g) => g.id !== "other");
const periodicalIssueCount = periodicalSeries.reduce((n, g) => n + g.items.length, 0);
const nonPeriodicalRuns = await getSeries();
const seriesWorkCount = nonPeriodicalRuns.reduce((n, g) => n + countAll(g), 0);

type RunCard = { href: string; name: string; native?: string; cover: string | null; count: number; unit: string };
const runCards: RunCard[] = [
  ...nonPeriodicalRuns.map((g) => ({
    href: `/series/${g.entry.id}/`,
    name: g.entry.data.name,
    cover: g.cover,
    count: countAll(g),
    unit: "works",
  })),
  ...periodicalSeries.map((g) => ({
    href: `/periodicals/${g.id}/`,
    name: g.meta.name,
    native: g.meta.native,
    cover: g.cover,
    count: g.items.length,
    unit: "issues",
  })),
].sort((a, b) => b.count - a.count);
const runWorkTotal = periodicalIssueCount + seriesWorkCount;

// Sort by publication year desc, then title for stable ordering within a year.
const works = allWorks.slice().sort((a, b) => {
  const ya = a.data.publication?.year ?? -Infinity;
  const yb = b.data.publication?.year ?? -Infinity;
  if (ya !== yb) return yb - ya;
  return a.data.title.main.localeCompare(b.data.title.main);
});

// Group by decade for visual scanning.
type Decade = { label: string; start: number; works: typeof works };
const decades: Decade[] = [];
let current: Decade | null = null;
for (const w of works) {
  const y = w.data.publication?.year;
  const decadeStart = y != null ? Math.floor(y / 10) * 10 : null;
  const label = decadeStart == null ? "Undated" : `${decadeStart}s`;
  if (!current || current.label !== label) {
    current = { label, start: decadeStart ?? -Infinity, works: [] };
    decades.push(current);
  }
  current.works.push(w);
}

const totalCount = works.length;

// The language a reader is filtering for is the language of the DOCUMENT, which
// is `publication.language`. The top-level `language` is a different thing — it
// is the locale the entry's page is routed under, and for a stretch of the
// archive the two disagree: 65 works (the whole Shetkari Sanghatak run, both
// Bengali tracts, four Hindi works) carry publication.language mr/bn/hi while
// their top-level language was never set, so they defaulted to English. Faceting
// on the routing field made those documents unfindable by their own language,
// and made Bengali vanish from the filter entirely.
//
// So: facet on the document's language, but keep routing on the entry's locale
// (see pathForEntry below) — the page genuinely lives where it lives.
const textLanguage = (w: (typeof works)[number]) =>
  w.data.publication?.language ?? w.data.language ?? "en";

// Build facet vocabularies for the filter UI.
const typeCounts = new Map<string, number>();
const themeCounts = new Map<string, number>();
const languageCounts = new Map<string, number>();
for (const w of works) {
  const t = w.data.work_type;
  typeCounts.set(t, (typeCounts.get(t) ?? 0) + 1);
  const lang = textLanguage(w);
  languageCounts.set(lang, (languageCounts.get(lang) ?? 0) + 1);
  for (const th of w.data.themes ?? []) {
    themeCounts.set(th, (themeCounts.get(th) ?? 0) + 1);
  }
}

// Order: type alphabetical; themes by count desc (most-used first)
const typeOptions = [...typeCounts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
const themeOptions = [...themeCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 30); // top 30 themes
const decadeOptions = decades.map((d) => ({ label: d.label, start: d.start, count: d.works.length }));
// Language: English first (most common), then by count desc.
const languageOptions = [...languageCounts.entries()].sort((a, b) => {
  if (a[0] === "en") return -1;
  if (b[0] === "en") return 1;
  return b[1] - a[1];
});

// Helper for the data attribute that holds space-joined themes.
function themesAttr(w: (typeof works)[number]): string {
  return (w.data.themes ?? []).join(" ");
}
---

<BaseLayout
  schema={[
    collectionPageNode({ pagePath: "/primary-works/", name: "Primary works" }),
    breadcrumbNode([
      ["Home", "/"],
      ["Primary works", "/primary-works/"],
    ]),
  ]}
  ogImage={ogSection("primary-works")}
  title="Primary works · Indian Liberals"
  description={`${totalCount} primary works by Indian liberal thinkers, from speeches and pamphlets to books and essays. Metadata + AI summary + PDF.`}
>
  <section class="border-b border-(--color-border)">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-xs uppercase tracking-widest text-(--color-saffron-700) font-(family-name:--font-ui) font-semibold mb-3">
        The archive
      </p>
      <h1 class="text-(--color-fg) leading-tight">Primary works</h1>
      <p class="mt-4 text-(--color-fg-muted) max-w-prose leading-relaxed">
        {totalCount.toLocaleString("en-IN")} books, pamphlets, essays, and
        speeches by historically significant Indian liberal thinkers, indexed
        one document at a time. Each carries AI-extracted metadata, a prose
        summary, key points and the source PDF. Most of them also belong
        to a run, whether a booklet series, a magazine or an annual budget analysis, and
        those are collected under
        <a href="/periodicals/" class="text-(--color-forest-700)">Series &amp; Periodicals</a>.
      </p>
    </div>
  </section>

  {/* Every named run, both kinds, on one shelf. Most of this archive was
      published in runs rather than as one-off books, so this belongs above the
      grid, not tucked below it. */}
  {runCards.length > 0 && (
    <section class="border-b border-(--color-border) bg-(--color-bg-muted)">
      <div class="mx-auto max-w-6xl px-6 py-10">
        <div class="flex items-baseline justify-between gap-4 flex-wrap mb-6">
          <div>
            <h2 class="text-(--color-fg) font-(family-name:--font-display) text-2xl">Series &amp; periodicals</h2>
            <p class="text-(--color-fg-muted) text-sm mt-1 font-(family-name:--font-ui)">
              {runWorkTotal.toLocaleString("en-IN")} works across {runCards.length} runs: the Forum
              of Free Enterprise booklets, the magazines, the annual budgets and the memorial lectures.
            </p>
          </div>
          <a href="/periodicals/" class="text-sm font-(family-name:--font-ui) font-semibold no-underline text-(--color-forest-700) hover:text-(--color-fg)">
            All runs →
          </a>
        </div>
        <ul class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-4 font-(family-name:--font-ui)">
          {runCards.map((c) => (
            <li>
              <a href={c.href} class="group block no-underline">
                <div class="aspect-[3/4] rounded-sm overflow-hidden border border-(--color-border) bg-(--color-bg) flex items-center justify-center transition-shadow group-hover:shadow-md">
                  {c.cover ? (
                    <img
                      src={c.cover}
                      alt=""
                      width="160"
                      height="213"
                      loading="lazy"
                      class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-300"
                    />
                  ) : (
                    <span class="font-(family-name:--font-display) text-xl text-(--color-fg-muted) px-2 text-center leading-tight">
                      {c.name.split(" ").slice(0, 2).map((s) => s[0]).join("")}
                    </span>
                  )}
                </div>
                <h3 class="mt-2 text-xs font-semibold text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors leading-tight line-clamp-2">
                  {c.name}
                </h3>
                <p class="text-[11px] text-(--color-fg-muted) mt-0.5">
                  {c.count} {c.count === 1 ? c.unit.replace(/s$/, "") : c.unit}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <div class="mx-auto max-w-6xl px-6 py-12 md:grid md:grid-cols-[220px_1fr] md:gap-10" data-pagefind-ignore>
    {/* Filter sidebar - sticky left rail on md+, stacks on top on mobile */}
    <aside
      class="
        font-(family-name:--font-ui) text-sm mb-8 md:mb-0
        md:sticky md:top-[5.5rem] md:self-start
        md:max-h-[calc(100vh-6rem)] md:overflow-y-auto md:pr-2
      "
      aria-label="Filter primary works"
    >
      <div class="flex items-baseline justify-between gap-3 mb-3 pb-3 border-b border-(--color-border)">
        <h2 class="text-xs uppercase tracking-widest text-(--color-fg-muted)">Filter</h2>
        <button id="pw-reset" type="button" class="text-[10px] uppercase tracking-wider text-(--color-saffron-700) font-semibold hover:text-(--color-fg) hidden">
          Reset
        </button>
      </div>
      <p class="text-xs text-(--color-fg-muted) mb-5">
        Showing <strong id="pw-counter-visible" class="text-(--color-fg)">{totalCount}</strong> of <strong>{totalCount}</strong>
      </p>

      <div class="mb-5">
        <h3 class="text-[10px] uppercase tracking-wider text-(--color-fg-muted) mb-2">Type</h3>
        <ul class="flex flex-wrap gap-1.5">
          {typeOptions.map(([t, n]) => (
            <li>
              <button
                type="button"
                data-filter-type={t}
                class="pw-chip px-2 py-1 bg-(--color-bg-muted) border border-(--color-border) rounded text-xs text-(--color-fg) hover:border-(--color-fg) transition-colors"
              >
                {t.replace(/_/g, " ")} <span class="opacity-70">({n})</span>
              </button>
            </li>
          ))}
        </ul>
      </div>

      {languageOptions.length > 1 && (
        <div class="mb-5">
          <h3 class="text-[10px] uppercase tracking-wider text-(--color-fg-muted) mb-2">Language</h3>
          <ul class="flex flex-wrap gap-1.5">
            {languageOptions.map(([lang, n]) => {
              const names = LANG_NAMES[lang as LangCode];
              const label = names ? names.english : lang;
              return (
                <li>
                  <button
                    type="button"
                    data-filter-language={lang}
                    class="pw-chip px-2 py-1 bg-(--color-bg-muted) border border-(--color-border) rounded text-xs text-(--color-fg) hover:border-(--color-fg) transition-colors"
                  >
                    {label} <span class="opacity-70">({n})</span>
                  </button>
                </li>
              );
            })}
          </ul>
        </div>
      )}

      <div class="mb-5">
        <h3 class="text-[10px] uppercase tracking-wider text-(--color-fg-muted) mb-2">Decade</h3>
        <ul class="flex flex-wrap gap-1.5">
          {decadeOptions.map((d) => (
            <li>
              <button
                type="button"
                data-filter-decade={String(d.start)}
                class="pw-chip px-2 py-1 bg-(--color-bg-muted) border border-(--color-border) rounded text-xs text-(--color-fg) hover:border-(--color-fg) transition-colors"
              >
                {d.label} <span class="opacity-70">({d.count})</span>
              </button>
            </li>
          ))}
        </ul>
      </div>

      <details class="mb-5" open>
        <summary class="text-[10px] uppercase tracking-wider text-(--color-fg-muted) cursor-pointer select-none hover:text-(--color-fg) mb-2">Themes ▾</summary>
        <ul class="flex flex-wrap gap-1.5">
          {themeOptions.map(([th, n]) => (
            <li>
              <button
                type="button"
                data-filter-theme={th}
                class="pw-chip px-2 py-1 bg-(--color-bg-muted) border border-(--color-border) rounded text-xs text-(--color-fg) hover:border-(--color-fg) transition-colors"
              >
                {th.replace(/_/g, " ").replace(/-/g, " ")} <span class="opacity-70">({n})</span>
              </button>
            </li>
          ))}
        </ul>
      </details>
    </aside>

    {/* Listing column */}
    <div id="pw-list" class="min-w-0">
    {decades.map((d) => (
      <section class="mb-14 pw-section" data-decade={String(d.start)}>
        <h2 class="text-(--color-fg) font-(family-name:--font-display) mb-6 sticky top-[4.75rem] bg-(--color-bg) py-2 z-10 border-b border-(--color-border)">
          {d.label}
        </h2>
        {/* Cover-led grid. Each work leads with the first page of its PDF
            (portrait 3:4, not the landscape card used for opinions); works
            without a rendered cover fall back to a titled spine tile so the
            grid stays even. Filter JS toggles these .pw-item cells. */}
        <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-5 gap-y-8 font-(family-name:--font-ui)">
          {d.works.map((w) => {
            const y = w.data.publication?.year;
            const byline = (w.data.contributors ?? [])
              .filter((c) => c.role === "author")
              .map((c) => c.thinker_unresolved || (c.thinker as { id?: string } | undefined)?.id || "")
              .filter(Boolean)
              .map((s) => s.replace(/-/g, " "))
              .join(", ");
            const cover = w.data.cover_image;
            return (
              <li
                class="pw-item"
                data-type={w.data.work_type}
                data-decade={String(d.start)}
                data-themes={themesAttr(w)}
                data-language={textLanguage(w)}
              >
                <a href={pathForEntry("primary-works", w.id, (w.data.language ?? "en") as LangCode)} class="group block no-underline h-full">
                  <div class="aspect-[3/4] rounded-sm overflow-hidden border border-(--color-border) bg-(--color-bg-muted) transition-shadow group-hover:shadow-md relative">
                    {cover ? (
                      <img
                        src={cover}
                        alt=""
                        width="240"
                        height="320"
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover object-top group-hover:scale-[1.02] transition-transform duration-300"
                      />
                    ) : (
                      <div class="w-full h-full flex flex-col items-center justify-center gap-2 px-3 text-center">
                        <span aria-hidden="true" class="font-(family-name:--font-display) text-3xl text-(--color-saffron-700)/60 leading-none">
                          {w.data.title.main.replace(/^(the|a|an) /i, "").charAt(0)}
                        </span>
                        <span class="text-[10px] uppercase tracking-wider text-(--color-fg-muted)">
                          {w.data.work_type.replace(/_/g, " ")}
                        </span>
                      </div>
                    )}
                    {w.data.language && w.data.language !== "en" && (
                      <span class="absolute top-1.5 right-1.5 px-1.5 py-0.5 text-[10px] uppercase tracking-wider bg-(--color-bg)/85 border border-(--color-border) rounded">
                        {w.data.language}
                      </span>
                    )}
                  </div>
                  <h3 class="mt-2.5 text-sm font-semibold text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors leading-snug line-clamp-2">
                    {w.data.title.main}
                  </h3>
                  <p class="mt-1 text-xs text-(--color-fg-muted) leading-snug">
                    {byline && <span class="line-clamp-1">{byline}</span>}
                    <span>
                      {y && <>{y}</>}
                      {y && <> · </>}
                      <span class="uppercase tracking-wider">{w.data.work_type.replace(/_/g, " ")}</span>
                    </span>
                  </p>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
    <p id="pw-empty" class="hidden text-center py-12 text-(--color-fg-muted) font-(family-name:--font-ui)">
      No works match the current filter. Try removing some criteria.
    </p>
    </div>
  </div>

  <script is:inline>
    // Client-side faceted filtering for /primary-works/.
    // State lives in Sets; toggling a chip flips active class + filters items.
    (function () {
      const state = { type: new Set(), decade: new Set(), theme: new Set(), language: new Set() };
      const items = Array.from(document.querySelectorAll('.pw-item'));
      const sections = Array.from(document.querySelectorAll('.pw-section'));
      const totalEl = document.getElementById('pw-counter-visible');
      const resetBtn = document.getElementById('pw-reset');
      const emptyEl = document.getElementById('pw-empty');
      const ACTIVE = ['bg-(--color-saffron-500)', 'text-white', 'border-(--color-saffron-500)'];
      const IDLE = ['bg-(--color-bg)', 'text-(--color-fg)', 'border-(--color-border)'];

      function applyFilters() {
        let visible = 0;
        for (const li of items) {
          const t = li.dataset.type;
          const d = li.dataset.decade;
          const lang = li.dataset.language;
          const themes = (li.dataset.themes || '').split(/\s+/).filter(Boolean);
          const matchType     = state.type.size === 0 || state.type.has(t);
          const matchDecade   = state.decade.size === 0 || state.decade.has(d);
          const matchTheme    = state.theme.size === 0 || themes.some((x) => state.theme.has(x));
          const matchLanguage = state.language.size === 0 || state.language.has(lang);
          const show = matchType && matchDecade && matchTheme && matchLanguage;
          li.style.display = show ? '' : 'none';
          if (show) visible++;
        }
        // Hide whole section if all its <li> are hidden
        for (const sec of sections) {
          const anyVisible = Array.from(sec.querySelectorAll('.pw-item')).some(
            (li) => li.style.display !== 'none'
          );
          sec.style.display = anyVisible ? '' : 'none';
        }
        if (totalEl) totalEl.textContent = String(visible);
        if (emptyEl) emptyEl.classList.toggle('hidden', visible !== 0);
        if (resetBtn) {
          const anyActive = state.type.size + state.decade.size + state.theme.size + state.language.size > 0;
          resetBtn.classList.toggle('hidden', !anyActive);
        }
      }

      function toggleChip(btn, facet, value) {
        const set = state[facet];
        if (set.has(value)) {
          set.delete(value);
          IDLE.forEach((c) => btn.classList.add(c));
          ACTIVE.forEach((c) => btn.classList.remove(c));
        } else {
          set.add(value);
          ACTIVE.forEach((c) => btn.classList.add(c));
          IDLE.forEach((c) => btn.classList.remove(c));
        }
        applyFilters();
      }

      document.querySelectorAll('.pw-chip').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (btn.dataset.filterType) toggleChip(btn, 'type', btn.dataset.filterType);
          else if (btn.dataset.filterDecade) toggleChip(btn, 'decade', btn.dataset.filterDecade);
          else if (btn.dataset.filterTheme) toggleChip(btn, 'theme', btn.dataset.filterTheme);
          else if (btn.dataset.filterLanguage) toggleChip(btn, 'language', btn.dataset.filterLanguage);
        });
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          state.type.clear();
          state.decade.clear();
          state.theme.clear();
          state.language.clear();
          document.querySelectorAll('.pw-chip').forEach((btn) => {
            ACTIVE.forEach((c) => btn.classList.remove(c));
            IDLE.forEach((c) => btn.classList.add(c));
          });
          applyFilters();
        });
      }

      // Deep-link support: ?decade=1950 (or a comma list) pre-selects the
      // decade filter. The homepage per-decade histogram bars link here.
      (function initFromURL() {
        const usp = new URLSearchParams(window.location.search);
        const decadeParam = usp.get('decade');
        if (!decadeParam) return;
        let matched = false;
        for (const piece of decadeParam.split(',').map((s) => s.trim()).filter(Boolean)) {
          state.decade.add(piece);
        }
        document.querySelectorAll('.pw-chip').forEach((btn) => {
          if (btn.dataset.filterDecade && state.decade.has(btn.dataset.filterDecade)) {
            ACTIVE.forEach((c) => btn.classList.add(c));
            IDLE.forEach((c) => btn.classList.remove(c));
            matched = true;
          }
        });
        if (matched) applyFilters();
        else state.decade.clear(); // unknown decade: leave the full list visible
      })();
    })();
  </script>
</BaseLayout>
