---
// Full thinker directory, the comprehensive index.
//
// The /thinkers/ landing page shows only the curated canon (featured: true).
// This page is the complete catalogue: every non-draft person the corpus
// engages with, grouped by canon_status. Referenced figures from outside
// the liberal tradition (critics, opponents, contemporaries) are explicitly
// labelled as such, their presence documents how liberal writing engaged
// the world, not editorial endorsement.
//
// Layout note: with ~670 entries, portrait cards don't scale. This page
// uses a compact index-row layout (small thumb / monogram + name + dates +
// corpus stats) with a client-side name filter and a works-only toggle.

import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getThinkerStats, type ThinkerStat } from "~/lib/thinker-stats";
import { siteCopy, t, keyed } from "~/lib/site-copy";

const copy = await siteCopy("section-thinkers-directory");
const dw = (key: string) => keyed(copy, "doorways", key);
const LEDE_FALLBACK =
  'The complete index of people this archive engages with. Not everyone listed here is a liberal thinker; the corpus also references the statesmen, critics, and opponents the liberals wrote about and argued with. Each section below says which is which. For the curated canon, see the <a href="/thinkers/" class="text-(--color-forest-700)">thinkers page</a>.';

// Hide thinkers with zero inbound reference material (`draft: true` is set
// by /tmp/auto_hide_orphans.py when nothing in the corpus references the
// slug). Re-run that script after content changes to update visibility.
const allThinkers = (await getCollection("thinkers", (t) => !t.data.draft && t.data.language === "en")).sort(
  (a, b) => a.data.name.sort.localeCompare(b.data.name.sort),
);

const stats = await getThinkerStats();

const thumbFor = (t: typeof allThinkers[number]) => {
  const p = t.data.portrait;
  return p?.duotone ?? p?.caricature ?? p?.ring_portrait ?? p?.photo ?? null;
};

// Sentence-case a vocation enum value: "legal_scholar" → "Legal scholar"
const prettifyVocation = (v: string): string => {
  const spaced = v.replace(/_/g, " ");
  return spaced.charAt(0).toUpperCase() + spaced.slice(1);
};

type CanonStatus = "core" | "extended" | "referenced" | "unclassified";

const sections: { id: CanonStatus; title: string; blurb: string; isAwaiting: boolean }[] = [
  {
    id: "core",
    title: t(dw("core"), "label", "Liberal canon"),
    blurb: t(
      dw("core"),
      "blurb",
      "Central figures in the story this site tells: thinkers whose ideas, governance, scholarship, or enterprise form the foundation of the case for individual liberty, free enterprise, and constitutional governance in modern India. The most significant appear on the curated thinkers page.",
    ),
    isAwaiting: false,
  },
  {
    id: "extended",
    title: t(dw("extended"), "label", "Extended liberal tradition"),
    blurb: t(
      dw("extended"),
      "blurb",
      "The broader cast in the liberal story: thinkers, statesmen, scholars, and figures of practice whose work belongs here without being at the very centre. Includes constitutional liberals, contemporary commentators, reform-era thinkers, and practitioners whom the liberal tradition honors, scientists, jurists, industrialists whose work has shaped the Indian liberal imagination.",
    ),
    isAwaiting: false,
  },
  {
    id: "referenced",
    title: t(dw("referenced"), "label", "Referenced figures, not part of the liberal tradition"),
    blurb: t(
      dw("referenced"),
      "blurb",
      "People from outside the liberal tradition who appear in the corpus because liberal writers cited, debated, criticised, or occasionally admired them, from socialist statesmen to industrialists to ideological opponents. They are indexed here so the cross-reference graph stays honest; inclusion is documentation, not endorsement.",
    ),
    isAwaiting: false,
  },
  {
    id: "unclassified",
    title: t(dw("unclassified"), "label", "Awaiting classification"),
    blurb: t(
      dw("unclassified"),
      "blurb",
      "Classification pass in progress; these entries will move into the sections above as curator review completes.",
    ),
    isAwaiting: true,
  },
];

// Stat line (computed from all-thinkers + stats)
const totalCount = allThinkers.length;
const withWorksCount = allThinkers.filter((t) => (stats.get(t.id)?.worksAuthored ?? 0) > 0).length;
const referencedCount = allThinkers.filter((t) => (stats.get(t.id)?.referencedIn ?? 0) > 0).length;
const statLine = `${totalCount} people · ${withWorksCount} with works in the archive · ${referencedCount} referenced in other works`;

const sectionCounts = new Map<CanonStatus, number>(
  sections.map((s) => [s.id, allThinkers.filter((t) => t.data.canon_status === s.id).length]),
);
---

<BaseLayout
  title={t(copy, "title", "Full directory of people · Indian Liberals")}
  description={t(copy, "description", "The complete directory of every person the Indian Liberals archive engages with, the liberal canon, the extended tradition, and referenced figures from outside it.")}
>
  <section class="border-b border-(--color-border)">
    <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
      <p class="text-xs uppercase tracking-widest text-(--color-saffron-700) font-(family-name:--font-ui) font-semibold mb-3">
        <a href="/thinkers/" class="no-underline text-inherit hover:text-(--color-fg)">Thinkers</a>
        <span aria-hidden> / </span>Directory
      </p>
      <h1 class="text-(--color-fg) mb-4">{t(copy, "heading", "Everyone in the archive")}</h1>
      <p
        class="text-(--color-fg-muted) leading-relaxed max-w-prose"
        set:html={t(copy, "lede", LEDE_FALLBACK)}
      />
      <p class="text-(--color-fg-muted) text-sm mt-4 font-(family-name:--font-ui)">
        {statLine}
      </p>
    </div>
  </section>

  {/* Filter toolbar, sticky under the site header */}
  <div class="sticky top-[4.5rem] z-40 border-b border-(--color-border) bg-(--color-bg)/95 backdrop-blur-sm supports-[backdrop-filter]:bg-(--color-bg)/85">
    <div class="mx-auto max-w-6xl px-6 py-3 flex items-center gap-x-5 gap-y-2 flex-wrap font-(family-name:--font-ui)">
      <label class="relative grow max-w-xs">
        <span class="sr-only">Filter people by name</span>
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-(--color-fg-muted)"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>
        <input
          id="dir-filter"
          type="search"
          placeholder="Filter by name…"
          autocomplete="off"
          class="w-full pl-9 pr-3 py-1.5 text-sm bg-(--color-bg-muted) border border-(--color-border) rounded-full outline-none focus:border-(--color-saffron-500) transition-colors"
        />
      </label>
      <label class="flex items-center gap-2 text-sm text-(--color-fg-muted) cursor-pointer select-none">
        <input id="dir-works-only" type="checkbox" class="accent-(--color-saffron-500)" />
        With works only
      </label>
      <p class="text-xs text-(--color-fg-muted) ml-auto">
        Showing <strong id="dir-count" class="text-(--color-fg)">{totalCount}</strong> of {totalCount}
      </p>
      <nav aria-label="Directory sections" class="hidden lg:flex items-center gap-2 text-xs">
        {sections.map((s) => (
          <a
            href={`#${s.id}-heading`}
            class="px-2.5 py-1 bg-(--color-bg-muted) border border-(--color-border) rounded-full no-underline text-(--color-fg-muted) hover:text-(--color-fg) hover:border-(--color-fg) transition-colors"
          >
            {s.id === "core" ? "Canon" : s.id === "extended" ? "Extended" : s.id === "referenced" ? "Referenced" : "Unclassified"}
            <span class="opacity-60"> {sectionCounts.get(s.id)}</span>
          </a>
        ))}
      </nav>
    </div>
  </div>

  {sections.map((section) => {
    const sectionThinkers = allThinkers.filter((t) => t.data.canon_status === section.id);
    if (sectionThinkers.length === 0) return null;
    const headingId = `${section.id}-heading`;

    return (
      <section aria-labelledby={headingId} class="dir-section border-b border-(--color-border) last:border-b-0 scroll-mt-32" data-section={section.id}>
        <div class="mx-auto max-w-6xl px-6 py-12">
          <h2 id={headingId} class="text-(--color-fg) text-2xl md:text-3xl font-(family-name:--font-display) mb-3">
            {section.title}
            <span class="ml-2 text-base font-(family-name:--font-ui) font-normal text-(--color-fg-muted) dir-section-count" data-total={sectionThinkers.length}>
              {sectionThinkers.length}
            </span>
          </h2>
          <p class={section.isAwaiting
            ? "text-(--color-fg-muted) text-sm mb-8 font-(family-name:--font-ui) italic max-w-prose"
            : "text-(--color-fg-muted) leading-relaxed mb-8 max-w-prose"
          }>
            {section.blurb}
          </p>
          <ul class="grid md:grid-cols-2 xl:grid-cols-3 gap-x-8 gap-y-1">
            {sectionThinkers.map((t, idx) => {
              const thumb = thumbFor(t);
              const tStat: ThinkerStat = stats.get(t.id) ?? { worksAuthored: 0, referencedIn: 0 };
              const vocationCaption = (t.data.vocations ?? []).slice(0, 2).map(prettifyVocation).join(" · ");
              const dates =
                t.data.birth_year || t.data.death_year
                  ? `${t.data.birth_year ?? "?"}–${t.data.death_year ?? ""}`
                  : "";
              const searchKey = [t.data.name.canonical, ...(t.data.name.also_known_as ?? [])]
                .join(" ")
                .toLowerCase();
              const pagefindVocations = (t.data.vocations ?? []).map((v) => `vocation:${v}`).join(",");

              return (
                <li
                  class="dir-row"
                  data-name={searchKey}
                  data-works={tStat.worksAuthored}
                  data-idx={idx}
                >
                  <a
                    href={`/thinkers/${t.id}/`}
                    class="flex items-center gap-3 py-2 px-2 -mx-2 rounded no-underline group hover:bg-(--color-bg-muted) transition-colors"
                    data-pagefind-filter={`canon-status:${t.data.canon_status}${pagefindVocations ? "," + pagefindVocations : ""}`}
                  >
                    <span class="shrink-0 w-10 h-10 rounded-full overflow-hidden bg-(--color-bg-muted) border border-(--color-border) flex items-center justify-center">
                      {thumb ? (
                        <img src={thumb} alt="" width="40" height="40" loading="lazy" class="w-full h-full object-cover object-top" />
                      ) : (
                        <span class="text-(--color-fg-muted) text-sm font-(family-name:--font-display) opacity-50">
                          {t.data.name.canonical.charAt(0)}
                        </span>
                      )}
                    </span>
                    <span class="min-w-0">
                      <span class="block text-sm font-(family-name:--font-ui) font-semibold text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors leading-tight truncate">
                        {t.data.name.canonical}
                        {dates && <span class="ml-1.5 font-normal text-(--color-fg-muted) text-xs">{dates}</span>}
                      </span>
                      <span class="block text-xs text-(--color-fg-muted) font-(family-name:--font-ui) truncate mt-0.5">
                        {vocationCaption}
                        {vocationCaption && (tStat.worksAuthored > 0 || tStat.referencedIn > 0) && " · "}
                        {tStat.worksAuthored > 0 && (
                          <span class="text-(--color-forest-700) font-semibold">
                            {tStat.worksAuthored === 1 ? "1 work" : `${tStat.worksAuthored} works`}
                          </span>
                        )}
                        {tStat.worksAuthored > 0 && tStat.referencedIn > 0 && " · "}
                        {tStat.referencedIn > 0 && `cited in ${tStat.referencedIn}`}
                      </span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
          <p class="dir-section-empty hidden text-sm text-(--color-fg-muted) font-(family-name:--font-ui) italic">
            {t(copy, "empty_state", "No one in this section matches the filter.")}
          </p>
          {sectionThinkers.length > 24 && (
            <button
              type="button"
              class="dir-expand mt-6 px-4 py-2 text-sm font-(family-name:--font-ui) font-semibold bg-(--color-bg-muted) border border-(--color-border) rounded-full text-(--color-fg) hover:border-(--color-fg) transition-colors"
              aria-expanded="false"
              data-more={sectionThinkers.length - 24}
            >
              Show all {sectionThinkers.length} <span class="sr-only">people in {section.title}</span><span aria-hidden="true"> ↓</span>
            </button>
          )}
        </div>
      </section>
    );
  })}

  <script is:inline>
    (function () {
      // Sections start collapsed to the first PREVIEW rows so the page scans
      // in four screens instead of seventy; "Show all" expands a section, and
      // any active filter expands everything so search is never silently
      // truncated.
      const PREVIEW = 24;
      const input = document.getElementById("dir-filter");
      const worksOnly = document.getElementById("dir-works-only");
      const countEl = document.getElementById("dir-count");
      const rows = Array.from(document.querySelectorAll(".dir-row"));
      const sections = Array.from(document.querySelectorAll(".dir-section"));
      const expanded = new Set();

      function apply() {
        const q = (input.value || "").trim().toLowerCase();
        const onlyWorks = worksOnly.checked;
        const filtering = q.length > 0 || onlyWorks;
        let visible = 0;
        for (const section of sections) {
          const id = section.dataset.section;
          const open = filtering || expanded.has(id);
          const sectionRows = section.querySelectorAll(".dir-row");
          let sectionMatching = 0;
          for (const row of sectionRows) {
            const matches =
              (!q || row.dataset.name.includes(q)) &&
              (!onlyWorks || Number(row.dataset.works) > 0);
            if (matches) sectionMatching++;
            const show = matches && (open || Number(row.dataset.idx) < PREVIEW);
            row.style.display = show ? "" : "none";
            if (show) visible++;
          }
          const countSpan = section.querySelector(".dir-section-count");
          if (countSpan) {
            countSpan.textContent =
              sectionMatching === Number(countSpan.dataset.total)
                ? countSpan.dataset.total
                : sectionMatching + " of " + countSpan.dataset.total;
          }
          const empty = section.querySelector(".dir-section-empty");
          if (empty) empty.classList.toggle("hidden", sectionMatching !== 0);
          const btn = section.querySelector(".dir-expand");
          if (btn) {
            // Hide the expander while filtering (everything matching is shown)
            // or once the section is expanded.
            btn.style.display = filtering || expanded.has(id) ? "none" : "";
          }
        }
        countEl.textContent = String(visible);
      }

      for (const section of sections) {
        const btn = section.querySelector(".dir-expand");
        if (!btn) continue;
        btn.addEventListener("click", () => {
          expanded.add(section.dataset.section);
          btn.setAttribute("aria-expanded", "true");
          apply();
        });
      }

      input.addEventListener("input", apply);
      worksOnly.addEventListener("change", apply);
      apply();
    })();
  </script>
</BaseLayout>
