---
// Thinkers landing page, the curated canon.
//
// Per CCS editorial direction (2026-06 review round): this page features a
// small, curated list of the most significant thinkers, seeded from the
// legacy indianliberals.in "Indian Liberals" listing plus select additions
// from the canon-core classification. Membership is controlled by the
// `featured: true` frontmatter flag (Sveltia-editable, presentation-only).
//
// Everyone else in the corpus, the extended tradition, referenced figures,
// and entries awaiting classification, remains reachable through
// /thinkers/directory/. No thinker is removed from the archive by this
// page; the cross-mention graph depends on them.

import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getThinkerStats, type ThinkerStat } from "~/lib/thinker-stats";

const allThinkers = await getCollection(
  "thinkers",
  (t) => !t.data.draft && t.data.language === "en",
);
const stats = await getThinkerStats();

const featured = allThinkers.filter((t) => t.data.featured);
// Chronological, the canon reads as the story of the tradition.
const byBirth = (a: typeof featured[number], b: typeof featured[number]) =>
  (a.data.birth_year ?? 9999) - (b.data.birth_year ?? 9999) ||
  a.data.name.sort.localeCompare(b.data.name.sort);
const canon = featured.filter((t) => t.data.nationality === "india").sort(byBirth);
// International influences (Mill, Hayek, Mises, Friedman, Bauer) stay in the
// archive and the unified search below, but are no longer shown on this page:
// the Indian liberals themselves are the canon this page presents (Adnan,
// 2026-07). They remain reachable via search and their own detail pages.

const directoryCount = allThinkers.length;

// Unified people search: the canon page only *shows* the curated list, but
// search must cover the entire thinkers database (CCS round-2 feedback:
// searching "Mukesh" on this page found nothing even though Mukesh Ambani
// exists in the extended/referenced directory). We bake a compact index of
// every person and resolve matches client-side, labelled by section.
const STATUS_LABEL: Record<string, string> = {
  core: "Liberal canon",
  extended: "Extended tradition",
  referenced: "Referenced figure, outside the tradition",
  unclassified: "Awaiting classification",
};
const STATUS_RANK: Record<string, number> = { core: 0, extended: 1, referenced: 2, unclassified: 3 };
const searchIndex = allThinkers
  .map((t) => {
    const stat = stats.get(t.id);
    return {
      s: t.id,
      n: t.data.name.canonical,
      a: (t.data.name.also_known_as ?? []).join(" "),
      c: t.data.canon_status ?? "unclassified",
      f: t.data.featured ? 1 : 0,
      d:
        t.data.birth_year || t.data.death_year
          ? `${t.data.birth_year ?? "?"}–${t.data.death_year ?? ""}`
          : "",
      w: stat?.worksAuthored ?? 0,
    };
  })
  .sort(
    (a, b) =>
      b.f - a.f ||
      (STATUS_RANK[a.c] ?? 3) - (STATUS_RANK[b.c] ?? 3) ||
      b.w - a.w ||
      a.n.localeCompare(b.n),
  );

// The canon page renders the uniform duotone treatment for consistency
// (CCS feedback 2.2). Originals remain on the detail pages. `mono` marks a
// source that is already black-and-white (the pre-generated duotone); any
// other fallback (a colour photo or ring portrait) is forced to grayscale at
// render so no colour image slips onto the home/canon rails (CCS round-2
// feedback #18b).
const treatmentFor = (t: typeof allThinkers[number]) => {
  if (t.data.portrait?.duotone) return { src: t.data.portrait.duotone, kind: "ring", mono: true } as const;
  if (t.data.portrait?.caricature) return { src: t.data.portrait.caricature, kind: "caricature", mono: false } as const;
  if (t.data.portrait?.ring_portrait) return { src: t.data.portrait.ring_portrait, kind: "ring", mono: false } as const;
  if (t.data.portrait?.photo) return { src: t.data.portrait.photo, kind: "photo", mono: false } as const;
  return null;
};

// Sentence-case a vocation enum value: "legal_scholar" → "Legal scholar"
const prettifyVocation = (v: string): string => {
  const spaced = v.replace(/_/g, " ");
  return spaced.charAt(0).toUpperCase() + spaced.slice(1);
};
---

<BaseLayout
  title="Thinkers · Indian Liberals"
  description="The curated canon of the Indian liberal tradition, from Raja Ram Mohan Roy through the Swatantra-era classical liberals."
>
  <section class="border-b border-(--color-border)">
    <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
      <p class="text-xs uppercase tracking-widest text-(--color-saffron-700) font-(family-name:--font-ui) font-semibold mb-3">
        Thinkers
      </p>
      <h1 class="text-(--color-fg) mb-4">The Indian liberal canon</h1>
      <p class="text-(--color-fg-muted) leading-relaxed max-w-prose">
        The thinkers at the heart of this archive, the reformers, economists,
        statesmen, and editors who built the case for individual liberty, free
        enterprise, and constitutional governance in modern India. Presented
        chronologically, from the early social reformers to the farmers&rsquo;
        movement of the 1980s.
      </p>
      <p class="text-(--color-fg-muted) text-sm mt-4 font-(family-name:--font-ui)">
        {canon.length} canonical thinkers
      </p>

      {/* Unified people search, covers the whole database, not just this page */}
      <div class="mt-6 max-w-md font-(family-name:--font-ui)" data-pagefind-ignore>
        <label class="relative block">
          <span class="sr-only">Search all {directoryCount} people in the archive</span>
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-(--color-fg-muted)"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>
          <input
            id="people-search"
            type="search"
            placeholder={`Search all ${directoryCount} people, canon, extended, referenced…`}
            autocomplete="off"
            aria-describedby="people-search-hint"
            class="w-full pl-9 pr-3 py-2 text-sm bg-(--color-bg) border border-(--color-border) rounded-full outline-none focus:border-(--color-saffron-500) transition-colors"
          />
        </label>
        <p id="people-search-hint" class="sr-only">
          Results cover the entire directory, including people outside the curated canon.
        </p>
        <div id="people-search-status" class="sr-only" role="status" aria-live="polite"></div>
        <ul
          id="people-search-results"
          class="hidden mt-2 border border-(--color-border) rounded bg-(--color-bg) shadow-sm divide-y divide-(--color-border) overflow-hidden"
        >
        </ul>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ searchIndex, STATUS_LABEL }}>
    // Unified thinker search across every section of the database.
    (function () {
      const input = document.getElementById("people-search");
      const list = document.getElementById("people-search-results");
      const status = document.getElementById("people-search-status");
      if (!input || !list) return;

      const MAX = 10;
      const rows = searchIndex.map((p) => ({
        ...p,
        key: (p.n + " " + p.a).toLowerCase(),
        nameLower: p.n.toLowerCase(),
      }));

      function escapeHtml(s) {
        return s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
      }

      function render(q) {
        const query = q.trim().toLowerCase();
        if (query.length < 2) {
          list.classList.add("hidden");
          list.innerHTML = "";
          status.textContent = "";
          return;
        }
        const matches = rows
          .filter((p) => p.key.includes(query))
          .sort((a, b) => {
            const aStarts = a.nameLower.startsWith(query) ? 0 : 1;
            const bStarts = b.nameLower.startsWith(query) ? 0 : 1;
            return aStarts - bStarts;
          })
          .slice(0, MAX);

        if (matches.length === 0) {
          list.innerHTML =
            '<li class="px-4 py-3 text-sm text-(--color-fg-muted)">No one in the archive matches &ldquo;' +
            escapeHtml(q.trim()) +
            '&rdquo;.</li>';
          list.classList.remove("hidden");
          status.textContent = "No matches";
          return;
        }
        list.innerHTML = matches
          .map((p) => {
            const works = p.w > 0 ? (p.w === 1 ? "1 work" : p.w + " works") : "";
            const label = STATUS_LABEL[p.c] || "";
            const referenced = p.c === "referenced";
            return (
              '<li><a href="/thinkers/' + p.s + '/" class="flex items-baseline justify-between gap-3 px-4 py-2.5 no-underline hover:bg-(--color-bg-muted) transition-colors">' +
              '<span class="min-w-0"><span class="block text-sm font-semibold text-(--color-fg) truncate">' +
              escapeHtml(p.n) +
              (p.d ? ' <span class="font-normal text-xs text-(--color-fg-muted)">' + p.d + "</span>" : "") +
              "</span>" +
              (works ? '<span class="block text-xs text-(--color-forest-700)">' + works + "</span>" : "") +
              "</span>" +
              '<span class="shrink-0 text-[10px] uppercase tracking-wider px-2 py-0.5 rounded border ' +
              (referenced
                ? "border-(--color-border) text-(--color-fg-muted) bg-(--color-bg-muted)"
                : "border-(--color-forest-100) text-(--color-forest-700) bg-(--color-forest-100)") +
              '">' +
              escapeHtml(label) +
              "</span></a></li>"
            );
          })
          .join("");
        list.classList.remove("hidden");
        status.textContent = matches.length + (matches.length === 1 ? " match" : " matches");
      }

      input.addEventListener("input", () => render(input.value));
      input.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          input.value = "";
          render("");
        }
        if (e.key === "Enter") {
          const first = list.querySelector("a");
          if (first) window.location.href = first.getAttribute("href");
        }
      });
    })();
  </script>

  <section aria-labelledby="canon-heading" class="border-b border-(--color-border)">
    <div class="mx-auto max-w-6xl px-6 py-12">
      <h2 id="canon-heading" class="sr-only">The canon</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-10">
        {canon.map((t) => {
          const treatment = treatmentFor(t);
          const tStat: ThinkerStat = stats.get(t.id) ?? { worksAuthored: 0, referencedIn: 0 };
          const vocationCaption = (t.data.vocations ?? []).map(prettifyVocation).join(" · ");
          const worksText = tStat.worksAuthored === 1 ? "1 work on this site" : `${tStat.worksAuthored} works on this site`;
          const referencedText = tStat.referencedIn === 1 ? "Referenced in 1 piece" : `Referenced in ${tStat.referencedIn} pieces`;

          return (
            <a href={`/thinkers/${t.id}/`} class="group block no-underline">
              <div class="aspect-[3/4] bg-(--color-bg-muted) border border-(--color-border) rounded-sm overflow-hidden flex items-end justify-center transition-shadow group-hover:shadow-md">
                {treatment ? (
                  <img
                    src={treatment.src}
                    alt=""
                    width="240"
                    height="320"
                    loading="lazy"
                    class={`${treatment.kind === "ring"
                      ? "w-full h-full object-cover"
                      : "w-full h-full object-contain object-bottom"} ${treatment.mono ? "" : "grayscale"} group-hover:scale-[1.02] transition-transform duration-300`}
                  />
                ) : (
                  <span class="text-(--color-fg-muted) text-4xl font-(family-name:--font-display) opacity-30">
                    {t.data.name.canonical.charAt(0)}
                  </span>
                )}
              </div>
              <p class="mt-3 text-(--color-fg) font-(family-name:--font-ui) text-sm font-semibold leading-tight">
                {t.data.name.canonical}
              </p>
              {t.data.birth_year && (
                <p class="text-xs text-(--color-fg-muted) font-(family-name:--font-ui) mt-0.5">
                  {t.data.birth_year}–{t.data.death_year ?? ""}
                </p>
              )}
              {vocationCaption && (
                <p class="mt-1 text-xs text-(--color-fg-muted) font-(family-name:--font-ui)">
                  {vocationCaption}
                </p>
              )}
              {(tStat.worksAuthored > 0 || tStat.referencedIn > 0) && (
                <p class="mt-1.5 flex items-center gap-1.5 flex-wrap">
                  {tStat.worksAuthored > 0 && (
                    <span class="inline-block px-1.5 py-0.5 rounded text-[10px] uppercase tracking-wider font-(family-name:--font-ui) font-semibold bg-(--color-forest-100) text-(--color-forest-700)">
                      {worksText}
                    </span>
                  )}
                  {tStat.referencedIn > 0 && (
                    <span class="text-xs text-(--color-fg-muted) font-(family-name:--font-ui)">
                      {tStat.worksAuthored > 0 ? "· " : ""}{referencedText}
                    </span>
                  )}
                </p>
              )}
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* The "Browse the full directory" entry point is intentionally hidden per
      CCS direction. The directory page (/thinkers/directory/) still builds and
      is reachable by direct URL; it is simply not surfaced here. Not deleted. */}
</BaseLayout>
