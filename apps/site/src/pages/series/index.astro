---
// Series index — the runs that aren't periodicals.
//
// Third of the three "run" surfaces: /periodicals/ for dated issues of a
// serial, /lectures/ for video recordings, and this one for print series —
// publisher booklet runs, annual memorial lectures, numbered occasional
// papers. Grouping lives in ~/lib/series.ts (shared with the per-series page).

import BaseLayout from "~/layouts/BaseLayout.astro";
import { collectionPageNode, breadcrumbNode } from "~/lib/schema";
import { getSeries, KIND_LABEL } from "~/lib/series";

const roots = await getSeries();
const countAll = (g: (typeof roots)[number]): number =>
  g.items.length + g.children.reduce((n, c) => n + countAll(c), 0);
const totalWorks = roots.reduce((n, g) => n + countAll(g), 0);
const totalRuns = roots.reduce((n, g) => n + 1 + g.children.length, 0);
---

<BaseLayout
  schema={[
    collectionPageNode({ pagePath: "/series/", name: "Series" }),
    breadcrumbNode([
      ["Home", "/"],
      ["Series", "/series/"],
    ]),
  ]}
  title="Series · Indian Liberals"
  description={`${totalWorks} works across ${totalRuns} named runs: the Forum of Free Enterprise booklets, the A. D. Shroff Memorial Lecture, the annual union budget analyses, and the numbered occasional-paper runs.`}
>
  <section class="border-b border-(--color-border)">
    <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
      <p class="text-xs uppercase tracking-widest text-(--color-saffron-700) font-(family-name:--font-ui) font-semibold mb-3">
        Series
      </p>
      <h1 class="text-(--color-fg) mb-4">The runs</h1>
      <p class="text-(--color-fg-muted) leading-relaxed max-w-prose">
        Much of this archive was not published as standalone books but as
        <em>runs</em> — a booklet every few weeks, a lecture every autumn, a
        budget analysis every spring. Read in sequence they show an argument
        being made and remade over decades. These are the named runs that are
        not periodicals; for dated issues of a magazine see
        <a href="/periodicals/" class="text-(--color-forest-700)">Periodicals</a>,
        and for recordings see
        <a href="/lectures/" class="text-(--color-forest-700)">Lectures</a>.
      </p>
      <p class="text-(--color-fg-muted) text-sm mt-4 font-(family-name:--font-ui)">
        {totalWorks} works · {totalRuns} runs
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-6 py-12 space-y-10">
    {roots.map((g) => (
      <section>
        <a
          href={`/series/${g.entry.id}/`}
          class="flex gap-5 p-5 bg-(--color-bg) border border-(--color-border) rounded-lg no-underline hover:border-(--color-fg) hover:shadow-md transition-all group font-(family-name:--font-ui)"
        >
          <div class="self-start shrink-0 w-24 md:w-28 aspect-[3/4] rounded-sm overflow-hidden border border-(--color-border) bg-(--color-bg-muted) flex items-center justify-center">
            {g.cover ? (
              <img
                src={g.cover}
                alt=""
                width="140"
                height="187"
                loading="lazy"
                class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-300"
              />
            ) : (
              <span class="font-(family-name:--font-display) text-2xl text-(--color-fg-muted)">
                {g.entry.data.name.split(" ").slice(0, 2).map((s) => s[0]).join("")}
              </span>
            )}
          </div>
          <div class="min-w-0">
            <span class="inline-block px-1.5 py-0.5 rounded text-[10px] uppercase tracking-wider font-semibold bg-(--color-saffron-100) text-(--color-saffron-700) mb-1.5">
              {KIND_LABEL[g.entry.data.kind]}
            </span>
            <h2 class="font-(family-name:--font-display) font-semibold text-xl text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors leading-tight">
              {g.entry.data.name}
            </h2>
            <p class="text-xs text-(--color-fg-muted) mt-1 mb-2">
              {countAll(g)} {countAll(g) === 1 ? "work" : "works"}
              {g.yearRange && ` · ${g.yearRange}`}
              {g.children.length > 0 && ` · ${g.children.length} sub-series`}
            </p>
            <p class="text-sm text-(--color-fg-muted) leading-snug line-clamp-3">
              {g.entry.data.blurb}
            </p>
          </div>
        </a>

        {g.children.length > 0 && (
          <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-3 ml-0 md:ml-8 font-(family-name:--font-ui)">
            {g.children.map((c) => (
              <li>
                <a
                  href={`/series/${c.entry.id}/`}
                  class="block h-full p-3.5 bg-(--color-bg) border border-(--color-border) rounded no-underline hover:border-(--color-fg) transition-all group"
                >
                  <span class="text-[10px] uppercase tracking-wider font-semibold text-(--color-fg-muted)">
                    {KIND_LABEL[c.entry.data.kind]}
                  </span>
                  <h3 class="font-(family-name:--font-display) font-semibold text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors leading-tight mt-0.5">
                    {c.entry.data.name}
                  </h3>
                  <p class="text-xs text-(--color-fg-muted) mt-1">
                    {c.items.length} {c.items.length === 1 ? "work" : "works"}
                    {c.yearRange && ` · ${c.yearRange}`}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </div>
</BaseLayout>
