---
import ComingSoon from "~/components/ComingSoon.astro";
import { siteCopy, t } from "~/lib/site-copy";

const copy = await siteCopy("coming-soon");
---

<ComingSoon
  title={t(copy, "testimonials_title", "Testimonials")}
  path="/testimonials/"
  blurb={t(copy, "testimonials_blurb", "What readers, scholars, and the institutions that hold this material say about the archive and its use.")}
/>
