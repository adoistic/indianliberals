---
// Public-facing index for the ThePrint "Indian Liberals Matter" column.
//
// Each item links DIRECTLY to theprint.in, humans never land on the
// internal mirror page. The internal /theprint-mirror/<slug>/ routes
// remain for AI agents (the .md siblings and AGENTS.md reference them)
// but they're not surfaced to human readers anywhere.
//
// The column runs in both English (theprint.in) and Hindi
// (hindi.theprint.in). A language toggle lets readers filter between the two
// (CCS follow-up: a proper English/Hindi filter on this page).

import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("theprint-mirror", (p) => !p.data.draft)).sort(
  (a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate),
);

const langOf = (p: (typeof posts)[number]) => p.data.language ?? "en";
const enCount = posts.filter((p) => langOf(p) === "en").length;
const hiCount = posts.filter((p) => langOf(p) === "hi").length;
const hasHindi = hiCount > 0;

const filters = [
  { key: "all", label: "All", count: posts.length },
  { key: "en", label: "English", count: enCount },
  { key: "hi", label: "हिन्दी", count: hiCount },
];
---

<BaseLayout
  title="From ThePrint · Indian Liberals Matter"
  description="The Indian Liberals Matter column on ThePrint, a regular surface for the Indian liberal tradition, in English and Hindi. Each article links to ThePrint."
>
  <section class="border-b border-(--color-border)">
    <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
      <p class="text-xs uppercase tracking-widest text-(--color-saffron-700) font-(family-name:--font-ui) font-semibold mb-3">
        Federated column · indianliberals × theprint
      </p>
      <h1 class="text-(--color-fg) mb-4">Indian Liberals Matter</h1>
      <p class="text-(--color-fg-muted) leading-relaxed max-w-prose">
        A regular column on ThePrint surfacing the Indian liberal tradition
        for a contemporary readership, in English and Hindi. We catalogue every
        piece here and link out to ThePrint where the canonical version lives.
        Each article opens at <a href="https://theprint.in/category/opinion/indian-liberals-matter/" class="text-(--color-forest-700)">theprint.in</a>.
      </p>
    </div>
  </section>
  <section>
    <div class="mx-auto max-w-3xl px-6 py-12">
      <div class="flex items-center justify-between gap-4 flex-wrap mb-8">
        <p class="text-(--color-fg-muted) text-sm font-(family-name:--font-ui)">
          <span id="tp-count">{posts.length}</span> pieces · sorted by most recent.
        </p>
        {hasHindi && (
          <div class="flex gap-1.5 font-(family-name:--font-ui)" role="group" aria-label="Filter by language">
            {filters.map((f) => (
              <button
                type="button"
                data-tp-lang={f.key}
                class="tp-lang-btn px-3 py-1 text-sm rounded-full border transition-colors bg-(--color-bg) text-(--color-fg) border-(--color-border) hover:border-(--color-fg) aria-[pressed=true]:bg-(--color-fg) aria-[pressed=true]:text-white aria-[pressed=true]:border-(--color-fg)"
                aria-pressed={f.key === "all" ? "true" : "false"}
              >
                {f.label} <span class="opacity-70">({f.count})</span>
              </button>
            ))}
          </div>
        )}
      </div>
      <ul class="divide-y divide-(--color-border)" id="tp-list">
        {posts.map((p) => (
          <li class="tp-item py-6" data-lang={langOf(p)}>
            <a
              href={p.data.theprint_url}
              target="_blank"
              rel="noopener canonical"
              class="block no-underline group"
              lang={langOf(p)}
            >
              <p class="text-xs text-(--color-fg-muted) font-(family-name:--font-ui) mb-1">
                {new Date(p.data.pubDate).toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" })} · {p.data.author_name}
                {langOf(p) === "hi" && (
                  <span class="ml-2 px-1.5 py-0.5 text-[10px] uppercase tracking-wider bg-(--color-bg-muted) border border-(--color-border) rounded">हिन्दी</span>
                )}
              </p>
              <h2 class="font-(family-name:--font-display) text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors text-xl leading-snug">
                {p.data.title}
                <span class="inline-block ml-1 text-(--color-fg-muted) text-sm align-middle" aria-hidden>↗</span>
              </h2>
            </a>
          </li>
        ))}
      </ul>
      <p id="tp-empty" class="hidden text-center py-12 text-(--color-fg-muted) font-(family-name:--font-ui)">
        No pieces in this language yet.
      </p>
    </div>
  </section>

  <script is:inline>
    (function () {
      const btns = Array.from(document.querySelectorAll(".tp-lang-btn"));
      if (!btns.length) return;
      const items = Array.from(document.querySelectorAll(".tp-item"));
      const countEl = document.getElementById("tp-count");
      const emptyEl = document.getElementById("tp-empty");

      function apply(lang) {
        let visible = 0;
        for (const li of items) {
          const show = lang === "all" || (li.dataset.lang || "en") === lang;
          li.style.display = show ? "" : "none";
          if (show) visible++;
        }
        if (countEl) countEl.textContent = String(visible);
        if (emptyEl) emptyEl.classList.toggle("hidden", visible !== 0);
        for (const b of btns) b.setAttribute("aria-pressed", b.dataset.tpLang === lang ? "true" : "false");
      }

      for (const b of btns) {
        b.addEventListener("click", () => apply(b.dataset.tpLang));
      }
    })();
  </script>
</BaseLayout>
