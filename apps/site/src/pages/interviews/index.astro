---
// Interviews index — the recorded voices of the Indian liberal tradition,
// presented like the periodical space (CCS round-2 model, Adnan 2026-07):
// a wall of openable cards rather than one long scroll. You pick a *figure*
// (an interviewee whose oral history spans several sittings) or a *collection*
// (historic lectures, topical talks, IL Explainers, or the conversations) and
// open it at /interviews/<shelf>/ to see the recordings inside.
//
// All grouping logic and the figure/collection split live in
// ~/lib/interviews.ts (shared with the per-shelf page).

import BaseLayout from "~/layouts/BaseLayout.astro";
import { collectionPageNode, breadcrumbNode } from "~/lib/schema";
import { ogSection } from "~/lib/og";
import { getInterviewShelves } from "~/lib/interviews";

const { figures, collections, total, yearSpan } = await getInterviewShelves();
---

<BaseLayout
  schema={[
    collectionPageNode({ pagePath: "/interviews/", name: "Interviews & oral history" }),
    breadcrumbNode([
      ["Home", "/"],
      ["Interviews & oral history", "/interviews/"],
    ]),
  ]}
  ogImage={ogSection("interviews")}
  title="Interviews & oral history · Indian Liberals"
  description={`${total} recorded interviews, oral histories, lectures, and explainers spanning ${yearSpan}. Open a figure to hear their oral history, or browse the themed collections.`}
>
  <section class="border-b border-(--color-border)">
    <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
      <p class="text-xs uppercase tracking-widest text-(--color-saffron-700) font-(family-name:--font-ui) font-semibold mb-3">
        Recorded voices
      </p>
      <h1 class="text-(--color-fg) mb-4">Interviews &amp; oral history</h1>
      <p class="text-(--color-fg-muted) leading-relaxed max-w-prose">
        The spoken record of the Indian liberal tradition. Open a figure to hear
        their oral history — the people who lived the licence raj and the 1991
        reforms, sitting down to tell it — or browse the themed collections of
        historic addresses, topical talks, animated explainers, and
        conversations. Every recording carries a cleaned transcript, an AI
        summary, and the original video.
      </p>
      <p class="text-(--color-fg-muted) text-sm mt-4 font-(family-name:--font-ui)">
        {total} recordings · {yearSpan} · transcripts included
      </p>
    </div>
  </section>

  {/* ── By figure ─────────────────────────────────────────────────── */}
  {figures.length > 0 && (
    <section class="border-b border-(--color-border)">
      <div class="mx-auto max-w-6xl px-6 py-12">
        <div class="mb-8 max-w-prose">
          <h2 class="text-(--color-fg) text-2xl md:text-3xl font-(family-name:--font-display)">By figure</h2>
          <p class="text-(--color-fg-muted) leading-relaxed mt-2">
            Interviewees whose oral histories run across several sittings. Open a
            figure to see every conversation with them in one place.
          </p>
        </div>
        <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-8 font-(family-name:--font-ui)">
          {figures.map((f) => (
            <li>
              <a href={`/interviews/${f.slug}/`} class="group block no-underline">
                <div class="aspect-[3/4] bg-(--color-bg-muted) border border-(--color-border) rounded-sm overflow-hidden flex items-end justify-center transition-shadow group-hover:shadow-md">
                  {f.portrait ? (
                    <img
                      src={f.portrait}
                      alt=""
                      width="240"
                      height="320"
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
                    />
                  ) : (
                    <span aria-hidden="true" class="text-(--color-saffron-700) text-4xl font-(family-name:--font-display) font-semibold opacity-60">
                      {f.title.charAt(0)}
                    </span>
                  )}
                </div>
                <h3 class="mt-3 text-(--color-fg) font-semibold text-sm leading-tight group-hover:text-(--color-saffron-700) transition-colors">
                  {f.title}
                </h3>
                <p class="text-xs text-(--color-fg-muted) mt-0.5">
                  {f.items.length === 1 ? "1 conversation" : `${f.items.length} conversations`}
                  {f.yearRange && ` · ${f.yearRange}`}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* ── Collections ───────────────────────────────────────────────── */}
  {collections.length > 0 && (
    <section>
      <div class="mx-auto max-w-6xl px-6 py-12">
        <div class="mb-8 max-w-prose">
          <h2 class="text-(--color-fg) text-2xl md:text-3xl font-(family-name:--font-display)">Collections</h2>
          <p class="text-(--color-fg-muted) leading-relaxed mt-2">
            Recordings grouped by kind rather than by person — addresses, talks,
            explainers, and the conversations.
          </p>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 font-(family-name:--font-ui)">
          {collections.map((c) => (
            <li>
              <a
                href={`/interviews/${c.slug}/`}
                class="flex gap-4 h-full p-4 bg-(--color-bg) border border-(--color-border) rounded-lg no-underline hover:border-(--color-fg) hover:shadow-md hover:-translate-y-0.5 transition-all group"
              >
                <div class="shrink-0 w-28 aspect-video rounded-sm overflow-hidden border border-(--color-border) bg-(--color-bg-muted) flex items-center justify-center">
                  {c.thumb ? (
                    <img
                      src={c.thumb}
                      alt=""
                      width="160"
                      height="90"
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
                    />
                  ) : (
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-(--color-fg-muted)" aria-hidden="true"><path d="m22 8-6 4 6 4V8z"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>
                  )}
                </div>
                <div class="min-w-0 flex flex-col">
                  <h3 class="font-(family-name:--font-display) font-semibold text-lg text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors leading-tight">
                    {c.title}
                  </h3>
                  <p class="text-xs text-(--color-fg-muted) mt-1 mb-2">
                    {c.items.length === 1 ? "1 recording" : `${c.items.length} recordings`}
                    {c.yearRange && ` · ${c.yearRange}`}
                  </p>
                  <p class="text-sm text-(--color-fg-muted) leading-snug line-clamp-3">
                    {c.blurb}
                  </p>
                  <span class="mt-auto pt-2 text-xs font-semibold text-(--color-forest-700) group-hover:text-(--color-fg) transition-colors">
                    Browse recordings <span aria-hidden>→</span>
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>
