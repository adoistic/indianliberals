---
// Oral history index — the recorded voices of the Indian liberal tradition.
//
// Four doorways in a 2×2 grid (Adnan, 2026-08): Interviews, Talks &
// monologues, IL Explainers, and Conversations. The page used to show the
// interviewees as a wall of portrait cards above the themed collections,
// which made the shelf of *people* compete with the shelf of *kinds* for the
// same attention. The people now live behind one "Interviews" box at
// /interviews/people/, so the landing page presents four peer choices and
// nothing else.
//
// All grouping logic and the figure/collection split live in
// ~/lib/interviews.ts (shared with the per-shelf page).

import BaseLayout from "~/layouts/BaseLayout.astro";
import { collectionPageNode, breadcrumbNode } from "~/lib/schema";
import { ogSection } from "~/lib/og";
import { getInterviewShelves } from "~/lib/interviews";
import { siteCopy, t, fmt, keyed } from "~/lib/site-copy";

const copy = await siteCopy("section-interviews");
const doorway = (key: string) => keyed(copy, "doorways", key);

const { figures, collections, total, yearSpan } = await getInterviewShelves();

// Every oral-history conversation across all the interviewees, so the
// Interviews box can state its own size the way the collections do.
const figureRecordings = figures.reduce((n, f) => n + f.items.length, 0);
const figureYears = figures.map((f) => f.yearRange).filter(Boolean);

// The four boxes. Interviews is synthesised from the figure shelves; the
// other three are the themed collections exactly as they were.
type Box = {
  href: string;
  title: string;
  meta: string;
  blurb: string;
  thumb?: string;
};

const boxes: Box[] = [
  ...(figures.length > 0
    ? [
        {
          href: "/interviews/people/",
          title: t(doorway("interviews"), "title", "Interviews"),
          meta: `${figures.length} ${figures.length === 1 ? "interviewee" : "interviewees"} · ${figureRecordings} ${figureRecordings === 1 ? "conversation" : "conversations"}`,
          blurb: t(
            doorway("interviews"),
            "blurb",
            "Sit-down oral histories with the people who lived the licence raj and the 1991 reforms, each running across several sittings. Open a name to hear their whole conversation in one place.",
          ),
          thumb: figures[0]?.thumb,
        },
      ]
    : []),
  ...collections.map((c) => ({
    href: `/interviews/${c.slug}/`,
    title: t(doorway(c.slug), "title", c.title),
    meta: `${c.items.length} ${c.items.length === 1 ? "recording" : "recordings"}${c.yearRange ? ` · ${c.yearRange}` : ""}`,
    blurb: t(doorway(c.slug), "blurb", c.blurb),
    thumb: c.thumb,
  })),
];
---

<BaseLayout
  schema={[
    collectionPageNode({ pagePath: "/interviews/", name: "Oral history" }),
    breadcrumbNode([
      ["Home", "/"],
      ["Oral history", "/interviews/"],
    ]),
  ]}
  ogImage={ogSection("interviews")}
  title={t(copy, "title", "Oral history · Indian Liberals")}
  description={fmt(
    t(copy, "description", "{count} recorded interviews, oral histories, talks, and explainers spanning {span}. Open the interviews to hear a figure's oral history, or browse the themed collections."),
    { count: total, span: yearSpan },
  )}
>
  <section class="border-b border-(--color-border)">
    <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
      <p class="text-xs uppercase tracking-widest text-(--color-saffron-700) font-(family-name:--font-ui) font-semibold mb-3">
        {t(copy, "eyebrow", "Recorded voices")}
      </p>
      <h1 class="text-(--color-fg) mb-4">{t(copy, "heading", "Oral history")}</h1>
      <p class="text-(--color-fg-muted) leading-relaxed max-w-prose">
        {t(copy, "lede", "The spoken record of the Indian liberal tradition: the people who lived the licence raj and the 1991 reforms, sitting down to tell it, alongside topical talks, animated explainers, and conversations. Every recording carries a cleaned transcript, an AI summary, and the original video.")}
      </p>
      <p class="text-(--color-fg-muted) text-sm mt-4 font-(family-name:--font-ui)">
        {total} recordings · {yearSpan} · transcripts included
      </p>
    </div>
  </section>

  {/* ── The four doorways, 2×2 on anything wider than a phone ────────── */}
  <div class="mx-auto max-w-6xl px-6 py-12">
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-5 font-(family-name:--font-ui) list-none pl-0">
      {boxes.map((b) => (
        <li>
          <a
            href={b.href}
            class="flex gap-4 sm:gap-5 h-full p-4 sm:p-5 bg-(--color-bg) border border-(--color-border) rounded-lg no-underline hover:border-(--color-fg) hover:shadow-md hover:-translate-y-0.5 transition-all group"
          >
            {/* Thumb steps down on phones: at 375px a fixed 8rem thumb leaves
                the text column ~137px, which is narrower than the unbreakable
                word "Conversations" and pushed it out of the card. */}
            <div class="shrink-0 w-24 sm:w-32 aspect-video rounded-sm overflow-hidden border border-(--color-border) bg-(--color-bg-muted) flex items-center justify-center">
              {b.thumb ? (
                <img
                  src={b.thumb}
                  alt=""
                  width="160"
                  height="90"
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
                />
              ) : (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-(--color-fg-muted)" aria-hidden="true"><path d="m22 8-6 4 6 4V8z"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>
              )}
            </div>
            <div class="min-w-0 flex flex-col">
              <h2 class="font-(family-name:--font-display) font-semibold text-xl text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors leading-tight break-words hyphens-auto">
                {b.title}
              </h2>
              <p class="text-xs text-(--color-fg-muted) mt-1 mb-2">{b.meta}</p>
              <p class="text-sm text-(--color-fg-muted) leading-snug line-clamp-3">
                {b.blurb}
              </p>
              <span class="mt-auto pt-2 text-xs font-semibold text-(--color-forest-700) group-hover:text-(--color-fg) transition-colors">
                Browse recordings <span aria-hidden>→</span>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
