---
// Languages: the archive by the language its works were published in.
// CCS round-3 feedback, 3.5. See lib/languages.ts for why this reads the
// corpus rather than naming three languages.

import BaseLayout from "~/layouts/BaseLayout.astro";
import { collectionPageNode, breadcrumbNode } from "~/lib/schema";
import { ogSection } from "~/lib/og";
import { getLanguageShelves } from "~/lib/languages";
import { siteCopy, t, fmt } from "~/lib/site-copy";

const copy = await siteCopy("section-languages");
const LEDE_FALLBACK =
  "Most of this archive argues in English, because that is the language its authors chose for a national audience. Not all of it. The Marathi farmers&rsquo; movement, the Gujarati commercial press and the Bengali social reformers wrote for readers closer to home, and those works are collected here by the language they were published in.";

const shelves = await getLanguageShelves();
const total = shelves.reduce((n, s) => n + s.total, 0);

// Built here rather than inline: adjacent JSX expressions get whitespace
// between them, which put a space before the comma in "5 works , 24 columns".
function summarise(s: (typeof shelves)[number]): string {
  const parts: string[] = [];
  // Periodical issues are works too. Counting only the standalone ones showed
  // Marathi as 25 when it holds 78, and left Gujarati blank, its whole shelf
  // being one magazine run.
  const works = s.workCount + s.issueCount;
  if (works > 0) parts.push(`${works} ${works === 1 ? "work" : "works"}`);
  if (s.columns.length > 0) parts.push(`${s.columns.length} ThePrint columns`);
  return parts.join(", ") + (s.yearRange ? ` · ${s.yearRange}` : "");
}
---

<BaseLayout
  schema={[
    collectionPageNode({ pagePath: "/languages/", name: "Languages" }),
    breadcrumbNode([
      ["Home", "/"],
      ["Languages", "/languages/"],
    ]),
  ]}
  ogImage={ogSection("primary-works")}
  title={t(copy, "title", "Languages · Indian Liberals")}
  description={fmt(t(copy, "description", "{count} items in the Indian languages: {langs}."), {
    count: total,
    langs: shelves.map((s) => s.english).join(", "),
  })}
>
  <section class="border-b border-(--color-border)">
    <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
      <h1 class="text-(--color-fg) mb-4">{t(copy, "heading", "Languages")}</h1>
      <p
        class="text-(--color-fg-muted) leading-relaxed max-w-prose"
        set:html={t(copy, "lede", LEDE_FALLBACK)}
      />
      <p class="text-(--color-fg-muted) text-sm mt-4 font-(family-name:--font-ui)">
        {total} items across {shelves.length} languages
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-6 py-12">
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-5 font-(family-name:--font-ui)">
      {shelves.map((s) => (
        <li>
          <a
            href={`/languages/${s.code}/`}
            class="flex h-full flex-col p-6 bg-(--color-bg) border border-(--color-border) rounded-lg no-underline hover:border-(--color-fg) hover:shadow-md transition-all group"
          >
            <span
              lang={s.code}
              class="font-(family-name:--font-display) text-3xl text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors leading-none"
            >
              {s.native}
            </span>
            <span class="mt-2 text-sm font-semibold text-(--color-fg)">{s.english}</span>
            <span class="mt-1 text-xs text-(--color-fg-muted)">{summarise(s)}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
