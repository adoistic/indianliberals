---
// Lectures index — the formal named lectures of the Indian liberal tradition:
// the annual/memorial series (one marquee address a year) and the historic
// addresses recovered from the archive. A wall of series cards; open one at
// /lectures/<series>/ to see its recordings. Distinct from the sit-down
// interviews at /interviews/. (Adnan, 2026-07)
//
// Grouping logic lives in ~/lib/lectures.ts (shared with the per-series page).

import BaseLayout from "~/layouts/BaseLayout.astro";
import { collectionPageNode, breadcrumbNode } from "~/lib/schema";
import { ogSection } from "~/lib/og";
import { getLectureSeries } from "~/lib/lectures";

const { series, total, yearSpan } = await getLectureSeries();
---

<BaseLayout
  schema={[
    collectionPageNode({ pagePath: "/lectures/", name: "Lectures & addresses" }),
    breadcrumbNode([
      ["Home", "/"],
      ["Lectures & addresses", "/lectures/"],
    ]),
  ]}
  ogImage={ogSection("interviews")}
  title="Lectures & addresses · Indian Liberals"
  description={`${total} recorded lectures and addresses spanning ${yearSpan} — the B.R. Shenoy Memorial Lecture, the Indian Liberals Annual Lecture, and historic addresses. Each carries a transcript and the original video.`}
>
  <section class="border-b border-(--color-border)">
    <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
      <p class="text-xs uppercase tracking-widest text-(--color-saffron-700) font-(family-name:--font-ui) font-semibold mb-3">
        Recorded voices
      </p>
      <h1 class="text-(--color-fg) mb-4">Lectures &amp; addresses</h1>
      <p class="text-(--color-fg-muted) leading-relaxed max-w-prose">
        The formal lectures of the Indian liberal tradition — the annual and
        memorial series where leading economists and public figures take the
        podium once a year, and the historic addresses recovered from the
        archive. Distinct from the sit-down
        <a href="/interviews/" class="text-(--color-forest-700) hover:text-(--color-fg)">interviews and oral histories</a>.
        Every recording carries a cleaned transcript, an AI summary, and the
        original video.
      </p>
      <p class="text-(--color-fg-muted) text-sm mt-4 font-(family-name:--font-ui)">
        {total} lectures · {yearSpan} · transcripts included
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-6 py-12">
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 font-(family-name:--font-ui)">
        {series.map((c) => (
          <li>
            <a
              href={`/lectures/${c.slug}/`}
              class="flex gap-4 h-full p-4 bg-(--color-bg) border border-(--color-border) rounded-lg no-underline hover:border-(--color-fg) hover:shadow-md hover:-translate-y-0.5 transition-all group"
            >
              <div class="shrink-0 w-28 aspect-video rounded-sm overflow-hidden border border-(--color-border) bg-(--color-bg-muted) flex items-center justify-center">
                {c.thumb ? (
                  <img
                    src={c.thumb}
                    alt=""
                    width="160"
                    height="90"
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
                  />
                ) : (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-(--color-fg-muted)" aria-hidden="true"><path d="m22 8-6 4 6 4V8z"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>
                )}
              </div>
              <div class="min-w-0 flex flex-col">
                <h2 class="font-(family-name:--font-display) font-semibold text-lg text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors leading-tight">
                  {c.title}
                </h2>
                <p class="text-xs text-(--color-fg-muted) mt-1 mb-2">
                  {c.items.length === 1 ? "1 lecture" : `${c.items.length} lectures`}
                  {c.yearRange && ` · ${c.yearRange}`}
                </p>
                <p class="text-sm text-(--color-fg-muted) leading-snug line-clamp-3">
                  {c.blurb}
                </p>
                <span class="mt-auto pt-2 text-xs font-semibold text-(--color-forest-700) group-hover:text-(--color-fg) transition-colors">
                  Browse lectures <span aria-hidden>→</span>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
