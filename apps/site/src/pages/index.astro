---
// Landing page, the collection is the hero.
//
// Design intent (2026-06 redesign): a world-class archive leads with its
// holdings, not with copy about itself. The hero is a drifting mosaic of
// the collection's own portraits and periodical covers; the stats band
// doubles as a navigable map of the corpus; every doorway card is built
// from real collection imagery. All motion is CSS-only, staggered via
// IntersectionObserver, and fully disabled under prefers-reduced-motion.

import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getPeriodicalSeries } from "~/lib/periodicals";
import { isListed } from "~/lib/listable";
import { isCanonThinker } from "~/lib/canon";

const allThinkers = await getCollection("thinkers", (t) => !t.data.draft);

// This is the *Indian* liberals archive: the hero, canon rail, and doorways
// lead with Indian thinkers. The international influences (Mill, Hayek, Mises,
// Friedman, Bauer) remain featured and fully reachable through the directory
// and their own pages, but they are not surfaced on the landing imagery — the
// emphasis belongs to the Indian tradition (Adnan, 2026-07).
const featuredThinkers = allThinkers
  .filter((t) => isCanonThinker(t) && t.data.portrait?.duotone)
  .sort((a, b) => (a.data.birth_year ?? 9999) - (b.data.birth_year ?? 9999));

// Latest 6 ThePrint articles, links go out to theprint.in (the canonical
// home). The federated column updates daily via the theprint-ingest worker
// (apps/theprint-ingest), so this list reflects the freshest pieces in
// the "Indian Liberals Matter" column on each build.
const latestTheprint = (await getCollection("theprint-mirror", (p) => !p.data.draft))
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate))
  .slice(0, 6);

// Archive stats band, computed at build time so the numbers never drift
// from the content. Thinker count covers the liberal tradition itself
// (canon core + extended), not the referenced/unclassified figures who
// appear in the corpus only through citation.
const allWorks = await getCollection("primary-works", isListed);
const allMusings = await getCollection("musings", (m) => !m.data.draft);
const allOpinions = await getCollection("opinions", (o) => !o.data.draft);
const interviewCount = allWorks.filter((w) => w.data.work_type === "interview").length;
const periodicalCount = allWorks.filter((w) => w.data.work_type === "periodical_issue").length;

// Pages held in the scanned archive. Every listed work that has a PDF now
// carries a measured `physical.pages_total` (pypdfium2 at extraction time,
// pdfinfo for the re-extracted Indian Libertarian issues, pypdf for the last
// two Forum of Free Enterprise pamphlets), so this sum is the real extent of
// the scans and not an estimate. The works without a PDF — the recorded
// interviews and lectures — contribute nothing, which is correct: they have
// no pages. If a future ingest lands a PDF without a count, this figure
// quietly undercounts rather than inventing pages.
const pdfWorks = allWorks.filter((w) => w.data.pdf_url);
const pageTotal = pdfWorks.reduce(
  (sum, w) => sum + (w.data.physical?.pages_total ?? w.data.physical?.page_count ?? 0),
  0,
);

const stats: { value: number; label: string; href?: string }[] = [
  // The one tile that is a fact rather than a doorway: there is no "pages"
  // section to send a reader to, and pointing it at /primary-works/ would
  // give the row two tiles with the same destination.
  { value: pageTotal, label: "Pages" },
  { value: allWorks.length, label: "Primary works", href: "/primary-works/" },
  { value: periodicalCount, label: "Periodical issues", href: "/periodicals/" },
  { value: interviewCount, label: "Oral history", href: "/interviews/" },
  {
    value: allThinkers.filter((t) =>
      ["core", "extended"].includes(t.data.canon_status),
    ).length,
    label: "Thinkers profiled",
    href: "/thinkers/",
  },
  {
    value: allMusings.length + allOpinions.length,
    label: "Excerpts & opinions",
    href: "/opinions/",
  },
  // The Organisations tile is out while the section is hidden (CCS round-3
  // feedback, 5.3). Leaving the archive's largest doorway into a hidden
  // section on the landing page would have made "hidden" mean nothing. The
  // pages themselves are untouched; restoring this is one line:
  //   { value: (await getCollection("organisations", (o) => !o.data.draft)).length,
  //     label: "Organisations", href: "/organisations/" },
];

// Works-per-decade histogram for the stats band. publication.year is the
// cover date for most works; periodical issues fall back to the year coded
// in the slug (the imported field recorded the digitisation year for some
// runs). Single bucket per decade, 1820s onward.
function workYear(w: (typeof allWorks)[number]): number | null {
  const slugYear = w.id.match(/(18|19|20)\d{2}/);
  if (w.data.work_type === "periodical_issue" && slugYear) return Number(slugYear[0]);
  return w.data.publication?.year ?? (slugYear ? Number(slugYear[0]) : null);
}
const decadeCounts = new Map<number, number>();
for (const w of allWorks) {
  const y = workYear(w);
  if (!y || y < 1800 || y > 2030) continue;
  const d = Math.floor(y / 10) * 10;
  decadeCounts.set(d, (decadeCounts.get(d) ?? 0) + 1);
}
const decadeMin = Math.min(...decadeCounts.keys());
const decadeMax = Math.max(...decadeCounts.keys());
const decades: { decade: number; count: number }[] = [];
for (let d = decadeMin; d <= decadeMax; d += 10) {
  decades.push({ decade: d, count: decadeCounts.get(d) ?? 0 });
}
const decadePeak = Math.max(...decades.map((d) => d.count));
// Works the histogram can actually place, which is fewer than allWorks: 43
// items carry neither a publication year nor a year in their slug, mostly
// undated Forum pamphlets and speeches. The caption therefore says "N of M
// works carry a date" rather than a bare total — two different unexplained
// numbers on one band (1,526 under a tile reading 1,569) read as a bug
// (Adnan, 2026-08). Any work that gains a date joins the chart on next build.
const datedWorksCount = decades.reduce((sum, d) => sum + d.count, 0);
const spanYears = decadeMax + 9 - decadeMin;

// ── Hero mosaic ─────────────────────────────────────────────────────────
// Three slowly drifting columns built from the collection's own imagery:
// duotone portraits interleaved with periodical covers. Purely decorative
// (aria-hidden); the same people are reachable through real links below.
const mosaicPortraits = featuredThinkers
  .map((t) => t.data.portrait!.duotone!)
  .slice(0, 18);
// Covers for the hero mosaic + doorways, picked round-robin across the named
// runs so the shelf reads as the whole periodical collection, not just Freedom
// First — whose ~470 ff### issues otherwise sort first alphabetically and crowd
// every other title out of a plain slice (Adnan, 2026-07).
const periodicalSeries = await getPeriodicalSeries();
function diversifiedCovers(limit: number): string[] {
  const perSeries = periodicalSeries.map((g) =>
    g.items.filter((w) => w.data.cover_image).map((w) => w.data.cover_image as string),
  );
  const out: string[] = [];
  for (let round = 0; out.length < limit && perSeries.some((a) => a.length > round); round++) {
    for (const arr of perSeries) {
      if (arr[round]) out.push(arr[round]);
      if (out.length >= limit) break;
    }
  }
  return out;
}
const mosaicCovers = diversifiedCovers(6);
// Interleave: a cover after every third portrait, split across 3 columns.
const mosaicPool: string[] = [];
let coverIdx = 0;
mosaicPortraits.forEach((p, i) => {
  mosaicPool.push(p);
  if ((i + 1) % 3 === 0 && coverIdx < mosaicCovers.length) {
    mosaicPool.push(mosaicCovers[coverIdx++]);
  }
});
const mosaicCols: string[][] = [[], [], []];
mosaicPool.forEach((src, i) => mosaicCols[i % 3].push(src));

// Doorway imagery, real objects from the collection.
const doorwayPortraits = featuredThinkers.slice(0, 3).map((t) => t.data.portrait!.duotone!);
const doorwayCovers = mosaicCovers.slice(0, 3);
const doorwayInterview = (() => {
  const preferred = allWorks.find((w) => w.id === "union-budget-1992-1993-by-nani-palkhivala");
  const candidate = preferred ?? allWorks.find((w) => w.data.work_type === "interview" && w.data.youtube_url);
  const u = candidate?.data.youtube_url ?? "";
  const m = u.match(/[?&]v=([a-zA-Z0-9_-]{6,15})/) ?? u.match(/youtu\.be\/([a-zA-Z0-9_-]{6,15})/);
  return m ? `https://i.ytimg.com/vi/${m[1]}/hqdefault.jpg` : "";
})();

const heroStripPortraits = featuredThinkers.slice(0, 8).map((t) => ({
  src: t.data.portrait!.duotone!,
  name: t.data.name.canonical,
  id: t.id,
}));
---

<BaseLayout>
  <!-- ── Hero: the collection is the hero ─────────────────────────── -->
  <section class="relative border-b border-(--color-border) overflow-hidden">
    <div class="mx-auto max-w-6xl px-6 pt-8 pb-16 md:pt-12 md:pb-24 lg:grid lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:items-center">
      <div class="relative z-10">
        <p class="text-lg md:text-xl text-(--color-saffron-700) font-(family-name:--font-ui) font-medium mb-4" data-reveal>
          A digital archive of the Indian liberal tradition
        </p>
        <h1 class="text-(--color-fg) max-w-xl text-4xl md:text-5xl lg:text-[3.4rem] leading-[1.05] tracking-tight" data-reveal style="--reveal-delay: 60ms">
          Two centuries of the liberal argument for India.
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-(--color-fg-muted) max-w-prose" data-reveal style="--reveal-delay: 120ms">
          {allWorks.length.toLocaleString("en-IN")} works, from the Bengal
          Renaissance to the 1991 reforms: the pamphlets and journals that
          carried the argument for individual liberty and free enterprise, and
          the people who made it.
        </p>
        <div class="mt-8 flex flex-wrap gap-3 font-(family-name:--font-ui)" data-reveal style="--reveal-delay: 180ms">
          <a
            href="/primary-works/"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-(--color-fg) text-white! rounded-full text-sm font-semibold no-underline hover:bg-(--color-forest-700) transition-colors"
          >
            Explore the archive <span aria-hidden>→</span>
          </a>
          <a
            href="/thinkers/"
            class="inline-flex items-center gap-2 px-5 py-2.5 border border-(--color-border) rounded-full text-sm font-semibold no-underline text-(--color-fg) hover:border-(--color-fg) transition-colors"
          >
            Meet the thinkers
          </a>
        </div>

        {/* Mobile: the collection peeks in as a horizontal strip */}
        <div class="mt-10 flex gap-3 overflow-x-auto pb-2 lg:hidden" data-reveal style="--reveal-delay: 240ms">
          {heroStripPortraits.map((p) => (
            <a href={`/thinkers/${p.id}/`} class="shrink-0 no-underline group" aria-label={p.name}>
              <img
                src={p.src}
                alt=""
                width="96"
                height="128"
                loading="lazy"
                class="h-28 w-21 object-cover rounded-sm border border-(--color-border) group-hover:opacity-90 transition-opacity"
              />
            </a>
          ))}
        </div>
      </div>

      {/* Desktop: drifting mosaic of portraits + covers */}
      <div class="hero-mosaic hidden lg:flex gap-4 h-[34rem]" aria-hidden="true">
        {mosaicCols.map((col, i) => (
          <div class={`mosaic-col flex-1 ${i === 1 ? "mosaic-col-down" : ""}`} style={`--drift-dur: ${62 + i * 14}s`}>
            <div class="mosaic-track flex flex-col gap-4">
              {[...col, ...col].map((src) => (
                <img
                  src={src}
                  alt=""
                  width="200"
                  height="266"
                  loading="lazy"
                  decoding="async"
                  class="w-full aspect-[3/4] object-cover rounded-sm border border-(--color-border) shadow-sm"
                />
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── The archive at a glance: numbers + the corpus as a timeline ── -->
  <section class="border-b border-(--color-border) bg-(--color-bg-muted)">
    <div class="mx-auto max-w-6xl px-6 pt-12 pb-10">
      <div class="flex items-baseline justify-between flex-wrap gap-2 mb-8" data-reveal>
        <h2 class="text-xs uppercase tracking-widest text-(--color-forest-700) font-(family-name:--font-ui) font-semibold">
          The archive at a glance
        </h2>
        <p class="text-xs text-(--color-fg-muted) font-(family-name:--font-ui)">
          {spanYears > 100 ? "Two centuries" : "Decades"} of the liberal argument, {decadeMin}–{decadeMax + 9}
        </p>
      </div>

      {/* Key numbers. Most link into their section of the archive; the pages
          figure is a plain stat, so it renders without link affordances. */}
      <dl class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 lg:divide-x divide-(--color-border)" data-reveal style="--reveal-delay: 80ms">
        {stats.map((s) => {
          const Cell = s.href ? "a" : "div";
          return (
            <div class="lg:px-4 first:lg:pl-0 last:lg:pr-0 py-2 lg:py-0">
              <Cell href={s.href} class="group block no-underline">
                {/* The final number is what is rendered. The count-up (CCS
                    round-3 feedback, 2.1c) only runs where JS is present and
                    motion is welcome, so a reader without either, or a crawler,
                    still gets the real figure and never a zero. */}
                <dd
                  data-countup={s.value}
                  class:list={[
                    "font-(family-name:--font-display) font-semibold text-4xl md:text-[2.75rem] lg:text-[2rem] xl:text-[2.4rem] leading-none text-(--color-fg) tabular-nums transition-colors",
                    s.href && "group-hover:text-(--color-saffron-700)",
                  ]}
                >
                  {s.value.toLocaleString("en-IN")}
                </dd>
                <dt
                  class:list={[
                    "mt-2 text-xs uppercase tracking-wider text-(--color-fg-muted) font-(family-name:--font-ui) transition-colors",
                    s.href && "group-hover:text-(--color-fg)",
                  ]}
                >
                  {s.label}{" "}
                  {s.href && (
                    <span aria-hidden class="opacity-0 group-hover:opacity-100 transition-opacity">→</span>
                  )}
                </dt>
              </Cell>
            </div>
          );
        })}
      </dl>

      {/* Works per decade, the corpus drawn as a shelf of bars */}
      <figure class="mt-10" aria-label={`Primary works per decade, ${decadeMin}s to ${decadeMax}s`} data-reveal style="--reveal-delay: 160ms">
        <div class="histogram flex items-end gap-[3px] h-20 md:h-24">
          {decades.map((d, i) => {
            const barClass = "histogram-bar relative block flex-1 rounded-t-[2px] bg-(--color-saffron-500)/70 hover:bg-(--color-saffron-700) transition-colors min-h-[2px]";
            const barStyle = `height: ${d.count === 0 ? 2 : Math.max(4, Math.round((d.count / decadePeak) * 100))}%; --bar-delay: ${i * 28}ms`;
            const label = d.count === 1 ? "1 work" : `${d.count} works`;
            const tip = `${d.decade}s · ${label}`;
            return d.count > 0 ? (
              <a
                href={`/primary-works/?decade=${d.decade}`}
                class={barClass}
                style={barStyle}
                data-tip={tip}
                aria-label={`${label} from the ${d.decade}s`}
              />
            ) : (
              <div class={barClass} style={barStyle} data-tip={tip} aria-hidden="true" />
            );
          })}
        </div>
        <figcaption class="mt-2 flex items-baseline justify-between text-[11px] text-(--color-fg-muted) font-(family-name:--font-ui)">
          <span>{decadeMin}s</span>
          <span class="hidden sm:inline">
            {datedWorksCount.toLocaleString("en-IN")} of {allWorks.length.toLocaleString("en-IN")} works carry a date, from the Bengal Renaissance to the reform era and beyond
          </span>
          <span>{decadeMax}s</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ── Four doorways into the stacks ─────────────────────────────── -->
  <section class="border-b border-(--color-border)">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="mb-10 max-w-prose" data-reveal>
        <h2 class="text-(--color-fg)">Browse the collection</h2>
        <p class="text-(--color-fg-muted) mt-2">
          Four sections, organised by what you are looking for: the individual
          works, the periodical runs, the recorded interviews, and the people
          behind them.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 font-(family-name:--font-ui)">
        {/* Primary works, a shelf of spines */}
        <a href="/primary-works/" class="doorway group block bg-(--color-bg) border border-(--color-border) rounded-lg p-5 no-underline hover:shadow-md hover:-translate-y-0.5 transition-all" data-reveal>
          <div class="h-32 mb-5 flex items-end gap-1.5 px-2" aria-hidden="true">
            <span class="w-5 h-24 rounded-t-sm bg-(--color-forest-500)/80 group-hover:h-28 transition-all duration-300"></span>
            <span class="w-5 h-28 rounded-t-sm bg-(--color-saffron-500)/80 group-hover:h-31 transition-all duration-300 delay-75"></span>
            <span class="w-5 h-20 rounded-t-sm bg-(--color-slate-500)/70 group-hover:h-24 transition-all duration-300 delay-100"></span>
            <span class="w-5 h-26 rounded-t-sm bg-(--color-gold-500)/80 group-hover:h-30 transition-all duration-300 delay-150"></span>
            <span class="w-5 h-22 rounded-t-sm bg-(--color-forest-700)/80 group-hover:h-26 transition-all duration-300 delay-200"></span>
            <span class="w-5 h-27 rounded-t-sm bg-(--color-saffron-700)/80 group-hover:h-31 transition-all duration-300 delay-300"></span>
          </div>
          <h3 class="font-(family-name:--font-display) font-semibold text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors text-lg">Primary works</h3>
          <p class="text-sm text-(--color-fg-muted) leading-relaxed mt-1.5">
            {allWorks.length} books, pamphlets, essays, and speeches, with AI-extracted metadata, summaries, and the source PDFs.
          </p>
        </a>

        {/* Periodicals, fanned covers */}
        <a href="/periodicals/" class="doorway group block bg-(--color-bg) border border-(--color-border) rounded-lg p-5 no-underline hover:shadow-md hover:-translate-y-0.5 transition-all" data-reveal style="--reveal-delay: 70ms">
          <div class="relative h-32 mb-5" aria-hidden="true">
            {doorwayCovers.map((src, i) => (
              <img
                src={src}
                alt=""
                width="84"
                height="112"
                loading="lazy"
                class={`absolute top-1 h-28 w-21 object-cover object-top rounded-sm border border-(--color-border) shadow-sm transition-transform duration-300 ${
                  i === 0
                    ? "left-2 -rotate-6 group-hover:-rotate-[9deg]"
                    : i === 1
                      ? "left-14 rotate-0 z-10 group-hover:-translate-y-1"
                      : "left-26 rotate-6 group-hover:rotate-[9deg]"
                }`}
              />
            ))}
          </div>
          <h3 class="font-(family-name:--font-display) font-semibold text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors text-lg">The periodical runs</h3>
          <p class="text-sm text-(--color-fg-muted) leading-relaxed mt-1.5">
            {periodicalCount} issues of Khoj, The Indian Libertarian, Liberal Times, and Shetkari Sanghatak, indexed issue by issue.
          </p>
        </a>

        {/* Interviews, a still with a play badge */}
        <a href="/interviews/" class="doorway group block bg-(--color-bg) border border-(--color-border) rounded-lg p-5 no-underline hover:shadow-md hover:-translate-y-0.5 transition-all" data-reveal style="--reveal-delay: 140ms">
          <div class="relative h-32 mb-5 rounded-sm overflow-hidden border border-(--color-border) bg-(--color-bg-muted)" aria-hidden="true">
            {doorwayInterview && (
              <img src={doorwayInterview} alt="" width="320" height="180" loading="lazy" class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300" />
            )}
            <span class="absolute inset-0 flex items-center justify-center">
              <span class="h-11 w-11 rounded-full bg-black/55 group-hover:bg-(--color-saffron-700)/90 transition-colors flex items-center justify-center">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
              </span>
            </span>
          </div>
          <h3 class="font-(family-name:--font-display) font-semibold text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors text-lg">Recorded voices</h3>
          <p class="text-sm text-(--color-fg-muted) leading-relaxed mt-1.5">
            {interviewCount} interviews, oral histories, and historic addresses, from Palkhivala&rsquo;s 1992 budget speech onward, with transcripts.
          </p>
        </a>

        {/* Thinkers, overlapping portrait stack */}
        <a href="/thinkers/" class="doorway group block bg-(--color-bg) border border-(--color-border) rounded-lg p-5 no-underline hover:shadow-md hover:-translate-y-0.5 transition-all" data-reveal style="--reveal-delay: 210ms">
          <div class="relative h-32 mb-5 flex items-center pl-2" aria-hidden="true">
            {doorwayPortraits.map((src, i) => (
              <img
                src={src}
                alt=""
                width="88"
                height="88"
                loading="lazy"
                class={`h-22 w-22 rounded-full object-cover object-top border-2 border-(--color-bg) shadow-sm group-hover:-translate-y-0.5 transition-transform duration-300 ${
                  i > 0 ? "-ml-7" : ""
                }`}
                style={`z-index: ${10 - i}`}
              />
            ))}
            <span class="-ml-7 h-22 w-22 rounded-full bg-(--color-bg-muted) border-2 border-(--color-bg) shadow-sm flex items-center justify-center text-sm font-semibold text-(--color-fg-muted)">
              +{featuredThinkers.length - 3}
            </span>
          </div>
          <h3 class="font-(family-name:--font-display) font-semibold text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors text-lg">The thinkers</h3>
          <p class="text-sm text-(--color-fg-muted) leading-relaxed mt-1.5">
            The curated canon, plus a full directory of every person the corpus engages, clearly labelled.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── Featured thinkers rail ────────────────────────────────────── -->
  {featuredThinkers.length > 0 && (
    <section class="border-b border-(--color-border) bg-(--color-bg-muted)">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <div class="flex items-end justify-between mb-8 flex-wrap gap-4" data-reveal>
          <div>
            <h2 class="text-(--color-fg)">The canon, in order</h2>
            <p class="text-(--color-fg-muted) mt-2 max-w-prose">
              From Raja Ram Mohan Roy to the Swatantra-era classical liberals:
              the thinkers at the heart of this archive, chronologically.
            </p>
          </div>
          <a href="/thinkers/" class="text-sm font-(family-name:--font-ui) font-semibold no-underline text-(--color-forest-700) hover:text-(--color-fg)">
            All thinkers →
          </a>
        </div>
        <div class="rail relative -mx-6 px-6" data-reveal style="--reveal-delay: 80ms">
          <ul class="flex gap-5 overflow-x-auto snap-x snap-mandatory pb-3" aria-label="Featured thinkers, chronological">
            {featuredThinkers.map((t) => (
              <li class="snap-start shrink-0 w-36 md:w-40">
                <a href={`/thinkers/${t.id}/`} class="group no-underline block">
                  <div class="aspect-[3/4] bg-(--color-bg) border border-(--color-border) rounded-sm overflow-hidden transition-shadow group-hover:shadow-md">
                    <img
                      src={t.data.portrait!.duotone}
                      alt=""
                      width="160"
                      height="214"
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
                    />
                  </div>
                  <h3 class="mt-3 font-(family-name:--font-display) font-semibold text-sm text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors leading-tight">
                    {t.data.name.canonical}
                  </h3>
                  {t.data.birth_year && (
                    <p class="text-xs text-(--color-fg-muted) font-(family-name:--font-ui) mt-0.5">
                      {t.data.birth_year}–{t.data.death_year ?? ""}
                    </p>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- ── Latest from ThePrint federated column ─────────────────────── -->
  {latestTheprint.length > 0 && (
    <section class="border-b border-(--color-border)">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <div class="flex items-end justify-between mb-8 flex-wrap gap-4" data-reveal>
          <div>
            <p class="text-xs uppercase tracking-widest text-(--color-saffron-700) font-(family-name:--font-ui) font-semibold mb-2">
              From the federated column
            </p>
            <h2 class="text-(--color-fg)">Latest from ThePrint</h2>
            <p class="text-(--color-fg-muted) mt-2 max-w-prose">
              A regular series on ThePrint surfacing the Indian liberal tradition for a contemporary readership. Each piece opens at <a href="https://theprint.in/category/opinion/indian-liberals-matter/" class="text-(--color-forest-700)">theprint.in</a>.
            </p>
          </div>
          <a href="/theprint-mirror/" class="text-sm font-(family-name:--font-ui) font-semibold no-underline text-(--color-forest-700) hover:text-(--color-fg)">
            See all →
          </a>
        </div>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal style="--reveal-delay: 80ms">
          {latestTheprint.map((p) => (
            <li>
              <a
                href={p.data.theprint_url}
                target="_blank"
                rel="noopener canonical"
                class="block h-full bg-(--color-bg) border border-(--color-border) rounded overflow-hidden no-underline hover:border-(--color-fg) hover:shadow-sm transition-all group"
              >
                {p.data.hero_image && (
                  <div class="aspect-video bg-(--color-bg-muted) border-b border-(--color-border) overflow-hidden">
                    <img
                      src={p.data.hero_image}
                      alt=""
                      width="480"
                      height="270"
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                      class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
                    />
                  </div>
                )}
                <div class="p-5">
                  <p class="text-xs uppercase tracking-wider text-(--color-fg-muted) font-(family-name:--font-ui) mb-2">
                    {new Date(p.data.pubDate).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" })} · {p.data.author_name}
                  </p>
                  <h3 class="font-(family-name:--font-display) font-semibold text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors leading-snug">
                    {p.data.title}
                    <span aria-hidden class="inline-block ml-1 text-(--color-fg-muted) text-sm">↗</span>
                  </h3>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ── Built for citation: researchers, AI agents, the tier model ── -->
  <section class="bg-(--color-forest-900)">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <div class="grid md:grid-cols-2 gap-12">
        <div data-reveal>
          <p class="text-xs uppercase tracking-widest text-(--color-gold-300) font-(family-name:--font-ui) font-semibold mb-3">
            For researchers and AI agents
          </p>
          <h2 class="text-white! mb-4">A citation-grade source you can trust.</h2>
          <p class="text-white/75 leading-relaxed mb-4">
            Every page has a <code class="font-(family-name:--font-mono) text-sm bg-white/10 text-white px-1.5 py-0.5 rounded">.md</code> sibling for machine readers. The corpus is indexed at <code class="font-(family-name:--font-mono) text-sm bg-white/10 text-white px-1.5 py-0.5 rounded">/llms.txt</code> and <code class="font-(family-name:--font-mono) text-sm bg-white/10 text-white px-1.5 py-0.5 rounded">/llms-full.txt</code> following the llms.txt spec.
          </p>
          <p class="text-white/75 leading-relaxed">
            A Model Context Protocol server at <a href="https://mcp.indianliberals.in" class="text-(--color-gold-300)! hover:text-white! decoration-(--color-gold-300)/50!">mcp.indianliberals.in</a> lets your LLM client query the archive directly. See <a href="/AGENTS.md" class="text-(--color-gold-300)! hover:text-white! decoration-(--color-gold-300)/50!">/AGENTS.md</a> for the schema and citation rules.
          </p>
        </div>
        <div data-reveal style="--reveal-delay: 100ms">
          <p class="text-xs uppercase tracking-widest text-(--color-gold-300) font-(family-name:--font-ui) font-semibold mb-3">
            The two-tier model
          </p>
          <h2 class="text-white! mb-4">Honest about what we know.</h2>
          <p class="text-white/75 leading-relaxed mb-4">
            Curated excerpts, opinion pieces, interviews, and profiles are fully searchable and paragraph-citable.
          </p>
          <p class="text-white/75 leading-relaxed">
            Primary-work PDFs surface with rich metadata and AI-generated summaries. Paragraph-level citation inside the original works is deferred to a future engagement, when vision-language layout reconstruction is reliable enough to clear editorial review.
          </p>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Scroll reveal, elements drift up as they enter the viewport. The
       no-js / reduced-motion default is fully visible content. */
    @media (prefers-reduced-motion: no-preference) {
      :global(.js-reveal) [data-reveal] {
        opacity: 0;
        transform: translateY(14px);
        transition:
          opacity 0.6s ease var(--reveal-delay, 0ms),
          transform 0.6s ease var(--reveal-delay, 0ms);
      }
      :global(.js-reveal) [data-reveal].in-view {
        opacity: 1;
        transform: none;
      }

      /* Histogram bars grow out of the baseline, staggered left → right. */
      :global(.js-reveal) .histogram-bar {
        transform: scaleY(0);
        transform-origin: bottom;
        transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) var(--bar-delay, 0ms);
      }
      :global(.js-reveal) [data-reveal].in-view .histogram-bar {
        transform: scaleY(1);
      }

      /* Hero mosaic drift, each column loops over a duplicated track. */
      .mosaic-track {
        animation: mosaic-drift var(--drift-dur, 70s) linear infinite;
      }
      .mosaic-col-down .mosaic-track {
        animation-direction: reverse;
      }
      @keyframes mosaic-drift {
        from { transform: translateY(0); }
        to { transform: translateY(-50%); }
      }
    }

    /* Instant, styled tooltip on the works-per-decade bars — the intermediate
       decades carry no visible axis label, so hovering (or keyboard-focusing)
       a bar names its decade and count immediately, without the sluggish
       native title delay. */
    .histogram-bar::after {
      content: attr(data-tip);
      position: absolute;
      bottom: 100%;
      left: 50%;
      transform: translateX(-50%);
      margin-bottom: 6px;
      padding: 3px 8px;
      border-radius: 6px;
      background: var(--color-fg);
      color: var(--color-bg);
      font-family: var(--font-ui);
      font-size: 11px;
      font-weight: 600;
      line-height: 1.1;
      white-space: nowrap;
      letter-spacing: 0.01em;
      box-shadow: 0 2px 8px rgb(0 0 0 / 0.18);
      opacity: 0;
      pointer-events: none;
      z-index: 20;
      transition: opacity 0.12s ease;
    }
    .histogram-bar:hover::after,
    .histogram-bar:focus-visible::after {
      opacity: 1;
    }
    @media (prefers-reduced-motion: no-preference) {
      .histogram-bar::after {
        transition: opacity 0.12s ease;
      }
    }

    .mosaic-col {
      overflow: hidden;
      mask-image: linear-gradient(to bottom, transparent, black 8%, black 92%, transparent);
      -webkit-mask-image: linear-gradient(to bottom, transparent, black 8%, black 92%, transparent);
    }
    .mosaic-col:nth-child(2) {
      margin-top: -3rem;
    }

    /* Edge fade on the horizontal thinker rail. */
    .rail {
      mask-image: linear-gradient(to right, transparent, black 1.5rem, black calc(100% - 1.5rem), transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, black 1.5rem, black calc(100% - 1.5rem), transparent);
    }
  </style>

  <script is:inline>
    // Progressive enhancement: only hide-and-reveal when JS is present.
    document.documentElement.classList.add("js-reveal");
    (function () {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const targets = document.querySelectorAll("[data-reveal]");
      if (!("IntersectionObserver" in window)) {
        targets.forEach((el) => el.classList.add("in-view"));
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in-view");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
      );
      targets.forEach((el) => io.observe(el));
    })();

    // Count-up on the stats band: each number runs 0 to its value once, the
    // first time the band is scrolled into view.
    (function () {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const cells = document.querySelectorAll("[data-countup]");
      if (!cells.length || !("IntersectionObserver" in window)) return;

      const format = (n) => n.toLocaleString("en-IN");
      const DURATION = 1100;

      function run(cell) {
        const target = Number(cell.getAttribute("data-countup"));
        if (!Number.isFinite(target) || target <= 0) return;
        // Hold the width the finished number needs, so counting cannot
        // reflow the row under the reader.
        cell.style.minWidth = cell.getBoundingClientRect().width + "px";
        const started = performance.now();
        function step(now) {
          const t = Math.min(1, (now - started) / DURATION);
          // Ease out cubic: quick off the mark, settling onto the real figure.
          const eased = 1 - Math.pow(1 - t, 3);
          cell.textContent = format(Math.round(target * eased));
          if (t < 1) requestAnimationFrame(step);
          else cell.textContent = format(target);
        }
        requestAnimationFrame(step);
      }

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            io.unobserve(e.target);
            run(e.target);
          }
        },
        { threshold: 0.5 },
      );
      cells.forEach((cell) => io.observe(cell));
    })();
  </script>
</BaseLayout>
