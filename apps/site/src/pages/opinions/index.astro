---
// Opinions index.
//
// On the featured images (CCS round-3 feedback, 7.2). The complaint is right:
// they were displaying badly. The stated cause is not. The old site used a 3:4
// portrait canvas, but the covers themselves are not portrait. All 59 were
// recovered from the Wayback Machine and they measure:
//
//   landscape 1.15 to 1.6 : 24      square : 8
//   wide, over 1.6        : 20      portrait, under 0.9 : 7
//
// from 192x306 (0.63) to 1024x329 (3.11). Putting that set behind a 3:4 box
// would crop the 44 landscape and wide covers far harder than the 21:10 and
// 16:10 boxes it replaced, so it would have made the thing CCS is looking at
// worse rather than better.
//
// The fault was never which ratio. It was that one fixed ratio plus
// object-cover cannot serve a set that ranges over five times in shape. So no
// cover is forced into a box any more: each keeps its own proportions, with
// its true pixel size on the tag so nothing shifts while the page loads.

import BaseLayout from "~/layouts/BaseLayout.astro";
import { collectionPageNode, breadcrumbNode } from "~/lib/schema";
import { ogSection } from "~/lib/og";
import { getCollection } from "astro:content";
import { inlineMd } from "~/lib/inline-md";
import { imageSize } from "~/lib/image-size";
import { EVENT_KIND } from "~/lib/events";
import { siteCopy, t } from "~/lib/site-copy";

const copy = await siteCopy("section-opinions");

// Events live at /events/ now, not here (CCS round-3 feedback, 7.3): the
// annual lecture, the essay contest and its results, the Vaad Vivad debate.
// Their pages are still at /opinions/<slug>/, which is why this filters the
// listing rather than the collection.
const opinions = (
  await getCollection(
    "opinions",
    (o) => !o.data.draft && o.data.language === "en" && o.data.kind !== EVENT_KIND,
  )
).sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));

// Facet vocabularies for the filter chips.
const themeCounts = new Map<string, number>();
const decadeCounts = new Map<number, number>();
const kindCounts = new Map<string, number>();
const placeCounts = new Map<string, number>();
const keyConceptCounts = new Map<string, number>();
for (const o of opinions) {
  for (const th of o.data.themes ?? []) themeCounts.set(th, (themeCounts.get(th) ?? 0) + 1);
  const y = new Date(o.data.pubDate).getFullYear();
  const dec = Math.floor(y / 10) * 10;
  decadeCounts.set(dec, (decadeCounts.get(dec) ?? 0) + 1);
  if (o.data.kind) kindCounts.set(o.data.kind, (kindCounts.get(o.data.kind) ?? 0) + 1);
  for (const p of o.data.geographic_scope?.places ?? []) {
    placeCounts.set(p, (placeCounts.get(p) ?? 0) + 1);
  }
  for (const c of o.data.key_concepts ?? []) {
    keyConceptCounts.set(c, (keyConceptCounts.get(c) ?? 0) + 1);
  }
}
// Drop bucket-label leftovers from themes facet (defensive - Step 0 should have already cleared them).
const BUCKET_DROP = new Set(["events", "opinions"]);
const themeOptions = [...themeCounts.entries()]
  .filter(([t]) => !BUCKET_DROP.has(t))
  .sort((a, b) => b[1] - a[1])
  .slice(0, 30);
const decadeOptions = [...decadeCounts.entries()].sort((a, b) => b[0] - a[0]);
const kindOptions = [...kindCounts.entries()].sort((a, b) => b[1] - a[1]);
const placeOptions = [...placeCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 30);
const keyConceptOptions = [...keyConceptCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 30);
---

<BaseLayout
  schema={[
    collectionPageNode({ pagePath: "/opinions/", name: "Opinions" }),
    breadcrumbNode([
      ["Home", "/"],
      ["Opinions", "/opinions/"],
    ]),
  ]}
  ogImage={ogSection("opinions")}
  title={t(copy, "title", "Opinions · Indian Liberals")}
  description={t(copy, "description", "First-party opinion pieces and commentary from the Indian liberal tradition.")}
>
  <section class="border-b border-(--color-border)">
    <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
      {/* "First-party opinion pieces" was a cataloguer's phrase, and CCS asked
          for the plain word (round-3 feedback, 7.1). The eyebrow went with it
          rather than repeat the heading immediately above itself. */}
      <h1 class="text-(--color-fg) mb-4">{t(copy, "heading", "Opinions")}</h1>
      <p class="text-(--color-fg-muted) leading-relaxed max-w-prose">
        {t(copy, "lede", "Contemporary commentary published on Indian Liberals: feature essays, reviews of historical episodes, and reflections on figures in the tradition.")}
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-6 py-12 md:grid md:grid-cols-[220px_1fr] md:gap-10">
    {/* Filter sidebar */}
    <aside
      class="
        font-(family-name:--font-ui) text-sm mb-8 md:mb-0
        md:sticky md:top-[5.5rem] md:self-start
        md:max-h-[calc(100vh-6rem)] md:overflow-y-auto md:pr-2
      "
      aria-label="Filter opinions"
    >
      {/* Sort, and filters behind a toggle on small screens (CCS round-3
          feedback, 11). On a phone the facet chips ran to several screens of
          scrolling before the first article, which is why the page felt
          unusable there. The panel ships expanded, so a reader without
          JavaScript loses nothing, and the rule that can hide it exists only
          below md: the desktop sidebar cannot be collapsed by any state the
          script gets into. */}
      <div class="mb-4 md:mb-5">
        <label for="o-sort" class="block text-[10px] uppercase tracking-wider text-(--color-fg-muted) mb-1.5">
          Sort
        </label>
        <select
          id="o-sort"
          class="w-full rounded-md border border-(--color-border) bg-(--color-bg) px-3 py-2 text-sm text-(--color-fg) font-(family-name:--font-ui)"
        >
          <option value="newest">Newest to oldest</option>
          <option value="oldest">Oldest to newest</option>
        </select>
      </div>

      <button
        type="button"
        id="o-filter-toggle"
        aria-expanded="true"
        aria-controls="o-filter-panel"
        class="md:hidden w-full flex items-center justify-between rounded-md border border-(--color-border) bg-(--color-bg) px-3 py-2 mb-4"
      >
        <span class="text-sm text-(--color-fg)">
          Filter <span id="o-active-count" class="text-(--color-fg-muted)"></span>
        </span>
        <span aria-hidden="true" class="o-caret text-(--color-fg-muted) transition-transform">&#9662;</span>
      </button>

      <div id="o-filter-panel">
        <div class="flex items-baseline justify-between gap-3 mb-3 pb-3 border-b border-(--color-border)">
          <h2 class="text-xs uppercase tracking-widest text-(--color-fg-muted)">Filter</h2>
          <button id="o-reset" type="button" class="text-[10px] uppercase tracking-wider text-(--color-saffron-700) font-semibold hover:text-(--color-fg) hidden">
            Reset
          </button>
        </div>
        <p class="text-xs text-(--color-fg-muted) mb-5">
          Showing <strong id="o-counter-visible" class="text-(--color-fg)">{opinions.length}</strong> of <strong>{opinions.length}</strong>
        </p>

      <div class="mb-5">
        <h3 class="text-[10px] uppercase tracking-wider text-(--color-fg-muted) mb-2">Decade</h3>
        <ul class="flex flex-wrap gap-1.5">
          {decadeOptions.map(([d, n]) => (
            <li>
              <button
                type="button"
                data-filter-decade={String(d)}
                class="o-chip px-2 py-1 bg-(--color-bg-muted) border border-(--color-border) rounded text-xs text-(--color-fg) hover:border-(--color-fg) transition-colors"
              >
                {d}s <span class="opacity-70">({n})</span>
              </button>
            </li>
          ))}
        </ul>
      </div>

      {kindOptions.length > 0 && (
        <div class="mb-5">
          <h3 class="text-[10px] uppercase tracking-wider text-(--color-fg-muted) mb-2">Kind</h3>
          <ul class="flex flex-wrap gap-1.5">
            {kindOptions.map(([k, n]) => (
              <li>
                <button
                  type="button"
                  data-filter-kind={k}
                  class="o-chip px-2 py-1 bg-(--color-bg-muted) border border-(--color-border) rounded text-xs text-(--color-fg) hover:border-(--color-fg) transition-colors"
                >
                  {k.replace(/-/g, " ")} <span class="opacity-70">({n})</span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      )}

      {placeOptions.length > 0 && (
        <details class="mb-5">
          <summary class="text-[10px] uppercase tracking-wider text-(--color-fg-muted) cursor-pointer select-none hover:text-(--color-fg) mb-2">Place ▾</summary>
          <ul class="flex flex-wrap gap-1.5">
            {placeOptions.map(([p, n]) => (
              <li>
                <button
                  type="button"
                  data-filter-place={p}
                  class="o-chip px-2 py-1 bg-(--color-bg-muted) border border-(--color-border) rounded text-xs text-(--color-fg) hover:border-(--color-fg) transition-colors"
                >
                  {p.replace(/-/g, " ")} <span class="opacity-70">({n})</span>
                </button>
              </li>
            ))}
          </ul>
        </details>
      )}

      {keyConceptOptions.length > 0 && (
        <details class="mb-5">
          <summary class="text-[10px] uppercase tracking-wider text-(--color-fg-muted) cursor-pointer select-none hover:text-(--color-fg) mb-2">Key concepts ▾</summary>
          <ul class="flex flex-wrap gap-1.5">
            {keyConceptOptions.map(([kc, n]) => (
              <li>
                <button
                  type="button"
                  data-filter-key-concept={kc}
                  class="o-chip px-2 py-1 bg-(--color-bg-muted) border border-(--color-border) rounded text-xs text-(--color-fg) hover:border-(--color-fg) transition-colors"
                >
                  {kc.replace(/-/g, " ")} <span class="opacity-70">({n})</span>
                </button>
              </li>
            ))}
          </ul>
        </details>
      )}

      {themeOptions.length > 0 && (
        <details class="mb-5" open>
          <summary class="text-[10px] uppercase tracking-wider text-(--color-fg-muted) cursor-pointer select-none hover:text-(--color-fg) mb-2">Themes ▾</summary>
          <ul class="flex flex-wrap gap-1.5">
            {themeOptions.map(([th, n]) => (
              <li>
                <button
                  type="button"
                  data-filter-theme={th}
                  class="o-chip px-2 py-1 bg-(--color-bg-muted) border border-(--color-border) rounded text-xs text-(--color-fg) hover:border-(--color-fg) transition-colors"
                >
                  {th.replace(/[_-]/g, " ")} <span class="opacity-70">({n})</span>
                </button>
              </li>
            ))}
          </ul>
        </details>
      )}
      </div>
    </aside>

    {/* Listing column — image-led magazine grid (restored from the legacy
        site's opinions-and-events cards, Adnan 2026-07). The newest piece
        reads as a full-width lead; the rest sit in a two-column card grid.
        Every card keeps the .o-item data attributes so the filter script
        works unchanged — filtering the lead away simply reflows the grid. */}
    <div class="min-w-0">
      <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2" id="o-list">
        {opinions.map((o, idx) => {
          const y = new Date(o.data.pubDate).getFullYear();
          const dec = Math.floor(y / 10) * 10;
          const lead = idx === 0;
          const byline =
            o.data.author_name &&
            o.data.author_name !== "Editorial Team" &&
            o.data.author_name !== "CCS Editorial Team"
              ? o.data.author_name
              : null;
          return (
            <li
              class={`o-item ${lead ? "sm:col-span-2" : ""}`}
              data-date={o.data.pubDate}
              data-decade={String(dec)}
              data-themes={(o.data.themes ?? []).join(" ")}
              data-kind={o.data.kind ?? ""}
              data-places={(o.data.geographic_scope?.places ?? []).join(" ")}
              data-key-concepts={(o.data.key_concepts ?? []).join(" ")}
            >
              <a href={`/opinions/${o.id}/`} class="block no-underline group h-full">
                {o.data.hero_image && (() => {
                  // Each cover keeps its own shape. See the note at the top of
                  // this file: these images are not one canvas, and a single
                  // aspect box was cropping most of them. The real width and
                  // height go on the tag so the browser reserves the right
                  // space and nothing reflows as the page loads. The max
                  // heights are a guard for the few very tall covers, not a
                  // crop applied to everything: an image shorter than the cap
                  // is never cut at all.
                  const dim = imageSize(o.data.hero_image);
                  return (
                    <div class="overflow-hidden rounded-sm border border-(--color-border) bg-(--color-bg-muted) mb-4 transition-shadow group-hover:shadow-md">
                      <img
                        src={o.data.hero_image}
                        alt=""
                        width={dim?.width ?? (lead ? 1024 : 640)}
                        height={dim?.height ?? (lead ? 488 : 400)}
                        loading={lead ? "eager" : "lazy"}
                        decoding="async"
                        class={`w-full h-auto object-cover object-top group-hover:scale-[1.02] transition-transform duration-300 ${lead ? "max-h-[26rem]" : "max-h-[30rem]"}`}
                      />
                    </div>
                  );
                })()}
                <p class="text-xs text-(--color-fg-muted) font-(family-name:--font-ui) mb-1">
                  {new Date(o.data.pubDate).toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" })}
                  {byline && (<><span> · </span>{byline}</>)}
                </p>
                <h2
                  data-o-title
                  class={`font-(family-name:--font-display) text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors leading-snug ${lead ? "text-2xl md:text-3xl max-w-2xl" : "text-xl"}`}
                >
                  {o.data.title}
                </h2>
                {o.data.pull_quote && (
                  <p
                    class={`text-sm text-(--color-fg-muted) italic mt-2 ${lead ? "line-clamp-2 max-w-2xl" : "line-clamp-2"}`}
                    set:html={`&ldquo;${inlineMd(o.data.pull_quote)}&rdquo;`}
                  />
                )}
              </a>
            </li>
          );
        })}
      </ul>
      <p id="o-empty" class="hidden text-center py-12 text-(--color-fg-muted) font-(family-name:--font-ui)">
        {t(copy, "empty_state", "No opinions match the current filter. Try removing some criteria.")}
      </p>
    </div>
  </div>

  <style>
    /* The filter disclosure is a phone affordance only. Above md the summary
       is gone and the panel is always open, so the sidebar behaves exactly as
       it did. */
    /* The collapse rule exists only below md. Above it there is no rule that
       can hide the panel, so the desktop sidebar cannot be broken by whatever
       state the script ends up in: a first attempt used <details> and relied on
       a script to re-open it, and a browser resized narrow and back left the
       filters closed with their summary hidden, which is unreachable. */
    @media (max-width: 767px) {
      #o-filter-panel[data-collapsed="true"] { display: none; }
    }
    #o-filter-toggle[aria-expanded="true"] .o-caret { transform: rotate(180deg); }
  </style>

  <script is:inline>
    (function () {
      const state = {
        decade: new Set(),
        theme: new Set(),
        kind: new Set(),
        place: new Set(),
        keyConcept: new Set(),
      };
      const items = Array.from(document.querySelectorAll('.o-item'));
      const listEl = document.getElementById('o-list');
      const sortEl = document.getElementById('o-sort');
      const panelEl = document.getElementById('o-filter-panel');
      const toggleEl = document.getElementById('o-filter-toggle');
      const activeCountEl = document.getElementById('o-active-count');
      const LEAD_H2 = ['text-2xl', 'md:text-3xl', 'max-w-2xl'];

      // Collapse the filters on a phone. Open in the markup so that without
      // JavaScript nothing is hidden; only narrow viewports get the collapse.
      const narrow = window.matchMedia('(max-width: 767px)');
      function setCollapsed(collapsed) {
        if (!panelEl || !toggleEl) return;
        if (collapsed) panelEl.setAttribute('data-collapsed', 'true');
        else panelEl.removeAttribute('data-collapsed');
        toggleEl.setAttribute('aria-expanded', String(!collapsed));
      }
      setCollapsed(narrow.matches);
      narrow.addEventListener('change', (e) => setCollapsed(e.matches));
      if (toggleEl) {
        toggleEl.addEventListener('click', () =>
          setCollapsed(!panelEl.hasAttribute('data-collapsed')),
        );
      }

      /* The lead treatment belongs to whatever is first, not to whichever
         article was newest when the page was built. Re-apply it after any
         sort or filter so the top of the list always reads as the lead. */
      function applyLead() {
        let first = true;
        for (const li of items) {
          const isLead = first && li.style.display !== 'none';
          if (isLead) first = false;
          li.classList.toggle('sm:col-span-2', isLead);
          const h2 = li.querySelector('[data-o-title]');
          if (!h2) continue;
          h2.classList.toggle('text-xl', !isLead);
          LEAD_H2.forEach((c) => h2.classList.toggle(c, isLead));
        }
      }

      function applySort() {
        if (!listEl || !sortEl) return;
        const dir = sortEl.value === 'oldest' ? 1 : -1;
        items
          .slice()
          .sort((a, b) => dir * (Date.parse(a.dataset.date || '') - Date.parse(b.dataset.date || '')))
          .forEach((li) => listEl.appendChild(li));
        // `items` keeps build order; re-read so applyLead walks the DOM order.
        items.length = 0;
        items.push.apply(items, Array.from(listEl.querySelectorAll('.o-item')));
        applyLead();
      }
      if (sortEl) sortEl.addEventListener('change', applySort);
      const totalEl = document.getElementById('o-counter-visible');
      const resetBtn = document.getElementById('o-reset');
      const emptyEl = document.getElementById('o-empty');
      const ACTIVE = ['bg-(--color-saffron-500)', 'text-white', 'border-(--color-saffron-500)'];
      const IDLE = ['bg-(--color-bg)', 'text-(--color-fg)', 'border-(--color-border)'];

      const FACET_KEYS = {
        decade: 'decade',
        theme: 'themes',
        kind: 'kind',
        place: 'places',
        keyConcept: 'keyConcepts',
      };

      function applyFilters() {
        let visible = 0;
        for (const li of items) {
          let show = true;
          for (const [facet, set] of Object.entries(state)) {
            if (set.size === 0) continue;
            const dsKey = FACET_KEYS[facet];
            const raw = li.dataset[dsKey] || '';
            const isList = ['themes', 'places', 'keyConcepts'].includes(dsKey);
            if (isList) {
              const parts = raw.split(/\s+/).filter(Boolean);
              if (!parts.some((p) => set.has(p))) { show = false; break; }
            } else {
              if (!set.has(raw)) { show = false; break; }
            }
          }
          li.style.display = show ? '' : 'none';
          if (show) visible++;
        }
        if (totalEl) totalEl.textContent = String(visible);
        if (emptyEl) emptyEl.classList.toggle('hidden', visible !== 0);
        const chosen = Object.values(state).reduce((n, s) => n + s.size, 0);
        if (resetBtn) resetBtn.classList.toggle('hidden', chosen === 0);
        // With the panel shut on a phone, the summary is the only place a
        // reader can see that a filter is on at all.
        if (activeCountEl) activeCountEl.textContent = chosen ? `(${chosen})` : '';
        applyLead();
        syncURL();
      }

      function toggle(btn, facet, value) {
        const set = state[facet];
        if (set.has(value)) {
          set.delete(value);
          IDLE.forEach((c) => btn.classList.add(c));
          ACTIVE.forEach((c) => btn.classList.remove(c));
        } else {
          set.add(value);
          ACTIVE.forEach((c) => btn.classList.add(c));
          IDLE.forEach((c) => btn.classList.remove(c));
        }
        applyFilters();
      }

      // URL param namespace: ?theme=, ?kind=, ?place=, ?key_concept=, ?decade=
      const URL_KEYS = {
        theme: 'theme',
        kind: 'kind',
        place: 'place',
        keyConcept: 'key_concept',
        decade: 'decade',
      };

      function parseInitialParamsFromURL() {
        const usp = new URLSearchParams(window.location.search);
        for (const [facet, paramName] of Object.entries(URL_KEYS)) {
          const v = usp.get(paramName);
          if (!v) continue;
          for (const piece of v.split(',').map((s) => s.trim()).filter(Boolean)) {
            state[facet].add(piece);
          }
        }
        // Apply ACTIVE styling to matching chips
        document.querySelectorAll('.o-chip').forEach((btn) => {
          let activated = false;
          for (const [facet, attr] of Object.entries({
            kind: 'filterKind', decade: 'filterDecade', theme: 'filterTheme',
            place: 'filterPlace', keyConcept: 'filterKeyConcept',
          })) {
            const v = btn.dataset[attr];
            if (v && state[facet].has(v)) {
              activated = true;
              break;
            }
          }
          if (activated) {
            ACTIVE.forEach((c) => btn.classList.add(c));
            IDLE.forEach((c) => btn.classList.remove(c));
          }
        });
      }

      function syncURL() {
        const usp = new URLSearchParams();
        for (const [facet, paramName] of Object.entries(URL_KEYS)) {
          const set = state[facet];
          if (set.size > 0) usp.set(paramName, [...set].join(','));
        }
        const qs = usp.toString();
        const newURL = window.location.pathname + (qs ? '?' + qs : '');
        window.history.replaceState(null, '', newURL);
      }

      document.querySelectorAll('.o-chip').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (btn.dataset.filterDecade) toggle(btn, 'decade', btn.dataset.filterDecade);
          else if (btn.dataset.filterTheme) toggle(btn, 'theme', btn.dataset.filterTheme);
          else if (btn.dataset.filterKind) toggle(btn, 'kind', btn.dataset.filterKind);
          else if (btn.dataset.filterPlace) toggle(btn, 'place', btn.dataset.filterPlace);
          else if (btn.dataset.filterKeyConcept) toggle(btn, 'keyConcept', btn.dataset.filterKeyConcept);
        });
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          for (const s of Object.values(state)) s.clear();
          document.querySelectorAll('.o-chip').forEach((btn) => {
            ACTIVE.forEach((c) => btn.classList.remove(c));
            IDLE.forEach((c) => btn.classList.add(c));
          });
          applyFilters();
        });
      }

      parseInitialParamsFromURL();
      applyFilters();
    })();
  </script>
</BaseLayout>
