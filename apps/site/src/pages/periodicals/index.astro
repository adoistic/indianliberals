---
// Series & Periodicals — the single index of every named run in the archive.
//
// This used to be two surfaces: /periodicals/ for dated magazine issues and
// /series/ for the non-periodical runs (the Forum of Free Enterprise booklets,
// the annual budget analyses, the memorial lectures). That split asked a reader
// to know, before clicking, whether the Forum's booklets counted as a
// "periodical" — a distinction that matters to a cataloguer and to nobody else.
// Both now live here under one heading, still grouped so the difference stays
// visible where it is actually useful.
//
// Detail pages keep their existing URLs (/periodicals/<id>/ and /series/<id>/)
// so nothing already linked breaks; /series/ redirects here.

import BaseLayout from "~/layouts/BaseLayout.astro";
import { collectionPageNode, breadcrumbNode } from "~/lib/schema";
import { ogSection } from "~/lib/og";
import { getPeriodicalSeries } from "~/lib/periodicals";
import { getSeries, getPeriodicalAttachments, KIND_LABEL, countAll } from "~/lib/series";
import RunCard from "~/components/RunCard.astro";
import { siteCopy, t, fmt } from "~/lib/site-copy";

const copy = await siteCopy("section-periodicals");

const periodicalGroups = await getPeriodicalSeries();
const seriesGroups = await getSeries();

// Runs that hang off a magazine are not listed here, but they are still in the
// archive and still runs. Counting only what this page lists would make moving
// a run under its magazine look like works had gone missing.
const attachedGroups = await getPeriodicalAttachments();

const issueCount = periodicalGroups.reduce((n, g) => n + g.total, 0);
const seriesWorkCount = seriesGroups.reduce((n, g) => n + countAll(g), 0);
const attachedWorkCount = attachedGroups.reduce((n, g) => n + countAll(g), 0);
const runCount = periodicalGroups.length + seriesGroups.length + attachedGroups.length;
const totalWorks = issueCount + seriesWorkCount + attachedWorkCount;
---

<BaseLayout
  schema={[
    collectionPageNode({ pagePath: "/periodicals/", name: "Periodicals" }),
    breadcrumbNode([
      ["Home", "/"],
      ["Periodicals", "/periodicals/"],
    ]),
  ]}
  ogImage={ogSection("periodicals")}
  title={t(copy, "title", "Periodicals · Indian Liberals")}
  description={fmt(
    t(copy, "description", "{works} works across {runs} runs: the Forum of Free Enterprise booklets, the Swatantra Party pamphlets, the Indian Liberal Group papers, CCS Publications, Freedom First, The Indian Libertarian, Khoj and Shetkari Sanghatak, indexed item by item."),
    { works: totalWorks, runs: runCount },
  )}
>
  <section class="border-b border-(--color-border)">
    <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
      {/* CCS asked for the section to be called Periodicals and for "The runs"
          to go (round-3 feedback, 3.1 and 3.2). The eyebrow went with it: with
          the heading now carrying the plain section name, a label above it
          saying the same word twice is just decoration. */}
      <h1 class="text-(--color-fg) mb-4">{t(copy, "heading", "Periodicals")}</h1>
      <p class="text-(--color-fg-muted) leading-relaxed max-w-prose">
        {t(copy, "lede", "Most of this archive was not published as one-off books. It came out in runs: a fortnightly journal, a booklet series that lasted fifty years, a budget analysis every spring, a memorial lecture every autumn. Read in sequence they show an argument being made and remade over decades. Choose a run to browse it; every item links its original PDF.")}
      </p>
      <p class="text-(--color-fg-muted) text-sm mt-4 font-(family-name:--font-ui)">
        {totalWorks} works · {runCount} runs
      </p>
    </div>
  </section>

  {/* Non-periodical runs lead: the Forum booklets are the single largest body
      of work in the archive, and listing them under the magazines would
      misrepresent the shape of the collection. The heading covers party
      pamphlets and think-tank papers as well as booklets and lectures, so it
      names the material rather than trying to list every shape of it.

      Both sections below draw the same card (RunCard) in the same grid. They
      used to differ, full-width rows here and a three-column grid under the
      magazines, and CCS asked for one canvas so the page reads as one
      surface (September 2026). */}
  <div class="mx-auto max-w-6xl px-6 pt-12">
    <h2 class="font-(family-name:--font-display) font-semibold text-xl text-(--color-fg) mb-1">
      Booklets, papers and lectures
    </h2>
    <p class="text-(--color-fg-muted) text-sm mb-6 font-(family-name:--font-ui)">
      {seriesWorkCount} works · {seriesGroups.length} runs
    </p>
  </div>

  {/* One card per run, and the sub-runs stay inside the run they belong to.
      CCS, round 4: "the Forum of Free Enterprise pieces are currently divided
      into several categories. We would like all Forum pieces to be consolidated
      under Forum of Free Enterprise only." They were: the Forum showed as one
      card plus five more for the Shroff and Palkhivala lectures, the Union
      Budget and the Builders portraits, which read as five separate
      publishers. Those runs still exist and still have their own pages; they
      are now reached through the Forum's page rather than competing with it
      here. The card says how many sub-series are inside, so nothing is
      hidden. */}
  <div class="mx-auto max-w-6xl px-6">
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 font-(family-name:--font-ui)">
      {seriesGroups.map((g) => {
        const n = countAll(g);
        const meta = [
          `${n} ${n === 1 ? "work" : "works"}`,
          g.yearRange,
          g.children.length > 0 && `${g.children.length} sub-series`,
        ]
          .filter(Boolean)
          .join(" · ");
        return (
          <li>
            <RunCard
              href={`/series/${g.entry.id}/`}
              cover={g.cover}
              badge={KIND_LABEL[g.entry.data.kind]}
              name={g.entry.data.name}
              native={g.entry.data.native}
              meta={meta}
              blurb={g.entry.data.blurb}
              cta="Browse works"
            />
          </li>
        );
      })}
    </ul>
  </div>

  {/* Named "Periodicals" until the page itself took that name. A page headed
      Periodicals containing a section headed Periodicals tells a reader
      nothing, so this group is now called what it actually holds: the dated
      magazines and journals, as against the booklet series above. */}
  <div class="mx-auto max-w-6xl px-6 pt-14">
    <h2 class="font-(family-name:--font-display) font-semibold text-xl text-(--color-fg) mb-1">
      Magazines &amp; journals
    </h2>
    <p class="text-(--color-fg-muted) text-sm mb-6 font-(family-name:--font-ui)">
      {issueCount} issues · {periodicalGroups.length} runs, indexed issue by issue
    </p>
  </div>

  <div class="mx-auto max-w-6xl px-6 pb-14">
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 font-(family-name:--font-ui)">
      {periodicalGroups.map((g) => (
        <li>
          <RunCard
            href={`/periodicals/${g.id}/`}
            cover={g.cover}
            badge={g.meta.kind}
            name={g.meta.name}
            native={g.meta.native}
            meta={[g.total === 1 ? "1 issue" : `${g.total} issues`, g.yearRange]
              .filter(Boolean)
              .join(" · ")}
            blurb={g.meta.blurb}
            cta="Browse issues"
          />
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
