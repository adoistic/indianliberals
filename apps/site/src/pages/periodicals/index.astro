---
// Periodicals index, series-first (CCS round-2 feedback #10).
//
// The landing view is a grid of the periodical *runs* (one card per series:
// cover + name + issue count + span), not a flat wall of every issue. Clicking
// a card opens that run's issues at /periodicals/<series>/. Grouping logic and
// series metadata live in ~/lib/periodicals.ts (shared with the per-series
// page).

import BaseLayout from "~/layouts/BaseLayout.astro";
import { getPeriodicalSeries } from "~/lib/periodicals";

const seriesGroups = await getPeriodicalSeries();
const namedSeries = seriesGroups.filter((g) => g.id !== "other");
const totalIssues = seriesGroups.reduce((n, g) => n + g.items.length, 0);
---

<BaseLayout
  title="Periodicals · Indian Liberals"
  description={`${totalIssues} periodical issues across ${namedSeries.length} runs: The Indian Libertarian, Khoj, Shetkari Sanghatak, Freedom First, and more, indexed at the issue level with metadata and AI summaries.`}
>
  <section class="border-b border-(--color-border)">
    <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
      <p class="text-xs uppercase tracking-widest text-(--color-saffron-700) font-(family-name:--font-ui) font-semibold mb-3">
        Periodicals
      </p>
      <h1 class="text-(--color-fg) mb-4">The periodical runs</h1>
      <p class="text-(--color-fg-muted) leading-relaxed max-w-prose">
        The liberal periodicals of modern India, indexed issue by issue with
        metadata, contributor lists, and AI summaries. Choose a run to browse
        its issues; each issue page links the original PDF.
      </p>
      <p class="text-(--color-fg-muted) text-sm mt-4 font-(family-name:--font-ui)">
        {totalIssues} issues · {namedSeries.length} runs
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-6 py-12">
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 font-(family-name:--font-ui)">
      {seriesGroups.map((g) => (
        <li>
          <a
            href={`/periodicals/${g.id}/`}
            class="flex gap-4 h-full p-4 bg-(--color-bg) border border-(--color-border) rounded-lg no-underline hover:border-(--color-fg) hover:shadow-md hover:-translate-y-0.5 transition-all group"
          >
            <div class="self-start shrink-0 w-20 md:w-24 aspect-[3/4] rounded-sm overflow-hidden border border-(--color-border) bg-(--color-bg-muted) flex items-center justify-center">
              {g.cover ? (
                <img
                  src={g.cover}
                  alt=""
                  width="120"
                  height="160"
                  loading="lazy"
                  class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-300"
                />
              ) : (
                <span class="font-(family-name:--font-display) text-2xl text-(--color-fg-muted) px-2 text-center leading-tight">
                  {g.meta.name.split(" ").slice(0, 2).map((s) => s[0]).join("")}
                </span>
              )}
            </div>
            <div class="min-w-0 flex flex-col">
              <h2 class="font-(family-name:--font-display) font-semibold text-lg text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors leading-tight">
                {g.meta.name}
                {g.meta.native && g.meta.native !== g.meta.name && (
                  <span class="text-(--color-fg-muted) font-normal text-sm ml-1.5">{g.meta.native}</span>
                )}
              </h2>
              <p class="text-xs text-(--color-fg-muted) mt-1 mb-2">
                {g.items.length === 1 ? "1 issue" : `${g.items.length} issues`}
                {g.yearRange && ` · ${g.yearRange}`}
              </p>
              <p class="text-sm text-(--color-fg-muted) leading-snug line-clamp-3">
                {g.meta.blurb}
              </p>
              <span class="mt-auto pt-2 text-xs font-semibold text-(--color-forest-700) group-hover:text-(--color-fg) transition-colors">
                Browse issues <span aria-hidden>→</span>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
