---
import { n, siteCopy, t } from "~/lib/site-copy";

const year = new Date().getFullYear();

// Sitewide identity + navigation copy (site collection). Every string keeps
// its original wording as the inline fallback.
const identity = await siteCopy("identity");
const nav = await siteCopy("navigation");

const footerBlurb = t(
  identity,
  "footer_blurb",
  "An online archive of the Indian liberal tradition. Primary works, thinker profiles, organisations, opinions, interviews, and curated excerpts from the figures who built the case for liberty in modern India.",
);
const orgName = t(identity, "org_name", "Centre for Civil Society");
const orgUrl = t(identity, "org_url", "https://ccs.in");
const orgUrlLabel = orgUrl.replace(/^https?:\/\//, "").replace(/\/$/, "");
const builderName = t(identity, "builder_name", "Thothica");
const builderUrl = t(identity, "builder_url", "https://thothica.com");
const copyrightStart = n(identity, "copyright_start", 2009);

const builtinFooterLinks = [
  { label: "Terms of use", href: "/terms-of-use/" },
  { label: "Privacy policy", href: "/privacy-policy/" },
  { label: "/llms.txt", href: "/llms.txt" },
  { label: "/AGENTS.md", href: "/AGENTS.md" },
];
const seedFooterLinks = nav.footer_links as { label: string; href: string }[] | undefined;
const footerLinks =
  seedFooterLinks && seedFooterLinks.length ? seedFooterLinks : builtinFooterLinks;
---

<footer class="border-t border-(--color-border) mt-20 bg-(--color-bg-muted)">
  <div class="mx-auto max-w-6xl px-6 py-12 grid gap-8 md:grid-cols-[2fr_1fr] text-sm font-(family-name:--font-ui)">
    <div>
      <div class="flex items-center gap-3 mb-3">
        <img src="/brand/brand-mark-crane.png" alt="" class="h-7 w-7" width="28" height="28" />
        <span class="font-(family-name:--font-display) font-semibold text-(--color-fg)">Indian Liberals</span>
      </div>
      <p class="text-(--color-fg-muted) leading-relaxed">
        {footerBlurb}
      </p>
    </div>
    <div>
      <h2 class="font-(family-name:--font-ui) text-xs uppercase tracking-widest text-(--color-fg-muted) mb-3">Maintained by</h2>
      <p class="text-(--color-fg) font-medium mb-1">{orgName}</p>
      <a href={orgUrl} class="text-(--color-fg-muted) hover:text-(--color-fg)">{orgUrlLabel}</a>
      <p class="text-(--color-fg-muted) text-xs leading-relaxed mt-3">
        Site rebuilt by <a href={builderUrl} class="text-(--color-fg-muted) hover:text-(--color-fg)">{builderName}</a>.
      </p>
    </div>
  </div>
  <div class="border-t border-(--color-border)">
    <div class="mx-auto max-w-6xl px-6 py-4 flex flex-col md:flex-row items-center justify-between gap-2 text-xs text-(--color-fg-muted) font-(family-name:--font-ui)">
      <p>© {copyrightStart}–<span id="copyright-year" data-build-year={year}>{year}</span> {orgName}. All rights reserved.</p>
      <nav aria-label="Footer">
        <ul class="flex items-center gap-4">
          {footerLinks.map((l) => (
            <li><a href={l.href} class="hover:text-(--color-fg)">{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>

<script is:inline>
  // Keep the copyright year current even if the static site hasn't been
  // rebuilt this year. Server-render is the build-time year; this updates
  // the visible year to the viewer's current calendar year on every page
  // load. AI agents and no-JS readers still see a valid (build-time) year.
  (function () {
    var el = document.getElementById("copyright-year");
    if (!el) return;
    var now = new Date().getFullYear();
    if (String(now) !== el.textContent) el.textContent = String(now);
  })();
</script>
