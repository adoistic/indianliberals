---
import { n, siteCopy, t } from "~/lib/site-copy";

// The footer is the one place the whole archive is laid out at once. The
// header keeps its map behind disclosure menus; here the four sections and
// their pages stand in plain columns, beside the archive's own words and its
// note for machine readers. Below that, a quiet institutional strip carries
// the two marks inline with their credits, and a colophon closes the page.
// The tricolour hairline the header opens with is repeated at the top, so
// the page is bookended by it.

const year = new Date().getFullYear();

// Sitewide identity + navigation copy (site collection). Every string keeps
// its original wording as the inline fallback.
const identity = await siteCopy("identity");
const nav = await siteCopy("navigation");

const footerBlurb = t(
  identity,
  "footer_blurb",
  "An online archive of the Indian liberal tradition. Primary works, thinker profiles, organisations, opinions, interviews, and curated excerpts from the figures who built the case for liberty in modern India.",
);
const orgName = t(identity, "org_name", "Centre for Civil Society");
const orgUrl = t(identity, "org_url", "https://ccs.in");
const builderName = t(identity, "builder_name", "Thothica");
const builderUrl = t(identity, "builder_url", "https://thothica.com");
// "Site rebuilt by" undersold it: the ontology beneath the archive (the
// collections, the authority files, the agent layer) is Thothica's work as
// much as the site is (Adnan, 2026-09-17).
const builderCredit = t(identity, "builder_credit", "Ontology built by and site rebuilt by");
// The two institutions appear as their marks, each a link, each named for a
// screen reader by its alt text (the names are in the marks themselves, so
// they are not repeated as type). Both can be swapped from the CMS.
const orgLogo = t(identity, "org_logo", "/brand/ccs-logo.svg");
const builderLogo = t(identity, "builder_logo", "/brand/thothica-logo-black.png");
const copyrightStart = n(identity, "copyright_start", 2009);

// The sitemap: the same groups the header menu shows, from the navigation
// copy when an editor has written it, else the built-in map. Counts are the
// header's business; the footer only names the pages.
type FooterItem = { label: string; href: string };
type FooterGroup = { label: string; items: FooterItem[] };
const builtinGroups: FooterGroup[] = [
  {
    label: "Collections",
    items: [
      { label: "Primary works", href: "/primary-works/" },
      { label: "Periodicals", href: "/periodicals/" },
      { label: "Oral history", href: "/interviews/" },
      { label: "Lectures", href: "/lectures/" },
      { label: "Musings", href: "/musings/" },
      { label: "Languages", href: "/languages/" },
      { label: "Full-text search", href: "/search/" },
    ],
  },
  { label: "People", items: [{ label: "Thinkers", href: "/thinkers/" }] },
  {
    label: "Commentary",
    items: [
      { label: "Opinions", href: "/opinions/" },
      { label: "From ThePrint", href: "/theprint-mirror/" },
    ],
  },
  {
    label: "About",
    items: [
      { label: "About Us", href: "/about/" },
      { label: "Gallery", href: "/gallery/" },
      { label: "Events", href: "/events/" },
      { label: "Testimonials", href: "/testimonials/" },
      { label: "Contact Us", href: "/contact/" },
    ],
  },
];
const seedGroups = nav.groups as FooterGroup[] | undefined;
const groups: FooterGroup[] =
  seedGroups && seedGroups.length
    ? seedGroups.map((g) => ({ label: g.label, items: (g.items ?? []).map((i) => ({ label: i.label, href: i.href })) }))
    : builtinGroups;

const builtinFooterLinks = [
  { label: "Terms of use", href: "/terms-of-use/" },
  { label: "Privacy policy", href: "/privacy-policy/" },
  { label: "/llms.txt", href: "/llms.txt" },
  { label: "/AGENTS.md", href: "/AGENTS.md" },
];
const seedFooterLinks = nav.footer_links as { label: string; href: string }[] | undefined;
const footerLinks =
  seedFooterLinks && seedFooterLinks.length ? seedFooterLinks : builtinFooterLinks;
---

<footer class="mt-20 font-(family-name:--font-ui)">
  {/* Bookend: the hairline the header opens with. */}
  <span class="block h-[3px] bg-gradient-to-r from-(--color-saffron-500) via-(--color-bg-muted) to-(--color-forest-500)" aria-hidden="true"></span>

  {/* The archive and its map. */}
  <div class="bg-(--color-bg-muted)">
    <div class="mx-auto max-w-6xl px-6 pt-14 pb-12 grid gap-12 lg:grid-cols-[1.15fr_2fr] lg:gap-20">
      <div>
        <a href="/" class="inline-flex items-center gap-3 no-underline">
          <img src="/brand/brand-mark-crane.png" alt="" class="h-8 w-8" width="32" height="32" />
          <span class="font-(family-name:--font-display) font-semibold text-lg tracking-tight text-(--color-fg)">Indian Liberals</span>
        </a>
        <p class="mt-4 text-sm text-(--color-fg-muted) leading-relaxed max-w-sm">
          {footerBlurb}
        </p>
        <p class="mt-5 text-xs text-(--color-fg-muted) leading-relaxed max-w-sm">
          Every page has a <code class="font-(family-name:--font-mono) bg-(--color-bg) px-1 py-0.5 rounded border border-(--color-border)">.md</code> sibling for machine readers, and the archive is indexed at
          <a href="/llms.txt" class="text-(--color-forest-700) hover:text-(--color-fg)">/llms.txt</a>.
        </p>
      </div>

      {/* The `!` modifiers: the site's global h2 rule sits outside Tailwind's
          layers and would otherwise turn these labels into display headings. */}
      <nav aria-label="Site map" class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-4">
        {groups.map((g) => (
          <div>
            <h2 class="font-(family-name:--font-ui)! text-xs! font-semibold uppercase tracking-widest! text-(--color-saffron-700)! mb-3.5">
              {g.label}
            </h2>
            <ul class="grid gap-2">
              {g.items.map((item) => (
                <li>
                  <a href={item.href} class="text-sm text-(--color-fg-muted) hover:text-(--color-fg) transition-colors">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
  </div>

  {/* The institutions: each credit inline with its mark, on one line. */}
  <div class="bg-(--color-bg) border-t border-(--color-border)">
    <div class="mx-auto max-w-6xl px-6 py-7 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-5">
        <span class="text-[11px] font-semibold uppercase tracking-widest text-(--color-fg-muted) shrink-0">Maintained by</span>
        <a href={orgUrl} class="footer-mark inline-block rounded-sm" title={orgName}>
          <img src={orgLogo} alt={orgName} class="h-11 w-auto" height="44" width="99" loading="lazy" decoding="async" />
        </a>
      </div>
      <div class="flex items-center gap-5">
        <span class="text-[11px] font-semibold uppercase tracking-widest text-(--color-fg-muted) shrink-0">{builderCredit}</span>
        <a href={builderUrl} class="footer-mark inline-block rounded-sm" title={builderName}>
          <img src={builderLogo} alt={builderName} class="h-7 w-auto" height="28" width="97" loading="lazy" decoding="async" />
        </a>
      </div>
    </div>
  </div>

  {/* Colophon. */}
  <div class="bg-(--color-bg-muted) border-t border-(--color-border)">
    <div class="mx-auto max-w-6xl px-6 py-4 flex flex-col md:flex-row items-center justify-between gap-2 text-xs text-(--color-fg-muted)">
      <p>© {copyrightStart}–<span id="copyright-year" data-build-year={year}>{year}</span> {orgName}. All rights reserved.</p>
      <nav aria-label="Footer">
        <ul class="flex items-center gap-4">
          {footerLinks.map((l) => (
            <li><a href={l.href} class="hover:text-(--color-fg)">{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer-mark img {
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .footer-mark:hover img {
    opacity: 0.82;
  }
  @media (prefers-reduced-motion: no-preference) {
    .footer-mark:hover img {
      transform: translateY(-1px);
    }
  }
</style>

<script is:inline>
  // Keep the copyright year current even if the static site hasn't been
  // rebuilt this year. Server-render is the build-time year; this updates
  // the visible year to the viewer's current calendar year on every page
  // load. AI agents and no-JS readers still see a valid (build-time) year.
  (function () {
    var el = document.getElementById("copyright-year");
    if (!el) return;
    var now = new Date().getFullYear();
    if (String(now) !== el.textContent) el.textContent = String(now);
  })();
</script>
