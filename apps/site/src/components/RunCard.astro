---
// One card for one run, whatever kind of run it is.
//
// The periodicals index used to draw its two kinds of run differently: the
// booklet series as full-width rows, the magazines as a three-column grid of
// cards. CCS asked for the two sections to share one layout so the page reads
// as one surface (September 2026). This is that layout. Both sections pass
// the same props and get the same card, so they cannot drift apart again.

interface Props {
  href: string;
  /** Cover image, when a work in the run has one. */
  cover: string | null;
  /** The small label above the name: "Booklet series", "Fortnightly". */
  badge?: string;
  name: string;
  /** The run's own name in its own script, shown after the name. */
  native?: string;
  /** "618 works · 1956–2019 · 5 sub-series", already assembled. */
  meta: string;
  blurb: string;
  /** "Browse works", "Browse issues". The arrow is added here. */
  cta: string;
}

const { href, cover, badge, name, native, meta, blurb, cta } = Astro.props;
const initials = name
  .split(" ")
  .filter((s) => /[A-Za-z]/.test(s))
  .slice(0, 2)
  .map((s) => s[0])
  .join("");
---

<a
  href={href}
  class="flex gap-4 h-full p-4 bg-(--color-bg) border border-(--color-border) rounded-lg no-underline hover:border-(--color-fg) hover:shadow-md hover:-translate-y-0.5 transition-all group"
>
  <div class="self-start shrink-0 w-20 md:w-24 aspect-[3/4] rounded-sm overflow-hidden border border-(--color-border) bg-(--color-bg-muted) flex items-center justify-center">
    {cover ? (
      <img
        src={cover}
        alt=""
        width="120"
        height="160"
        loading="lazy"
        class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-300"
      />
    ) : (
      <span class="font-(family-name:--font-display) text-2xl text-(--color-fg-muted) px-2 text-center leading-tight">
        {initials}
      </span>
    )}
  </div>
  <div class="min-w-0 flex flex-col">
    {badge && (
      <span class="self-start inline-block px-1.5 py-0.5 rounded text-[10px] uppercase tracking-wider font-semibold bg-(--color-saffron-100) text-(--color-saffron-700) mb-1.5">
        {badge}
      </span>
    )}
    {/* break-words: a run title with no space in it ("Shetkari Sanghatak")
        is wider than the card at 280px and spilled past the viewport. */}
    <h3 class="font-(family-name:--font-display) font-semibold text-lg text-(--color-fg) group-hover:text-(--color-saffron-700) transition-colors leading-tight break-words">
      {name}
      {native && native !== name && (
        <span class="text-(--color-fg-muted) font-normal text-sm ml-1.5">{native}</span>
      )}
    </h3>
    <p class="text-xs text-(--color-fg-muted) mt-1 mb-2">{meta}</p>
    <p class="text-sm text-(--color-fg-muted) leading-snug line-clamp-3">{blurb}</p>
    <span class="mt-auto pt-2 text-xs font-semibold text-(--color-forest-700) group-hover:text-(--color-fg) transition-colors">
      {cta} <span aria-hidden>→</span>
    </span>
  </div>
</a>
