---
// PrimaryWorkDetail.astro, shared full-UI component for primary-work entries.
//
// INVENTORY, which template each section came from:
//   FROM English only (previously missing in i18n route):
//     - original_script / translit title paragraphs
//     - purpose field in work-type label
//     - pagesNote ("206 pages") badge
//     - pubLine helper (place · year, vs i18n's simpler publisher · year)
//     - Tab nav + Summary/Read-PDF tabpanels (pdf_url-gated; replaced the
//       former "Read PDF" header button in the 2026-05-26 tab-layout work)
//     - prose-container div with full Tailwind styling class block
//     - Pull quotes section (summary_structured.pull_quotes)
//     - Themes chips section (fm.themes)
//     - Tier-B disclaimer paragraph
//     - PeopleInPiece component
//     - RelatedSection component
//   FROM i18n only (lang= attrs on h1, subtitle, prose div), DROPPED per
//     plan: page-level <html lang> set by BaseLayout covers the whole page;
//     we only add lang= where text language differs from the page language,
//     which is only the original_script paragraph (already in English template).
//   BOTH routes (kept as-is):
//     - PagefindFilters spans (filters + meta) inside the article element
//     - noindex={shouldNoindex(translation_status)}
//     - hreflangAlternates / lang / hreflang passed to BaseLayout
//     - byline logic (resolveAuthorEntries + bylineFallback)
//     - descriptionForMeta (200-char slice; no-summary fallback is language-neutral: fm.title.main)

import BaseLayout from "~/layouts/BaseLayout.astro";
import PagefindFilters from "~/components/PagefindFilters.astro";
import { ogWork } from "~/lib/og";
import { workNode, breadcrumbNode } from "~/lib/schema";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { hreflangAlternates, shouldNoindex } from "~/lib/i18n";
import { resolveAuthorEntries, type AuthorEntry } from "~/lib/resolve-author-entries";
import RelatedSection from "~/components/RelatedSection.astro";
import PeopleInPiece from "~/components/PeopleInPiece.astro";
import { seriesOf } from "~/lib/series";
import { siteCopy, label, fmt } from "~/lib/site-copy";

interface Props {
  entry: CollectionEntry<"primary-works">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fm = entry.data;
const labels = await siteCopy("labels");

const hreflang = hreflangAlternates(
  "primary-works",
  entry.id,
  fm.language,
  fm.translations,
  Astro.site!.origin,
);

// Pull resolved author thinker entries for byline + bio links.
const authorEntries = await resolveAuthorEntries(fm.authors, entry.id);

// An edited volume's byline belongs to whoever edited it. Resolved first,
// because a festschrift is "Edited by Parth J Shah" and not "By" any one of
// its seventeen contributors.
const editorEntries = await resolveAuthorEntries(fm.editors, entry.id);

// Byline string for the header / meta description when no resolved authors.
//
// The role comparison is case-insensitive and trimmed on purpose. It used to be
// `c.role === "author"`, and the extraction writes whatever the model returned:
// on `liberalism-in-india-2` five contributors came back as "Author" and one as
// "author", so the strict test matched exactly one of the six and the S. V. Raju
// festschrift was bylined to a single essayist. CCS reported it as "the author's
// name is not displaying correctly" (round 4, point 2). One lowercase letter
// should not decide a book's byline.
//
// Contributors are a last resort. When a volume has editors this fallback is
// not used at all: see the "Edited by" line in the header.
const bylineFallback = (fm.contributors ?? [])
  .filter((c) => (c.role ?? "").trim().toLowerCase() === "author")
  .map((c) => c.thinker_unresolved || c.thinker?.id || "")
  .filter(Boolean)
  .join(", ");

const yearStr = fm.publication?.year != null ? String(fm.publication.year) : "";
const placeStr = fm.publication?.place || "";
const pubLine = [placeStr, yearStr].filter(Boolean).join(" · ");

// The named run this work belongs to, so a booklet reads as the Nth of a
// series rather than as an orphan. Null for standalone works.
const series = await seriesOf(entry);
const seriesOrdinal = fm.publication?.series_ordinal ?? null;

// Page count for the public-facing badge. We deliberately do NOT surface
// the AI-extraction coverage (e.g. "20 of 206 rendered") here, that's
// editorial-pipeline detail, not interesting to a reader. Just show the
// total page count when we know it.
const pagesNote = (() => {
  const t = fm.physical?.pages_total ?? fm.physical?.page_count;
  return t ? `${t} pages` : "";
})();

// Bare integer for the "Read full PDF · N pages" tab label suffix.
// Distinct from `pagesNote` (a formatted string used by the header badge).
// `null` when the page count is unknown, tab label then degrades to
// "Read full PDF" (no suffix).
const pageCount = fm.physical?.pages_total ?? fm.physical?.page_count ?? null;

const themesPretty = (fm.themes ?? []).map((t) => t.replace(/-/g, " "));

// `interview` work_type carries summary / key_points / key_passages in
// frontmatter (the Phase B enrichment writes them there; the body is the
// cleaned diarized transcript). For PDF-baked work types, the emit-astro-md
// step writes those fields INTO the markdown body, so the existing <Content/>
// render handles them. We branch here to avoid double-rendering for PDFs.
// `lecture` shares the interview shape (diarized transcript + frontmatter summary).
// A work flagged hide_from_index has no trustworthy source behind it: its PDF
// was never digitised, and in three cases the summary on file was written from
// a different document. The page still resolves so nothing already linked
// breaks, but it says that rather than showing the text.
// See docs/missing-pdfs-and-bad-summaries.md.
const withheld = fm.hide_from_index === true;
const isInterview = fm.work_type === "interview" || fm.work_type === "lecture";
const interviewSummary = isInterview ? (fm.summary ?? "").trim() : "";
const interviewKeyPoints = isInterview ? (fm.key_points ?? []) : [];

// YouTube embed: lift the videoId from any youtube_url shape we know
// (watch?v=, youtu.be/, embed/). Empty string when not parseable.
const youtubeVideoId = (() => {
  if (!fm.youtube_url) return "";
  const u = String(fm.youtube_url);
  const watchMatch = u.match(/[?&]v=([a-zA-Z0-9_-]{6,15})/);
  if (watchMatch) return watchMatch[1];
  const shortMatch = u.match(/youtu\.be\/([a-zA-Z0-9_-]{6,15})/);
  if (shortMatch) return shortMatch[1];
  const embedMatch = u.match(/youtube\.com\/embed\/([a-zA-Z0-9_-]{6,15})/);
  if (embedMatch) return embedMatch[1];
  return "";
})();

// Pull quotes are the "shareable passage" UI. Two sources:
//   1. summary_structured.pull_quotes, populated by some v1.5 PDF entries.
//   2. thinker_mentions[].key_passages, populated by Phase B enrichment
//      (every enriched interview, plus newer PDFs). Each key_passage has
//      { quote, what_it_shows }; we map onto the existing { verbatim,
//      why_notable, page } shape so the render path stays uniform.
const structuredPullQuotes = (fm.summary_structured?.pull_quotes ?? []).filter(
  (q) => q && q.verbatim,
);
const mentionPullQuotes = (fm.thinker_mentions ?? []).flatMap((mn: any) => {
  const passages = Array.isArray(mn?.key_passages) ? mn.key_passages : [];
  return passages
    .filter((p: any) => p && typeof p.quote === "string" && p.quote.trim())
    .map((p: any) => ({
      verbatim: p.quote,
      why_notable: p.what_it_shows ?? "",
      page: undefined,
    }));
});
const pullQuotes = [...structuredPullQuotes, ...mentionPullQuotes];

// A withheld work must not leak the untrusted summary through the meta
// description, the social cards or the JSON-LD abstract, which is where it was
// still showing after the body was removed.
const descriptionForMeta = withheld
  ? `${fm.title.main}: a catalogue record. The source document has not been digitised.`
  : fm.summary
    ? fm.summary.slice(0, 200) + (fm.summary.length > 200 ? "…" : "")
    : fm.title.main;

// Organisations tied to this work, for the org:<id> Pagefind facet that
// scopes the organisation page's works search. Same membership rule as
// OrganisationDetail's publishedHere: publisher, issuer, or an org that
// authored/edited the work.
const orgRefIds = (refs?: Array<{ collection?: string; id?: string }>) =>
  (refs ?? [])
    .filter((r) => r && r.collection === "organisations" && r.id)
    .map((r) => r.id as string);
const orgSlugs = [
  ...new Set(
    [
      fm.publication?.publisher_id,
      fm.publication?.issuer_id,
      ...orgRefIds(fm.authors as never),
      ...orgRefIds(fm.editors as never),
    ].filter((s): s is string => Boolean(s)),
  ),
];

// Slug lists for the PeopleInPiece chip section.
const authorSlugs = authorEntries
  .filter((e): e is Extract<AuthorEntry, { kind: "thinker" }> => e.kind === "thinker")
  .map((e) => e.id);
const contributorSlugs = (fm.contributors ?? [])
  .map((c) => c.thinker?.id)
  .filter((s): s is string => !!s && !authorSlugs.includes(s));
const mentionSlugs = (fm.thinker_mentions ?? [])
  .map((mn: any) => (typeof mn.thinker === "string" ? mn.thinker : mn.thinker?.id))
  .filter(Boolean);

// `related_thinkers` is the Phase-A flat list of thinkers extracted from the
// source PDF. Many works have it populated even when `thinker_mentions` (the
// richer Phase-B structure) is empty. Without surfacing related_thinkers here,
// the thinker page's "Mentioned in" backlink points to a work that gives no
// visible trace of the thinker. PeopleInPiece de-dupes against authorSlugs +
// the earlier slug arrays, so we just append; only genuinely-additional
// related thinkers get a chip.
const relatedThinkerSlugs = (fm.related_thinkers ?? [])
  .map((r: any) => (typeof r === "string" ? r : r?.id))
  .filter(Boolean);
---

<BaseLayout
  title={`${fm.title.main} · Indian Liberals`}
  description={descriptionForMeta}
  lang={fm.language}
  hreflang={hreflang}
  noindex={shouldNoindex(fm.translation_status) || withheld}
  ogImage={ogWork(entry.id, Boolean(fm.cover_image))}
  ogType={["book", "edited_volume", "reference"].includes(fm.work_type) ? "book" : "article"}
  schema={[
    // Withheld works get no structured abstract, for the same reason.
    workNode(
      withheld
        ? ({ ...entry, data: { ...entry.data, summary: undefined, ai_summary: undefined } } as typeof entry)
        : entry,
      authorEntries,
      Astro.url.pathname,
    ),
    breadcrumbNode([
      ["Home", "/"],
      ["Primary works", "/primary-works/"],
      [fm.title.main, Astro.url.pathname],
    ]),
  ]}
>
  <article
    class="mx-auto max-w-4xl px-6 py-12 md:py-16"
  >
    <PagefindFilters
      filters={{ type: "primary-work", lang: fm.language, author: authorSlugs, org: orgSlugs }}
      meta={{ work_type: fm.work_type, year: yearStr }}
    />
    <header class="border-b border-(--color-border) pb-10 mb-10 md:grid md:grid-cols-[1fr_auto] md:gap-8 items-start">
      <div>
      <p class="text-xs uppercase tracking-widest text-(--color-saffron-700) font-(family-name:--font-ui) font-semibold mb-3">
        {fm.work_type.replace(/_/g, " ")}
        {fm.purpose && ` · ${fm.purpose.replace(/_/g, " ")}`}
      </p>
      <h1 class="text-(--color-fg) leading-tight">{fm.title.main}</h1>
      {fm.title.subtitle && (
        <p class="text-(--color-fg-muted) font-(family-name:--font-display) italic text-xl mt-2">
          {fm.title.subtitle}
        </p>
      )}
      {fm.title.original_script && fm.title.original_script !== fm.title.main && (
        <p class="text-(--color-fg-muted) font-(family-name:--font-display) text-xl mt-2" lang={fm.language}>
          {fm.title.original_script}
        </p>
      )}
      {fm.title.translit && fm.title.translit !== fm.title.main && fm.title.translit !== fm.title.original_script && (
        <p class="text-(--color-fg-muted) font-(family-name:--font-display) italic text-xl mt-2">
          {fm.title.translit}
        </p>
      )}

      {/* Byline. An edited volume with no named authors is credited to its
          editors; only when there is neither do the contributors stand in. */}
      {authorEntries.length === 0 && editorEntries.length > 0 && (
        <p class="mt-5 text-base text-(--color-fg) font-(family-name:--font-ui)">
          Edited by{" "}
          {editorEntries.map((e, i) => {
            const sep = i < editorEntries.length - 1 ? ", " : "";
            return e.kind === "organisation" ? (
              <><a href={`/organisations/${e.id}/`} class="text-(--color-saffron-700)">{e.name}</a>{sep}</>
            ) : (
              <><a href={`/thinkers/${e.id}/`} class="text-(--color-forest-700)">{e.name}</a>{sep}</>
            );
          })}
        </p>
      )}

      {(authorEntries.length > 0 || (editorEntries.length === 0 && bylineFallback)) && (
        <p class="mt-5 text-base text-(--color-fg) font-(family-name:--font-ui)">
          By{" "}
          {authorEntries.length > 0
            ? authorEntries.map((e, i) => {
                const sep = i < authorEntries.length - 1 ? ", " : "";
                return e.kind === "organisation" ? (
                  <><a href={`/organisations/${e.id}/`} class="text-(--color-saffron-700)">{e.name}</a><span class="ml-1 inline-block align-middle px-1.5 py-0.5 rounded text-[10px] uppercase tracking-wider font-(family-name:--font-ui) font-semibold bg-(--color-saffron-100) text-(--color-saffron-700)">organisation</span>{sep}</>
                ) : (
                  <><a href={`/thinkers/${e.id}/`} class="text-(--color-forest-700)">{e.name}</a>{sep}</>
                );
              })
            : bylineFallback}
        </p>
      )}

      {/* Publication line */}
      {(pubLine || fm.publication?.publisher_name) && (
        <p class="mt-2 text-sm text-(--color-fg-muted) font-(family-name:--font-ui)">
          {fm.publication?.publisher_name && (
            <>{fm.publication.publisher_name}{pubLine && " · "}</>
          )}
          {pubLine}
        </p>
      )}
      {pagesNote && (
        <p class="mt-1 text-xs text-(--color-fg-muted) font-(family-name:--font-ui)">{pagesNote}</p>
      )}

      {series && (
        <p class="mt-2 text-sm font-(family-name:--font-ui)">
          <span class="text-(--color-fg-muted)">
            {seriesOrdinal !== null ? `No. ${seriesOrdinal} in ` : "Part of "}
          </span>
          <a href={`/series/${series.id}/`} class="text-(--color-forest-700)">
            {series.data.name}
          </a>
        </p>
      )}
      </div>

      {fm.cover_image && (
        <img
          src={fm.cover_image}
          alt={`First page of ${fm.title.main}`}
          width="160"
          height="213"
          loading="lazy"
          class="hidden md:block w-36 lg:w-40 border border-(--color-border) rounded-sm shadow-sm"
        />
      )}
    </header>

    {/* Tab nav, only when this work has a downloadable PDF.
        Both buttons share identical Tailwind classes; aria-selected: drives the active style. */}
    {fm.pdf_url && (
      <div
        role="tablist"
        aria-label="Reading modes"
        class="border-b border-(--color-border) mb-8 flex font-(family-name:--font-ui)"
      >
        <button
          role="tab"
          id="tab-summary"
          aria-controls="panel-summary"
          aria-selected="true"
          tabindex="0"
          class="px-4 py-3 text-sm font-semibold border-b-2 border-transparent
                 aria-selected:border-(--color-saffron-700) aria-selected:text-(--color-fg)
                 text-(--color-fg-muted) hover:text-(--color-fg) cursor-pointer
                 focus:outline-none focus-visible:ring-2 focus-visible:ring-(--color-saffron-500)
                 -mb-px transition-colors"
        >
          {label(labels, "work.summary", "Summary")}
        </button>
        <button
          role="tab"
          id="tab-read"
          aria-controls="panel-read"
          aria-selected="false"
          tabindex="-1"
          class="px-4 py-3 text-sm font-semibold border-b-2 border-transparent
                 aria-selected:border-(--color-saffron-700) aria-selected:text-(--color-fg)
                 text-(--color-fg-muted) hover:text-(--color-fg) cursor-pointer
                 focus:outline-none focus-visible:ring-2 focus-visible:ring-(--color-saffron-500)
                 -mb-px transition-colors"
        >
          {pageCount ? fmt(label(labels, "work.read_pdf", "Read full PDF · {pages} pages"), { pages: pageCount }) : "Read full PDF"}
        </button>
      </div>
    )}

    {/* Summary tabpanel (in tab mode) or just the body section (no-PDF mode).
        When fm.pdf_url is unset, role/id/aria-labelledby are all undefined and
        Astro omits them, the div renders as a plain wrapper. */}
    <div
      role={fm.pdf_url ? "tabpanel" : undefined}
      id={fm.pdf_url ? "panel-summary" : undefined}
      aria-labelledby={fm.pdf_url ? "tab-summary" : undefined}
    >
      {/* Interview-specific blocks: YouTube embed, AI summary, key points.
          Rendered above the cleaned-transcript body. PDF-baked works skip these
          because their summary/key_points are emitted INTO the body markdown
          by emit-astro-md.py and would otherwise double-render. */}
      {isInterview && youtubeVideoId && (
        <section class="mb-10">
          <div class="relative w-full" style="padding-bottom: 56.25%; height: 0;">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${youtubeVideoId}`}
              title={`YouTube video: ${fm.title.main}`}
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="absolute inset-0 w-full h-full rounded-lg border border-(--color-border)"
            ></iframe>
          </div>
        </section>
      )}

      {isInterview && interviewSummary && (
        <section class="mb-10">
          <h2 class="text-xs uppercase tracking-widest text-(--color-fg-muted) font-(family-name:--font-ui) font-semibold mb-4">
            {label(labels, "work.summary", "Summary")}
          </h2>
          <div class="prose-container">
            {interviewSummary.split(/\n\n+/).map((para) => (
              <p class="text-[1.0625rem] leading-relaxed text-(--color-fg) my-4">{para}</p>
            ))}
          </div>
        </section>
      )}

      {isInterview && interviewKeyPoints.length > 0 && (
        <section class="mb-10">
          <h2 class="text-xs uppercase tracking-widest text-(--color-fg-muted) font-(family-name:--font-ui) font-semibold mb-4">
            {label(labels, "work.key_points", "Key points")}
          </h2>
          <ul class="list-disc pl-6 space-y-2">
            {interviewKeyPoints.map((kp: string) => (
              <li class="text-[1.0625rem] leading-relaxed text-(--color-fg)">{kp}</li>
            ))}
          </ul>
        </section>
      )}

      {/* Body markdown, contains the full Summary, Key points, and any
          additional sections the emitter wrote. The frontmatter `summary` and
          `ai_key_points` fields are intentionally truncated for the search
          index / og:description; the body is the canonical text shown to
          readers. The `[&_>_h1]:hidden` rule suppresses the body's duplicate
          H1 (the page header above already shows the title). */}
      {isInterview && (
        <h2 class="text-xs uppercase tracking-widest text-(--color-fg-muted) font-(family-name:--font-ui) font-semibold mb-4">
          {label(labels, "work.transcript", "Transcript")}
        </h2>
      )}
      {withheld && (
        <div class="mb-10 rounded-lg border border-(--color-border) bg-(--color-bg-muted) p-5 font-(family-name:--font-ui)">
          <p class="text-sm font-semibold text-(--color-fg) mb-1">{label(labels, "work.withheld_title", "Not yet digitised")}</p>
          <p class="text-sm text-(--color-fg-muted) leading-relaxed">
            {label(labels, "work.withheld_body", "The archive holds a catalogue record for this work but not the document itself, so there is nothing here to read yet and the description previously shown could not be relied on. The entry is kept so the reference survives. It will be restored once the source has been scanned.")}
          </p>
        </div>
      )}
      {!withheld && (
      <div class="prose-container mb-10">
        <div class="text-(--color-fg) leading-relaxed [&_>_h1]:hidden [&_p]:my-4 [&_p]:text-[1.0625rem] [&_h2]:text-xs [&_h2]:uppercase [&_h2]:tracking-widest [&_h2]:text-(--color-fg-muted) [&_h2]:font-(family-name:--font-ui) [&_h2]:font-semibold [&_h2]:mt-10 [&_h2]:mb-4 [&_h3]:mt-8 [&_h3]:mb-3 [&_a]:text-(--color-forest-700) [&_ul]:my-5 [&_ul]:list-disc [&_ul]:pl-6 [&_ul_li]:my-2 [&_ul_li]:text-[1.0625rem] [&_blockquote]:border-l-2 [&_blockquote]:border-(--color-saffron-500) [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-(--color-fg-muted) [&_em]:italic">
          <Content />
        </div>
      </div>
      )}

      {/* Pull quotes */}
      {pullQuotes.length > 0 && (
        <section class="mb-10">
          <h2 class="text-xs uppercase tracking-widest text-(--color-fg-muted) font-(family-name:--font-ui) mb-4">
            {label(labels, "work.passages", "Notable passages")}
          </h2>
          <div class="space-y-6">
            {pullQuotes.map((q) => (
              <figure class="border-l-2 border-(--color-saffron-500) pl-5 py-1">
                <blockquote class="text-lg leading-relaxed text-(--color-fg) italic font-(family-name:--font-display)">
                  "{q.verbatim}"
                </blockquote>
                <figcaption class="mt-2 text-xs uppercase tracking-widest text-(--color-fg-muted) font-(family-name:--font-ui)">
                  {q.why_notable ? q.why_notable.replace(/_/g, " ") : ""}{q.page ? ` · p. ${q.page}` : ""}
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}
    </div>

    {/* Read PDF tabpanel, only when this work has a downloadable PDF.
        Iframe is NOT rendered server-side; the inline script at the bottom
        injects it lazily on first tab activation. */}
    {fm.pdf_url && (
      <div
        role="tabpanel"
        id="panel-read"
        aria-labelledby="tab-read"
        hidden
        class="mb-10"
      >
        <div data-pdf-mount data-pdf-url={fm.pdf_url}></div>
        <p class="mt-3 text-sm font-(family-name:--font-ui)">
          <a
            href={fm.pdf_url}
            target="_blank"
            rel="noopener"
            class="text-(--color-forest-700) hover:underline"
          >
            Open in new tab ↗
          </a>
        </p>
      </div>
    )}

    {/* Themes */}
    {themesPretty.length > 0 && (
      <aside class="mt-12 pt-8 border-t border-(--color-border) font-(family-name:--font-ui) text-sm">
        <h2 class="text-xs uppercase tracking-widest text-(--color-fg-muted) mb-3">{label(labels, "work.themes", "Themes")}</h2>
        <ul class="flex flex-wrap gap-2">
          {themesPretty.map((th) => (
            <li class="px-2.5 py-1 bg-(--color-bg-muted) border border-(--color-border) rounded-full text-(--color-fg)">{th}</li>
          ))}
        </ul>
      </aside>
    )}

    {/* Tier-B disclaimer */}
    <p class="mt-12 pt-6 border-t border-(--color-border) text-xs text-(--color-fg-muted) font-(family-name:--font-ui) italic">
      Metadata and summary are AI-extracted from the source PDF and reviewed for
      editorial accuracy. The original work is available via the Read PDF tab above
      (where present); paragraph-level citation inside the PDF is deferred to a
      future engagement.
    </p>

    <PeopleInPiece
      authorSlugs={authorSlugs}
      mentionSlugs={[...contributorSlugs, ...mentionSlugs, ...relatedThinkerSlugs]}
      title={label(labels, "work.people", "People in this work")}
    />

    <RelatedSection collection="primary-works" slug={entry.id} viewerLang={entry.data.language} />

    <script is:inline>
      (() => {
        const tablist = document.querySelector('[role="tablist"]');
        if (!tablist) return; // No-op for pages without pdf_url.

        const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
        const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')));

        function activate(idx, { syncHash = true, focusTab = true } = {}) {
          tabs.forEach((t, i) => {
            const selected = i === idx;
            t.setAttribute('aria-selected', selected);
            t.tabIndex = selected ? 0 : -1;
            panels[i].hidden = !selected;
          });

          // Lazy-inject iframe on first activation of the Read PDF panel.
          if (idx === 1) {
            const mount = panels[1].querySelector('[data-pdf-mount]');
            if (mount && !mount.dataset.loaded) {
              const url = mount.dataset.pdfUrl;
              const iframe = document.createElement('iframe');
              iframe.src = url;
              iframe.title = document.title;
              iframe.style.width = '100%';
              iframe.style.height = window.matchMedia('(max-width: 768px)').matches ? '70vh' : '80vh';
              iframe.style.border = '0';
              // No loading="lazy", the iframe is only constructed on click,
              // so it's already lazy in the meaningful sense.
              mount.appendChild(iframe);
              mount.dataset.loaded = 'true';
            }
          }

          if (syncHash) {
            const fragment = idx === 1 ? '#read' : '#summary';
            history.replaceState(null, '', fragment);
          }
          if (focusTab) tabs[idx].focus({ preventScroll: true });
        }

        tabs.forEach((tab, i) => {
          tab.addEventListener('click', () => activate(i));
          tab.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight') activate((i + 1) % tabs.length);
            if (e.key === 'ArrowLeft') activate((i - 1 + tabs.length) % tabs.length);
          });
        });

        // Honor initial URL hash. #read → PDF tab. Anything else → Summary.
        // Do NOT focus the tab on hash-init, a deep-linked visitor expects
        // to start reading, not to have a tab control under their cursor.
        const initial = window.location.hash === '#read' ? 1 : 0;
        if (initial !== 0) {
          activate(initial, { syncHash: false, focusTab: false });
        }
      })();
    </script>
  </article>
</BaseLayout>
