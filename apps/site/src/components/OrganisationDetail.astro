---
// OrganisationDetail.astro - shared full-UI component for organisation entries.
//
// INVENTORY - which template each section came from:
//   FROM English only (previously missing in i18n route):
//     - full name italic paragraph (name.full when different from canonical)
//     - Also known as line (name.also_known_as)
//     - Works published / issued section (iterates all primary-works, filters by
//       publisher_id / issuer_id / org authorship; rendered by WorksExplorer,
//       cover-led + searchable + filterable, no cap)
//     - Affiliated thinkers section (filters thinkers by affiliations.includes(o.id))
//     - Ideology aside (o.data.ideology tags)
//     - RelatedSection component
//     - datesStr helper (Founded YEAR / YEAR–YEAR) - the i18n template used the
//       simpler "founded_year ?? '?'–dissolved_year ?? ''" rendering, which is
//       replaced here by the English template's richer helper
//     - description meta string (English-language; see note below)
//   FROM i18n only (lang= attrs on h1 and prose-container div) - DROPPED per plan:
//     BaseLayout sets the page-level <html lang>; per-element lang= is only
//     needed where the element's language differs from the page language.
//     The i18n template's `lang={o.data.language}` on <h1> and the prose-container
//     div was redundant. Dropped here.
//   BOTH routes (kept as-is):
//     - type chip, h1 canonical name, datesStr paragraph
//     - PagefindFilters spans (type/lang) inside the article element
//     - noindex={shouldNoindex(translation_status)}
//     - hreflangAlternates / lang / hreflang passed to BaseLayout
//     - prose-container block with org-specific styling class block
//
// NOTE on description meta string:
//   The string "... organisation profile, affiliated thinkers, and primary works."
//   is English-language. No i18n org MDs currently exist in gu/hi/mr/bn, so this
//   is theoretical. When i18n org MDs land, a language-keyed approach will be
//   needed - for now the string is irrelevant in practice for i18n pages.
//
// NOTE on allThinkers filter:
//   The English template only fetched English thinkers (language === DEFAULT_LOCALE).
//   That filter is preserved here faithfully - no i18n thinker MDs exist, so it's a
//   no-op restriction but matches existing behaviour. When i18n thinker MDs land,
//   this may want revisiting.
//
// NOTE on workHref:
//   The helper is about cross-language links in the "Works published" list, not
//   about the org's own language. Non-English works link to /<lang>/primary-works/
//   <slug>/; English works link to /primary-works/<slug>/.

import BaseLayout from "~/layouts/BaseLayout.astro";
import PagefindFilters from "~/components/PagefindFilters.astro";
import WorksExplorer from "~/components/WorksExplorer.astro";
import CollapsibleBio from "~/components/CollapsibleBio.astro";
import EvidenceLink from "~/components/EvidenceLink.astro";
import { organisationDetailNode, breadcrumbNode } from "~/lib/schema";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { hreflangAlternates, shouldNoindex, DEFAULT_LOCALE } from "~/lib/i18n";
import RelatedSection from "~/components/RelatedSection.astro";
import OrgMark from "~/components/OrgMark.astro";
import { orgMentions } from "~/lib/org-mentions";
import { isListed } from "~/lib/listable";
import { siteCopy, label } from "~/lib/site-copy";

interface Props {
  entry: CollectionEntry<"organisations">;
}

const { entry } = Astro.props;
// Alias for ergonomics - existing template logic uses `o`.
const o = entry;
const { Content } = await render(o);
const labels = await siteCopy("labels");

const hreflang = hreflangAlternates(
  "organisations",
  o.id,
  o.data.language,
  o.data.translations,
  Astro.site!.origin,
);

const datesStr =
  o.data.founded_year && o.data.dissolved_year
    ? `${o.data.founded_year}–${o.data.dissolved_year}`
    : o.data.founded_year
      ? `Founded ${o.data.founded_year}`
      : "";

// Pull works published by this org + thinkers affiliated with it.
// The language filter is DROPPED here on purpose - the org page is about
// the organisation's full catalogue, not just its English-language works.
// Non-English works link to their /<lang>/primary-works/<slug>/ route
// (the localised detail page); English ones link to /primary-works/<slug>/.
const allWorks = await getCollection(
  "primary-works",
  isListed,
);
// A work belongs on this page when the org published/issued it OR authored/
// edited it (party manifestos, institutional pamphlets — authors[] can
// reference organisations, which the old publisher-only filter missed).
const orgRef = (refs?: { collection: string; id: string }[]) =>
  (refs ?? []).some((r) => r.collection === "organisations" && r.id === o.id);
const publishedAll = allWorks
  .filter(
    (w) =>
      w.data.publication?.publisher_id === o.id ||
      w.data.publication?.issuer_id === o.id ||
      orgRef(w.data.authors as never) ||
      orgRef(w.data.editors as never),
  )
  .sort((a, b) => (b.data.publication?.year ?? 0) - (a.data.publication?.year ?? 0));
// Periodical issues swamp the grid (Freedom First alone has ~1,000) and,
// as on /primary-works/, they belong to their runs at /periodicals/. The
// grid shows the individual documents; a note under the heading points at
// the runs when issues exist.
const periodicalIssues = publishedAll.filter((w) => w.data.work_type === "periodical_issue");
const publishedHere = publishedAll.filter((w) => w.data.work_type !== "periodical_issue");

const allThinkers = await getCollection(
  "thinkers",
  (t) => !t.data.draft && t.data.language === DEFAULT_LOCALE,
);
const affiliatedThinkers = allThinkers.filter((t) => (t.data.affiliations ?? []).includes(o.id));

// Prose mentions across the archive (thinker bios, opinions, musings, work
// summaries). This is what gives context-only organisations their purpose:
// structured affiliations/graph-edges were never populated, but the prose
// names them constantly. See ~/lib/org-mentions.
const mentionedIn = (await orgMentions(o.id)).filter(
  (m) => !publishedHere.some((w) => w.id === m.id),
);
const MENTION_LABEL: Record<string, string> = {
  thinker: "Thinker",
  opinion: "Opinion",
  musing: "Musing",
  work: "Work",
};
---

<BaseLayout
  title={`${o.data.name.canonical} · Indian Liberals`}
  description={`${o.data.name.canonical}${datesStr ? ` (${datesStr})` : ""}: organisation profile, affiliated thinkers, and primary works.`}
  lang={o.data.language}
  hreflang={hreflang}
  noindex={shouldNoindex(o.data.translation_status)}
  schema={[
    organisationDetailNode(o, Astro.url.pathname),
    breadcrumbNode([
      ["Home", "/"],
      ["Organisations", "/organisations/"],
      [o.data.name.canonical, Astro.url.pathname],
    ]),
  ]}
>
  <article
    class="mx-auto max-w-4xl px-6 py-12 md:py-16"
  >
    <PagefindFilters filters={{ type: "organisation", lang: o.data.language }} />
    <header class="border-b border-(--color-border) pb-10 mb-10 flex flex-wrap gap-6 items-start">
      <OrgMark name={o.data.name.canonical} logo={o.data.logo} class="w-16 h-16 md:w-20 md:h-20 mt-1" textClass="text-2xl" />
      <div class="min-w-0">
        <p class="text-xs uppercase tracking-widest text-(--color-saffron-700) font-(family-name:--font-ui) font-semibold mb-2">
          {o.data.type.replace(/_/g, " ")}
        </p>
        <h1 class="text-(--color-fg) leading-tight">{o.data.name.canonical}</h1>
        {o.data.name.full && o.data.name.full !== o.data.name.canonical && (
          <p class="text-(--color-fg-muted) font-(family-name:--font-display) italic text-lg mt-1">
            {o.data.name.full}
          </p>
        )}
        {datesStr && (
          <p class="text-(--color-fg-muted) font-(family-name:--font-ui) mt-3 text-base">{datesStr}</p>
        )}
        {o.data.name.also_known_as.length > 0 && (
          <p class="text-(--color-fg-muted) text-sm mt-3 font-(family-name:--font-ui)">
            Also known as: {o.data.name.also_known_as.join(", ")}
          </p>
        )}
        {o.data.description && (
          <p class="text-(--color-fg-muted) leading-relaxed mt-4 max-w-prose">
            {o.data.description}
          </p>
        )}
      </div>
      {/* Stat strip: what the archive holds for this organisation, as jump
          links. Counts reuse the section variables so they cannot disagree
          with the headings they point at. */}
      {(publishedAll.length > 0 || affiliatedThinkers.length > 0 || mentionedIn.length > 0) && (
        <nav aria-label="On this page" class="basis-full flex flex-wrap gap-2 font-(family-name:--font-ui) text-sm">
          {publishedHere.length > 0 && (
            <a href="#works" class="px-3 py-1.5 bg-(--color-bg-muted) border border-(--color-border) rounded-full no-underline text-(--color-fg) hover:border-(--color-fg) transition-colors">
              <strong>{publishedHere.length}</strong> {publishedHere.length === 1 ? "work" : "works"}
            </a>
          )}
          {periodicalIssues.length > 0 && (
            <a href="/periodicals/" class="px-3 py-1.5 bg-(--color-bg-muted) border border-(--color-border) rounded-full no-underline text-(--color-fg) hover:border-(--color-fg) transition-colors">
              <strong>{periodicalIssues.length}</strong> periodical {periodicalIssues.length === 1 ? "issue" : "issues"}
            </a>
          )}
          {affiliatedThinkers.length > 0 && (
            <a href="#thinkers" class="px-3 py-1.5 bg-(--color-bg-muted) border border-(--color-border) rounded-full no-underline text-(--color-fg) hover:border-(--color-fg) transition-colors">
              <strong>{affiliatedThinkers.length}</strong> affiliated {affiliatedThinkers.length === 1 ? "thinker" : "thinkers"}
            </a>
          )}
          {mentionedIn.length > 0 && (
            <a href="#mentions" class="px-3 py-1.5 bg-(--color-bg-muted) border border-(--color-border) rounded-full no-underline text-(--color-fg) hover:border-(--color-fg) transition-colors">
              Mentioned in <strong>{mentionedIn.length}</strong>
            </a>
          )}
        </nav>
      )}
    </header>

    {/* Long histories collapse behind a fade + toggle; see CollapsibleBio. */}
    <CollapsibleBio moreLabel="Read the full history">
      <div class="text-(--color-fg) leading-relaxed [&_p]:my-5 [&_p]:text-[1.0625rem] [&_h2]:mt-10 [&_h2]:mb-4 [&_a]:text-(--color-forest-700) [&_ul]:my-5 [&_ul]:list-disc [&_ul]:pl-6">
        <Content />
      </div>
    </CollapsibleBio>

    {/* Works published by this organisation: the full cover-led explorer,
        searchable and filterable, no truncation. Deep search scopes the
        Pagefind query with the org:<id> facet emitted by PrimaryWorkDetail. */}
    {publishedAll.length > 0 && (
      <section id="works" class="mt-12 pt-8 border-t border-(--color-border) font-(family-name:--font-ui) scroll-mt-24">
        <h2 class="text-xs uppercase tracking-widest text-(--color-fg-muted) mb-2">
          {label(labels, "org.works", "Works published / issued")} ({publishedHere.length > 0 ? publishedHere.length : periodicalIssues.length})
        </h2>
        {periodicalIssues.length > 0 && (
          <p class="text-sm text-(--color-fg-muted) leading-relaxed mb-6 max-w-prose">
            {periodicalIssues.length.toLocaleString("en-IN")} periodical
            {periodicalIssues.length === 1 ? " issue is" : " issues are"} catalogued
            under their runs in <a href="/periodicals/" class="text-(--color-forest-700)">Series &amp; periodicals</a>.
          </p>
        )}
        {publishedHere.length > 0 && (
          <div class={periodicalIssues.length > 0 ? "" : "mt-4"}>
            <WorksExplorer
              name={o.data.name.canonical}
              scope={{ facet: "org", id: o.id }}
              works={publishedHere}
            />
          </div>
        )}
      </section>
    )}

    {/* Affiliated thinkers, with portraits so the row reads as people,
        not a tag cloud. */}
    {affiliatedThinkers.length > 0 && (
      <section id="thinkers" class="mt-12 pt-8 border-t border-(--color-border) scroll-mt-24">
        <h2 class="text-xs uppercase tracking-widest text-(--color-fg-muted) font-(family-name:--font-ui) mb-4">
          {label(labels, "org.thinkers", "Affiliated thinkers")} ({affiliatedThinkers.length})
        </h2>
        <ul class="flex flex-wrap gap-2 font-(family-name:--font-ui)">
          {affiliatedThinkers.map((t) => {
            const portrait =
              t.data.portrait?.caricature ?? t.data.portrait?.ring_portrait ?? t.data.portrait?.photo;
            return (
              <li>
                <a
                  href={`/thinkers/${t.id}/`}
                  class="inline-flex items-center gap-2 pl-1.5 pr-3 py-1.5 bg-(--color-bg-muted) border border-(--color-border) rounded-full text-sm text-(--color-fg) no-underline hover:border-(--color-fg)"
                >
                  <span class="w-6 h-6 rounded-full overflow-hidden bg-(--color-bg) border border-(--color-border) flex items-center justify-center shrink-0">
                    {portrait ? (
                      <img src={portrait} alt="" width="24" height="24" loading="lazy" class="w-full h-full object-cover object-top" />
                    ) : (
                      <span aria-hidden="true" class="text-[10px] text-(--color-fg-muted)">{t.data.name.canonical.charAt(0)}</span>
                    )}
                  </span>
                  {t.data.name.canonical}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    {/* Prose mentions across the archive (see ~/lib/org-mentions). Rows carry
        the mention's cover/hero/portrait; the remainder folds into a native
        <details> so nothing is unreachable and expansion works without JS. */}
    {mentionedIn.length > 0 && (
      <section id="mentions" class="mt-12 pt-8 border-t border-(--color-border) font-(family-name:--font-ui) scroll-mt-24">
        <h2 class="text-xs uppercase tracking-widest text-(--color-fg-muted) mb-4">
          {label(labels, "org.mentioned", "Mentioned in")} ({mentionedIn.length})
        </h2>
        <ul class="space-y-3">
          {mentionedIn.slice(0, 12).map((m) => (
            <EvidenceLink
              href={m.href}
              title={m.title}
              badge={MENTION_LABEL[m.kind]}
              thumb={m.image ?? null}
              thumbKind={m.imageKind ?? "portrait"}
            />
          ))}
        </ul>
        {mentionedIn.length > 12 && (
          <details class="mt-2">
            <summary class="cursor-pointer select-none text-sm font-semibold text-(--color-saffron-700) hover:text-(--color-fg)">
              Show all {mentionedIn.length}
            </summary>
            <ul class="space-y-3 mt-3">
              {mentionedIn.slice(12).map((m) => (
                <EvidenceLink
                  href={m.href}
                  title={m.title}
                  badge={MENTION_LABEL[m.kind]}
                  thumb={m.image ?? null}
                  thumbKind={m.imageKind ?? "portrait"}
                />
              ))}
            </ul>
          </details>
        )}
      </section>
    )}

    {/* Ideology tags */}
    {(o.data.ideology ?? []).length > 0 && (
      <aside class="mt-12 pt-8 border-t border-(--color-border) font-(family-name:--font-ui) text-sm">
        <h2 class="text-xs uppercase tracking-widest text-(--color-fg-muted) mb-3">{label(labels, "org.ideology", "Ideological orientation")}</h2>
        <ul class="flex flex-wrap gap-2">
          {o.data.ideology.map((i) => (
            <li class="px-2.5 py-1 bg-(--color-bg-muted) border border-(--color-border) rounded-full text-(--color-fg)">{i.replace(/_/g, " ")}</li>
          ))}
        </ul>
      </aside>
    )}

    <RelatedSection collection="organisations" slug={o.id} viewerLang={o.data.language} />
  </article>
</BaseLayout>
