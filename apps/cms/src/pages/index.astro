---
import Shell from '../layouts/Shell.astro';
---

<Shell title="Archive">
  <p class="eyebrow">Indian Liberals</p>
  <h1>What would you like to do</h1>
  <hr class="rule" />
  <p class="lede">
    Everything in the archive is here. Add something new, or find what you want to change.
  </p>

  <div class="actions">
    <a class="card action" href="/add">
      <h3>Add something new</h3>
      <p>
        A book, a pamphlet, an issue of a periodical, a thinker, an organisation. Upload the
        document and let AI read it for you, or type the details in yourself.
      </p>
      <span class="go">Start</span>
    </a>
    <a class="card action" href="/browse">
      <h3>Find and edit</h3>
      <p>
        Search everything already in the archive and change it. Every edit is recorded with
        your name against it.
      </p>
      <span class="go">Browse</span>
    </a>
  </div>

  <section style="margin-top:2.5rem">
    <h2>The archive today</h2>
    <hr class="rule" />
    <div class="counts" id="counts">
      <p class="muted">Counting.</p>
    </div>
  </section>

  <style>
    .lede { max-width: 40rem; }
    .actions { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); margin-top: 1.75rem; }
    .action { text-decoration: none; display: block; transition: border-color .15s, transform .15s; }
    .action:hover { border-color: var(--gold); transform: translateY(-1px); }
    .action p { margin: .5rem 0 1rem; font-size: .92rem; }
    .go { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; font-weight: 700; color: var(--brown); }
    .counts { display: grid; gap: .75rem; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); }
    .count { background: var(--tile); border-radius: 14px; padding: 1rem 1.1rem; }
    .count .n { font-family: var(--serif); font-size: 1.8rem; color: var(--brown); line-height: 1; font-variant-numeric: tabular-nums; }
    .count .k { font-size: .82rem; margin-top: .3rem; }
  </style>

  <script>
    // Counts come from the live site's own metadata endpoint rather than from
    // the repository, so this page shows what readers can actually see.
    const LABELS: Record<string, string> = {
      primary_works: 'Primary works',
      interviews: 'Interviews',
      periodical_issues: 'Periodical issues',
      thinkers: 'Thinkers',
      organisations: 'Organisations',
      musings: 'Musings',
      opinions: 'Opinions',
      theprint_mirror: 'From ThePrint',
    };

    const box = document.getElementById('counts')!;
    fetch('https://indianliberals.in/api/meta.json')
      .then((r) => r.json() as Promise<{ counts: Record<string, number> }>)
      .then((meta) => {
        box.innerHTML = Object.entries(meta.counts)
          .map(
            ([key, value]) =>
              `<div class="count"><div class="n">${value.toLocaleString('en-IN')}</div><div class="k">${LABELS[key] ?? key}</div></div>`,
          )
          .join('');
      })
      .catch(() => {
        box.innerHTML = '<p class="muted">Could not reach the site to count what is in it.</p>';
      });
  </script>
</Shell>
