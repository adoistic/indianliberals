---
import Shell from '../layouts/Shell.astro';

/**
 * The home screen asks what you want to do, not which kind of record you would
 * like to create.
 *
 * Nobody arrives here thinking "I should like to author a primary-work entity".
 * They arrive holding a scanned pamphlet, or having noticed that a page credits
 * the wrong author. Those are the two jobs, and they are what this offers. The
 * taxonomy still exists underneath, but it is something the software works out,
 * not a question the archivist has to answer first.
 */

const jobs = [
  {
    href: '/add?job=document',
    title: 'Put a document online',
    lede: 'A scanned book, pamphlet, speech or magazine issue. Upload the file and the details can be filled in for you.',
    meta: 'The commonest job',
    primary: true,
  },
  {
    href: '/batch',
    title: 'Put a whole folder online',
    lede: 'A batch of scans that arrived together. They are uploaded, read one after another, and wait on the shelf for you to check them.',
    meta: 'For a delivery of documents',
  },
  {
    href: '/browse',
    title: 'Fix something that is wrong',
    lede: 'Find any page in the archive and correct it. A wrong author, a missing year, a summary that reads badly.',
    meta: 'Every change is recorded against your name',
  },
  {
    href: '/add?job=person',
    title: 'Add a person or an organisation',
    lede: 'Someone the archive mentions but does not yet have a page for, or the institution they wrote for.',
  },
  {
    href: '/add?job=writing',
    title: 'Add an excerpt or an opinion piece',
    lede: 'A passage lifted from a longer work, or a present-day article written for the site.',
  },
  {
    href: '/drafts',
    title: 'Finish something you started',
    lede: 'Anything begun and put down, and anything a batch has read but nobody has checked. None of it is public yet.',
  },
  {
    href: '/popups',
    title: 'Put up a pop-up notice',
    lede: 'A lecture, an event, an appeal. Upload the poster, write a sentence, say when it is over. It greets every reader until then and takes itself down afterwards.',
  },
  {
    href: '/site',
    title: "Change the website's own words",
    lede: 'The homepage, the menus, every section introduction, the about page. Headlines and blurbs, editable like anything else.',
  },
];
---

<Shell title="Archive">
  <div class="head">
    <p class="eyebrow">Indian Liberals</p>
    <h1>What would you like to do</h1>
    <hr class="rule" />
  </div>

  <div class="jobs">
    {
      jobs.map((job) => (
        <a class={`card job${job.primary ? ' first' : ''}`} href={job.href}>
          {job.meta && <span class="meta">{job.meta}</span>}
          <h2>{job.title}</h2>
          <p>{job.lede}</p>
        </a>
      ))
    }
  </div>

  <section class="publishing">
    <h2 class="small">Is my change on the site yet</h2>
    <div class="status" id="publishing"><p class="muted">Checking.</p></div>
  </section>

  <section class="holdings">
    <h2 class="small">What is in the archive</h2>
    <div class="counts" id="counts"><p class="muted">Counting.</p></div>
  </section>

  <style>
    .head { max-width: 40rem; }
    .jobs { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); margin-top: 1.75rem; }
    .job {
      text-decoration: none;
      display: block;
      position: relative;
      transition: border-color .15s, transform .15s, box-shadow .15s;
    }
    .job:hover { transform: translateY(-2px); box-shadow: 3px 3px 0 var(--ink); }
    .job.first { grid-column: 1 / -1; background: var(--cream); border-color: var(--sand); }
    .job.first h2 { font-size: 1.75rem; }
    .job h2 { margin-bottom: .4rem; }
    .job p { margin: 0; font-size: .95rem; max-width: 40rem; }
    .meta {
      display: inline-block;
      font-size: 11px;
      letter-spacing: .14em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--gold);
      margin-bottom: .5rem;
    }
    .publishing { margin-top: 3rem; max-width: 46rem; }
    .status p { margin: 0 0 .5rem; }
    .status .when { font-variant-numeric: tabular-nums; }
    .holdings { margin-top: 3rem; }
    .small { font-size: 1.05rem; margin-bottom: 1rem; }
    .counts { display: grid; gap: .6rem; grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr)); }
  </style>

  <!-- The tiles below are written in after the count arrives, so scoped rules
       would never reach them. -->
  <style is:global>
    .count { background: var(--tile); border-radius: 0; padding: .85rem 1rem; }
    .count .n { font-family: var(--serif); font-size: 1.5rem; color: var(--brown); line-height: 1; font-variant-numeric: tabular-nums; }
    .count .k { font-size: .78rem; margin-top: .25rem; color: var(--body); }
  </style>

  <script>
    // Whether what has been saved is what readers see.
    //
    // A save is a commit; a commit becomes the live site only when a build
    // finishes, and the build takes the better part of an hour. For weeks in
    // August 2026 it did not finish at all, and nobody in the CMS could tell:
    // the editor saw "Saved", the site looked healthy, and the change was in
    // neither place they could check. So this compares three things that are
    // all public: the commit the live site says it was built from, the newest
    // commit in the repository, and the deploy workflow's recent runs.
    const REPO = 'adoistic/indianliberals';
    const SITE = 'https://indianliberals.in';
    const status = document.getElementById('publishing')!;

    const when = (iso: string) =>
      `<span class="when">${new Date(iso).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' })}</span>`;
    const short = (sha: string) => `<code>${sha.slice(0, 8)}</code>`;

    interface Run {
      status: string;
      conclusion: string | null;
      head_sha: string;
      created_at: string;
      updated_at: string;
      html_url: string;
    }

    Promise.all([
      fetch(`${SITE}/api/meta.json?t=${Date.now()}`, { cache: 'no-store' }).then(
        (r) => r.json() as Promise<{ commit: string | null; generated_at: string }>,
      ),
      fetch(`https://api.github.com/repos/${REPO}/commits/main`, {
        headers: { Accept: 'application/vnd.github+json' },
      }).then((r) => r.json() as Promise<{ sha: string; commit: { committer: { date: string } } }>),
      fetch(`https://api.github.com/repos/${REPO}/actions/workflows/deploy.yml/runs?branch=main&per_page=5`, {
        headers: { Accept: 'application/vnd.github+json' },
      }).then((r) => r.json() as Promise<{ workflow_runs: Run[] }>),
    ])
      .then(([live, head, runs]) => {
        const all = runs.workflow_runs ?? [];
        const active = all.find((r) => r.status !== 'completed');
        const last = all.find((r) => r.status === 'completed');
        const lines: string[] = [];

        lines.push(
          live.commit
            ? `The live site was built at ${when(live.generated_at)} from change ${short(live.commit)}.`
            : `The live site was built at ${when(live.generated_at)}, by hand, before builds started recording which change they came from.`,
        );

        if (live.commit && live.commit === head.sha) {
          lines.push('Everything saved so far is on the site.');
        } else if (active) {
          lines.push(
            `Changes saved since then are being published now (started ${when(active.created_at)}). ` +
              `It usually takes about an hour. <a href="${active.html_url}">Watch it</a>.`,
          );
        } else if (last && last.conclusion !== 'success' && last.created_at > live.generated_at) {
          lines.push(
            `The last attempt to publish, at ${when(last.created_at)}, did not finish. ` +
              `Adnan has been told. Readers keep seeing the previous version until it is fixed. ` +
              `<a href="${last.html_url}">What went wrong</a>.`,
          );
        } else {
          lines.push(
            `The newest change was saved at ${when(head.commit.committer.date)} and is waiting to be published.`,
          );
        }
        status.innerHTML = lines.map((l) => `<p>${l}</p>`).join('');
      })
      .catch(() => {
        status.innerHTML = '<p class="muted">Could not check just now. Saving still works; this is only the report.</p>';
      });

    // Counted from the live site rather than the repository, so this reflects
    // what a reader can actually see today.
    const LABELS: Record<string, string> = {
      primary_works: 'Documents',
      thinkers: 'People',
      periodical_issues: 'Magazine issues',
      interviews: 'Interviews',
      musings: 'Excerpts',
      opinions: 'Opinion pieces',
      organisations: 'Organisations',
    };

    const box = document.getElementById('counts')!;
    fetch('https://indianliberals.in/api/meta.json')
      .then((r) => r.json() as Promise<{ counts: Record<string, number> }>)
      .then((meta) => {
        box.innerHTML = Object.entries(meta.counts)
          .filter(([key]) => key in LABELS)
          .map(
            ([key, value]) =>
              `<div class="count"><div class="n">${value.toLocaleString('en-IN')}</div><div class="k">${LABELS[key]}</div></div>`,
          )
          .join('');
      })
      .catch(() => {
        box.innerHTML = '<p class="muted">Could not reach the site to count what is in it.</p>';
      });
  </script>
</Shell>
