---
import Shell from '../layouts/Shell.astro';
import { COLLECTIONS } from '../lib/collections';
---

<Shell title="Find and edit">
  <p class="eyebrow">Find and edit</p>
  <h1>Browse the catalogue</h1>
  <hr class="rule" />
  <p class="lede">
    The same titles, authors and covers a reader sees on the site. Pick a kind of entry, search
    for it, and click through to change it.
  </p>

  <div class="tabs" id="tabs">
    {
      COLLECTIONS.map((c) => (
        <button class="chip pick" type="button" data-collection={c.id}>
          {c.label}
          <span class="tabcount" data-tabcount={c.id} />
        </button>
      ))
    }
  </div>
  <p class="hint about" id="about"></p>

  <section class="card" style="margin-top:1.5rem">
    <div class="head">
      <div class="grow field">
        <label for="filter">Search</label>
        <input
          type="text"
          id="filter"
          placeholder="Search by title, author or year"
          autocomplete="off"
        />
      </div>
      <div class="field sortfield">
        <label for="sort">Sort</label>
        <select id="sort">
          <option value="az">A to Z</option>
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
        </select>
      </div>
    </div>
    <p class="count tabular" id="count"></p>
    <hr class="rule" />
    <div id="status"></div>
    <div class="grid" id="grid"></div>
    <div class="more" id="morewrap" hidden>
      <button class="btn btn-quiet" id="morebtn" type="button">Show more</button>
    </div>
  </section>

  <!-- Global rather than scoped: the rows and cards below are built at
       runtime with innerHTML, and Astro's scoped styles only reach elements
       that were in the template at build time. Every selector here is
       page-specific, so global costs nothing. -->
  <style is:global>
    .lede { max-width: 44rem; }
    .tabs { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.5rem; }
    .pick {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      border: 1px solid var(--line2);
      background: var(--card);
      cursor: pointer;
      font-family: var(--sans);
      font-size: .92rem;
      color: var(--brown2);
      padding: .4rem .85rem;
      border-radius: 999px;
      transition: border-color .15s, background .15s;
    }
    .pick:hover { box-shadow: 2px 2px 0 var(--ink); }
    .pick[aria-pressed='true'] {
      background: var(--ink);
      color: var(--paper);
    }
    .tabcount {
      font-size: .75rem;
      font-variant-numeric: tabular-nums;
      color: var(--body);
      min-width: .6rem;
    }
    .pick[aria-pressed='true'] .tabcount { color: var(--paper); }
    .about { margin-top: .7rem; max-width: 44rem; min-height: 1.2rem; }

    .head { display: flex; gap: 1.25rem; align-items: flex-end; flex-wrap: wrap; margin-bottom: .5rem; }
    .head .grow { max-width: 26rem; margin-bottom: 0; }
    .sortfield { min-width: 11rem; margin-bottom: 0; }
    .sortfield select { margin: 0; }
    .count { color: var(--body); font-size: .88rem; margin: 0 0 .4rem; }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr));
      gap: 1.25rem;
      margin-top: 1rem;
    }

    .entry-card {
      position: relative;
      display: flex;
      flex-direction: column;
      border: 1px solid var(--line2);
      border-radius: 0;
      overflow: hidden;
      background: var(--card);
      transition: border-color .15s, transform .15s;
    }
    .entry-card:hover { box-shadow: 3px 3px 0 var(--ink); }

    .cover-wrap {
      aspect-ratio: 3 / 4;
      background: var(--tile);
      display: block;
    }
    .cover-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .cover-wrap.placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--serif);
      font-size: 2.6rem;
      color: var(--gold);
      background: var(--paper); border: 1px solid var(--ink);
    }

    .entry-body { padding: .85rem .95rem 1rem; display: flex; flex-direction: column; gap: .3rem; flex: 1; }
    .entry-title {
      font-family: var(--serif);
      font-size: 1.15rem;
      font-weight: 500;
      color: var(--brown);
      line-height: 1.25;
      margin: 0;
    }
    .entry-title a {
      color: inherit;
      text-decoration: none;
    }
    .entry-title a::before {
      content: '';
      position: absolute;
      inset: 0;
    }
    .translit { font-size: .8rem; font-style: italic; color: var(--body); margin: 0; }
    .entry-sub { font-size: .84rem; color: var(--brown2); margin: 0; }
    .entry-chips { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .2rem; }
    .view-live {
      position: relative;
      z-index: 2;
      align-self: flex-start;
      margin-top: auto;
      padding-top: .5rem;
      font-size: .75rem;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: var(--body);
      text-decoration: none;
    }
    .view-live:hover { text-decoration: underline; }

    .more { margin-top: 1.5rem; text-align: center; }
    #status .notice { margin-top: .5rem; }

    @media (max-width: 640px) {
      .head { flex-direction: column; align-items: stretch; }
      .head .grow, .sortfield { max-width: none; }
    }
  </style>

  <script>
    import { watchUser, roleFor } from '../lib/firebase';
    import { COLLECTIONS, collectionById } from '../lib/collections';

    // ─── Shapes coming back from the live site ────────────────────────

    interface RawWork {
      id: string;
      title: { main: string; subtitle?: string; original_script?: string; translit?: string } | string;
      work_type?: string;
      authors?: { kind: string; id: string; name: string }[];
      year?: number | null;
      url?: string;
      cover_image?: string;
    }

    interface RawThinker {
      id: string;
      name: { canonical: string; sort?: string };
      birth_year?: number | null;
      death_year?: number | null;
      tradition?: string;
      url?: string;
    }

    interface RawDoc {
      collection: string;
      id: string;
      kind?: string;
      title: string;
      url?: string;
      authors?: string[];
      year?: number | null;
    }

    // ─── The one shape every card renders from ────────────────────────

    interface CardEntry {
      id: string;
      title: string;
      translit?: string;
      sortKey: string;
      authors?: string;
      year: number | null;
      kind?: string;
      cover?: string;
      liveUrl?: string;
      isPerson?: boolean;
      birthYear?: number | null;
      deathYear?: number | null;
      tradition?: string;
    }

    const WORKS_URL = 'https://indianliberals.in/api/works.json';
    const THINKERS_URL = 'https://indianliberals.in/api/thinkers.json';
    const SEARCH_URL = 'https://indianliberals.in/api/search-index.json';

    // Friendly plural nouns for the count line, matching the words the rest
    // of this CMS already uses (see the front page's holdings counter).
    const NOUN: Record<string, string> = {
      'primary-works': 'documents',
      thinkers: 'people',
      opinions: 'opinion pieces',
      musings: 'excerpts',
      organisations: 'organisations',
      contributors: 'contributors',
      series: 'series',
    };

    // The public catalogue does not publish contributors or series records:
    // they exist only in the archive repository. Say so plainly rather than
    // pretending a search box works when it has nothing to search.
    const NO_SOURCE = new Set(['contributors', 'series']);

    // Pop-up notices are not catalogue records and are never searched for:
    // there are three of them and what matters is which one is showing. That
    // is a different screen, so this tab points at it rather than repeating it.
    const ELSEWHERE: Record<string, { href: string; says: string }> = {
      announcements: {
        href: '/popups',
        says: 'Pop-up notices have a screen of their own, where you can see which one readers are meeting right now.',
      },
    };

    const WINDOW = 60;

    const tabs = document.getElementById('tabs')!;
    const about = document.getElementById('about')!;
    const filter = document.getElementById('filter') as HTMLInputElement;
    const sortSelect = document.getElementById('sort') as HTMLSelectElement;
    const count = document.getElementById('count')!;
    const status = document.getElementById('status')!;
    const grid = document.getElementById('grid')!;
    const moreWrap = document.getElementById('morewrap')!;
    const moreBtn = document.getElementById('morebtn')!;

    const buckets = new Map<string, CardEntry[]>();
    const failed = new Set<string>();

    let current = 'primary-works';
    let userChangedSort = false;
    let shown = WINDOW;

    function escape(text: string): string {
      return text.replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
      );
    }

    function humanize(text: string): string {
      return text.replace(/[_-]+/g, ' ').trim();
    }

    /** A title can arrive as {main, translit, ...} or as a plain string. */
    function mainTitle(title: unknown): string {
      if (title && typeof title === 'object') return (title as { main?: string }).main ?? '';
      return typeof title === 'string' ? title : '';
    }

    function translitOf(title: unknown): string | undefined {
      if (title && typeof title === 'object') return (title as { translit?: string }).translit;
      return undefined;
    }

    function defaultSort(id: string): string {
      return id === 'thinkers' ? 'az' : 'newest';
    }

    function toWorkCard(raw: RawWork): CardEntry {
      const title = mainTitle(raw.title) || raw.id;
      return {
        id: raw.id,
        title,
        translit: translitOf(raw.title),
        sortKey: title,
        authors: (raw.authors ?? []).map((a) => a.name).join(', '),
        year: raw.year ?? null,
        kind: raw.work_type,
        cover: raw.cover_image,
        liveUrl: raw.url,
      };
    }

    function toThinkerCard(raw: RawThinker): CardEntry {
      const title = raw.name?.canonical ?? raw.id;
      return {
        id: raw.id,
        title,
        sortKey: raw.name?.sort ?? title,
        year: raw.birth_year ?? null,
        birthYear: raw.birth_year ?? null,
        deathYear: raw.death_year ?? null,
        tradition: raw.tradition,
        liveUrl: raw.url,
        isPerson: true,
      };
    }

    function toDocCard(raw: RawDoc): CardEntry {
      const title = mainTitle(raw.title) || (typeof raw.title === 'string' ? raw.title : raw.id);
      return {
        id: raw.id,
        title,
        sortKey: title,
        authors: (raw.authors ?? []).join(', '),
        year: raw.year ?? null,
        kind: raw.kind,
        liveUrl: raw.url,
      };
    }

    function updateTabCount(id: string) {
      const badge = tabs.querySelector<HTMLElement>(`[data-tabcount="${id}"]`);
      if (!badge) return;
      const entries = buckets.get(id);
      if (entries) badge.textContent = `(${entries.length.toLocaleString('en-IN')})`;
      else if (failed.has(id)) badge.textContent = '';
    }

    // ─── Loading the three live feeds, in parallel, once ──────────────

    async function loadWorks() {
      try {
        const response = await fetch(WORKS_URL);
        if (!response.ok) throw new Error(`the site said ${response.status}`);
        const data = (await response.json()) as { works: RawWork[] };
        buckets.set('primary-works', data.works.map(toWorkCard));
      } catch {
        failed.add('primary-works');
      }
      updateTabCount('primary-works');
      if (current === 'primary-works') render();
    }

    async function loadThinkers() {
      try {
        const response = await fetch(THINKERS_URL);
        if (!response.ok) throw new Error(`the site said ${response.status}`);
        const data = (await response.json()) as { thinkers: RawThinker[] };
        buckets.set('thinkers', data.thinkers.map(toThinkerCard));
      } catch {
        failed.add('thinkers');
      }
      updateTabCount('thinkers');
      if (current === 'thinkers') render();
    }

    async function loadSearchIndex() {
      const ids = ['opinions', 'musings', 'organisations'];
      try {
        const response = await fetch(SEARCH_URL);
        if (!response.ok) throw new Error(`the site said ${response.status}`);
        const data = (await response.json()) as { docs: RawDoc[] };
        for (const id of ids) {
          buckets.set(
            id,
            data.docs.filter((d) => d.collection === id).map(toDocCard),
          );
        }
      } catch {
        for (const id of ids) failed.add(id);
      }
      for (const id of ids) updateTabCount(id);
      if (ids.includes(current)) render();
    }

    // ─── Rendering the current tab ─────────────────────────────────────

    function yearOf(entry: CardEntry): number | null {
      return entry.isPerson ? (entry.birthYear ?? entry.deathYear ?? null) : entry.year;
    }

    function sortEntries(entries: CardEntry[], mode: string): CardEntry[] {
      const copy = entries.slice();
      if (mode === 'az') {
        copy.sort((a, b) => a.sortKey.localeCompare(b.sortKey));
      } else {
        copy.sort((a, b) => {
          const ay = yearOf(a);
          const by = yearOf(b);
          if (ay == null && by == null) return a.sortKey.localeCompare(b.sortKey);
          if (ay == null) return 1;
          if (by == null) return -1;
          return mode === 'oldest' ? ay - by : by - ay;
        });
      }
      return copy;
    }

    function matches(entry: CardEntry, needle: string): boolean {
      if (entry.title.toLowerCase().includes(needle)) return true;
      if (entry.translit?.toLowerCase().includes(needle)) return true;
      if (entry.authors?.toLowerCase().includes(needle)) return true;
      if (entry.tradition && humanize(entry.tradition).toLowerCase().includes(needle)) return true;
      const year = yearOf(entry);
      if (year != null && String(year).includes(needle)) return true;
      return false;
    }

    function firstLetter(title: string): string {
      const t = title.trim();
      return t ? t[0]!.toUpperCase() : '?';
    }

    function cardHtml(entry: CardEntry): string {
      const href = `/edit?collection=${encodeURIComponent(current)}&slug=${encodeURIComponent(entry.id)}`;
      const cover = entry.cover
        ? `<div class="cover-wrap"><img src="${escape(entry.cover)}" alt="" loading="lazy" decoding="async" /></div>`
        : `<div class="cover-wrap placeholder" aria-hidden="true">${escape(firstLetter(entry.title))}</div>`;

      const translit =
        entry.translit && entry.translit !== entry.title
          ? `<p class="translit">${escape(entry.translit)}</p>`
          : '';

      let sub = '';
      let chips = '';
      if (entry.isPerson) {
        const hasYears = entry.birthYear != null || entry.deathYear != null;
        const years = hasYears
          ? `${entry.birthYear ?? 'year unknown'} to ${entry.deathYear ?? 'present'}`
          : '';
        const bits = [years, entry.tradition ? humanize(entry.tradition) : ''].filter(Boolean);
        if (bits.length) sub = `<p class="entry-sub">${escape(bits.join(', '))}</p>`;
      } else {
        if (entry.authors) sub = `<p class="entry-sub">${escape(entry.authors)}</p>`;
        const pieces: string[] = [];
        if (entry.year != null) pieces.push(`<span class="chip">${entry.year}</span>`);
        if (entry.kind) pieces.push(`<span class="chip">${escape(humanize(entry.kind))}</span>`);
        if (pieces.length) chips = `<p class="entry-chips">${pieces.join('')}</p>`;
      }

      const viewLive = entry.liveUrl
        ? `<a class="view-live" href="https://indianliberals.in${entry.liveUrl}" target="_blank" rel="noopener">View live page</a>`
        : '';

      return `<article class="entry-card">
        ${cover}
        <div class="entry-body">
          <h3 class="entry-title"><a href="${href}">${escape(entry.title)}</a></h3>
          ${translit}
          ${sub}
          ${chips}
          ${viewLive}
        </div>
      </article>`;
    }

    function render() {
      moreWrap.hidden = true;

      const collection = collectionById(current);
      about.textContent = collection?.description ?? '';

      const elsewhere = ELSEWHERE[current];
      if (elsewhere) {
        count.textContent = '';
        status.innerHTML = `<p class="notice">${escape(elsewhere.says)} <a href="${
          elsewhere.href
        }">Open it</a>.</p>`;
        grid.innerHTML = '';
        return;
      }

      if (NO_SOURCE.has(current)) {
        count.textContent = '';
        status.innerHTML = `<p class="notice">The live site does not publish a catalogue of ${escape(
          (collection?.label ?? current).toLowerCase(),
        )}, so they cannot be searched here yet. They still live in the archive repository.</p>`;
        grid.innerHTML = '';
        return;
      }

      const entries = buckets.get(current);

      if (!entries) {
        if (failed.has(current)) {
          count.textContent = '';
          status.innerHTML =
            '<p class="notice notice-stop">Could not reach the site to fetch this list. Reload the page to try again.</p>';
          grid.innerHTML = '';
          return;
        }
        count.textContent = '';
        status.innerHTML = '<p class="muted">Fetching the catalogue from the site.</p>';
        grid.innerHTML = '';
        return;
      }

      status.innerHTML = '';

      if (!entries.length) {
        count.textContent = '';
        status.innerHTML = `<p class="notice">Nothing has been filed under ${escape(
          collection?.label ?? current,
        )} yet.</p>`;
        grid.innerHTML = '';
        return;
      }

      const needle = filter.value.trim().toLowerCase();
      const found = needle ? entries.filter((e) => matches(e, needle)) : entries;

      const noun = NOUN[current] ?? (collection?.label ?? current).toLowerCase();
      count.textContent = needle
        ? `${found.length.toLocaleString('en-IN')} matching '${filter.value.trim()}'`
        : `${found.length.toLocaleString('en-IN')} ${noun}`;

      if (!found.length) {
        grid.innerHTML = '';
        status.innerHTML = `<p class="muted">Nothing here matches "${escape(
          filter.value.trim(),
        )}". Try fewer letters.</p>`;
        return;
      }

      const sorted = sortEntries(found, sortSelect.value);
      const visible = sorted.slice(0, shown);
      grid.innerHTML = visible.map(cardHtml).join('');

      if (sorted.length > visible.length) {
        moreWrap.hidden = false;
        moreBtn.textContent = `Show more (${(sorted.length - visible.length).toLocaleString('en-IN')} left)`;
      }
    }

    // ─── Wiring ─────────────────────────────────────────────────────

    function selectCollection(id: string, push = true) {
      current = id;
      shown = WINDOW;

      for (const button of tabs.querySelectorAll<HTMLButtonElement>('.pick')) {
        button.setAttribute('aria-pressed', String(button.dataset.collection === id));
      }
      if (!userChangedSort) sortSelect.value = defaultSort(id);

      if (push) {
        const url = new URL(location.href);
        url.searchParams.set('collection', id);
        history.replaceState(null, '', url);
      }
      render();
    }

    tabs.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.pick');
      if (button?.dataset.collection) selectCollection(button.dataset.collection);
    });

    filter.addEventListener('input', () => {
      shown = WINDOW;
      render();
    });

    sortSelect.addEventListener('change', () => {
      userChangedSort = true;
      shown = WINDOW;
      render();
    });

    moreBtn.addEventListener('click', () => {
      shown += WINDOW;
      render();
    });

    watchUser(async (user) => {
      if (!user) return;
      const role = await roleFor(user);
      if (!role) {
        location.href = '/no-access';
        return;
      }

      const wanted = new URL(location.href).searchParams.get('collection');
      const known = COLLECTIONS.some((c) => c.id === wanted);
      selectCollection(wanted && known ? wanted : 'primary-works', false);
    });

    void loadWorks();
    void loadThinkers();
    void loadSearchIndex();
  </script>
</Shell>
