---
import Shell from '../layouts/Shell.astro';

/**
 * What readers sent in.
 *
 * The archive has a public form now, at /contact/ on the site. Everything it
 * receives lands here rather than in somebody's mailbox, for the reason a
 * shared inbox usually beats a personal one: two editors can see the same
 * queue, and a correction does not sit unread because the person it was sent to
 * is on leave.
 *
 * Corrections lead. Somebody who has taken the trouble to tell us a date is
 * wrong has done the archive a favour, and the reply they deserve is the fix.
 */
---

<Shell title="Feedback">
  <div class="head">
    <p class="eyebrow">Indian Liberals</p>
    <h1>What readers sent in</h1>
    <hr class="rule" />
    <p class="lede">
      Messages from the form at the foot of the archive. Each one says which page the reader was on
      when they wrote, so a correction can usually be checked without writing back.
    </p>
  </div>

  <div id="stage"><p class="muted">Opening the inbox.</p></div>
  <div id="failed" class="notice notice-stop" hidden></div>

  <div id="inbox" hidden>
    <div class="bar">
      <label class="tick">
        <input type="checkbox" id="showhandled" />
        <span>Include the ones already dealt with</span>
      </label>
      <span class="grow"></span>
      <span class="muted" id="count"></span>
    </div>
    <div id="list"></div>
  </div>

  <div id="empty" hidden>
    <section class="card">
      <h2>Nothing yet</h2>
      <hr class="rule" />
      <p>
        No one has written in. The form is at
        <a href="https://indianliberals.in/contact/" target="_blank" rel="noopener">indianliberals.in/contact</a>.
      </p>
    </section>
  </div>

  <style is:global>
    .head { max-width: 46rem; }
    .bar { display: flex; align-items: center; gap: 1rem; padding: .9rem 1.1rem; border: 1px solid var(--line2); border-radius: 0; background: var(--page); margin-bottom: 1.1rem; }
    .grow { flex: 1; }
    .tick { display: flex; align-items: center; gap: .55rem; }
    .tick input { width: auto; }
    .msg { border: 1px solid var(--line2); border-radius: 0; padding: 1.15rem 1.3rem; margin-bottom: .9rem; background: var(--page); }
    .msg.done { border-style: dashed; }
    .msg.done .who { text-decoration: line-through; }
    .msghead { display: flex; align-items: baseline; gap: .75rem; flex-wrap: wrap; margin-bottom: .5rem; }
    .who { font-weight: 600; color: var(--brown); }
    .when, .where { font-size: .82rem; color: var(--body); }
    .tag { font-size: 10px; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; padding: .18rem .45rem; border-radius: 0; background: var(--ink); color: var(--paper); }
    .msg p.body { margin: .6rem 0 .9rem; white-space: pre-wrap; }
    .msgfoot { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; }
  </style>

  <script>
    import { watchUser } from '../lib/firebase';
    import type { User } from 'firebase/auth';

    interface Message {
      id: string;
      received_at: string;
      name: string;
      email: string;
      subject: string;
      message: string;
      page: string;
      kind: string;
      country: string;
      handled?: boolean;
      handled_by?: string;
    }

    const KIND_LABEL: Record<string, string> = {
      correction: 'Correction',
      contribution: 'Offer of material',
      rights: 'Rights query',
      general: 'General',
    };
    // Corrections first: they are the ones that improve the archive.
    const KIND_ORDER = ['correction', 'contribution', 'rights', 'general'];

    let me: User | null = null;
    let items: Message[] = [];

    const $ = (id: string) => document.getElementById(id)!;
    const esc = (s: unknown) =>
      String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    function when(iso: string): string {
      const d = new Date(iso);
      return Number.isNaN(d.getTime())
        ? iso
        : d.toLocaleString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    function draw(): void {
      const showHandled = ($('showhandled') as HTMLInputElement).checked;
      const shown = items
        .filter((m) => showHandled || !m.handled)
        .sort(
          (a, b) =>
            KIND_ORDER.indexOf(a.kind) - KIND_ORDER.indexOf(b.kind) ||
            b.received_at.localeCompare(a.received_at),
        );

      const open = items.filter((m) => !m.handled).length;
      $('count').textContent =
        `${open} waiting${items.length > open ? `, ${items.length - open} dealt with` : ''}`;

      $('list').innerHTML = shown
        .map(
          (m) => `
        <article class="msg${m.handled ? ' done' : ''}">
          <div class="msghead">
            <span class="tag">${esc(KIND_LABEL[m.kind] ?? m.kind)}</span>
            <span class="who">${esc(m.name || 'Anonymous')}</span>
            ${m.email ? `<a href="mailto:${esc(m.email)}">${esc(m.email)}</a>` : '<span class="when">no address given</span>'}
            <span class="grow"></span>
            <span class="when">${esc(when(m.received_at))}</span>
          </div>
          ${m.subject ? `<p class="who" style="margin:.2rem 0">${esc(m.subject)}</p>` : ''}
          <p class="body">${esc(m.message)}</p>
          <div class="msgfoot">
            ${m.page ? `<a class="where" href="${esc(m.page)}" target="_blank" rel="noopener">On: ${esc(m.page)}</a>` : '<span class="where">Page not recorded</span>'}
            <span class="grow"></span>
            ${
              m.handled
                ? `<span class="when">Dealt with${m.handled_by ? ` by ${esc(m.handled_by)}` : ''}</span>
                   <button type="button" class="btn btn-quiet tiny" data-reopen="${esc(m.id)}">Reopen</button>`
                : `<button type="button" class="btn btn-quiet tiny" data-done="${esc(m.id)}">Mark dealt with</button>`
            }
          </div>
        </article>`,
        )
        .join('');

      $('list').querySelectorAll('[data-done]').forEach((el) =>
        el.addEventListener('click', () => void mark((el as HTMLElement).dataset.done!, true)),
      );
      $('list').querySelectorAll('[data-reopen]').forEach((el) =>
        el.addEventListener('click', () => void mark((el as HTMLElement).dataset.reopen!, false)),
      );
    }

    async function mark(id: string, handled: boolean): Promise<void> {
      if (!me) return;
      const token = await me.getIdToken();
      const response = await fetch('/api/feedback', {
        method: 'PUT',
        headers: { 'content-type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({ id, handled }),
      });
      if (!response.ok) return;
      const found = items.find((m) => m.id === id);
      if (found) {
        found.handled = handled;
        found.handled_by = handled ? (me.email ?? '') : '';
      }
      draw();
    }

    async function load(): Promise<void> {
      if (!me) return;
      try {
        const token = await me.getIdToken();
        const response = await fetch('/api/feedback', { headers: { Authorization: `Bearer ${token}` } });
        const payload = (await response.json()) as { items?: Message[]; error?: string };
        if (!response.ok) {
          $('stage').hidden = true;
          const failed = $('failed');
          failed.hidden = false;
          failed.textContent = payload.error ?? 'The inbox could not be opened.';
          return;
        }
        items = payload.items ?? [];
        $('stage').hidden = true;
        if (items.length === 0) {
          $('empty').hidden = false;
          return;
        }
        $('inbox').hidden = false;
        draw();
      } catch (error) {
        $('stage').hidden = true;
        const failed = $('failed');
        failed.hidden = false;
        failed.textContent = `The inbox could not be opened: ${(error as Error).message}`;
      }
    }

    $('showhandled').addEventListener('change', draw);

    watchUser((user) => {
      if (!user) {
        location.href = '/signin';
        return;
      }
      me = user;
      void load();
    });
  </script>
</Shell>
